@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix praxis:  <http://seanchatmangpt.github.io/praxis/schema#> .

# ===========================================================================
# 1. Classes
# ===========================================================================

praxis:Project a rdfs:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A top-level repository or system configured under the Praxis house style." .

praxis:RustCrate a rdfs:Class ;
    rdfs:label "RustCrate" ;
    rdfs:comment "A Rust crate within the project, either a single crate or workspace member." .

praxis:Component a rdfs:Class ;
    rdfs:label "Component" ;
    rdfs:comment "An architectural module or design pattern implemented in Rust code." .

praxis:Feature a rdfs:Class ;
    rdfs:label "Feature" ;
    rdfs:comment "A Cargo feature flag in a Rust crate." .

praxis:Dependency a rdfs:Class ;
    rdfs:label "Dependency" ;
    rdfs:comment "An external crate dependency for Cargo.toml." .

praxis:ConfigurationFile a rdfs:Class ;
    rdfs:label "ConfigurationFile" ;
    rdfs:comment "A project hygiene config file (e.g. rustfmt.toml, deny.toml, typos.toml)." .

praxis:WorkflowFile a rdfs:Class ;
    rdfs:label "WorkflowFile" ;
    rdfs:comment "A GitHub actions workflow definition." .

praxis:ZstTypestate a rdfs:Class ;
    rdfs:label "ZstTypestate" ;
    rdfs:comment "A Zero-Sized Type used as a compile-time lifecycle state marker." .

praxis:CliCommand a rdfs:Class ;
    rdfs:label "CliCommand" ;
    rdfs:comment "A noun-verb CLI command definition." .

praxis:StandingArtifact a rdfs:Class ;
    rdfs:label "StandingArtifact" ;
    rdfs:comment "A tracked artifact's compiled readiness record under the praxis-standing.v1 schema (docs/standing/STANDING_SCHEMA.md): one of rust_crate/client/doc/paper/bench/workflow/ontology/binary, carrying a standing status set, a computed 0-9 ladder level, an optional scope, and evidence references." .

# ===========================================================================
# 2. Properties
# ===========================================================================

# Project Properties
praxis:name a rdf:Property ;
    rdfs:label "name" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate praxis:Component praxis:Feature praxis:Dependency praxis:ZstTypestate) ] ;
    rdfs:range xsd:string .

praxis:version a rdf:Property ;
    rdfs:label "version" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "Project version adhering to CalVer (e.g. YY.M.patch)." .

praxis:description a rdf:Property ;
    rdfs:label "description" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate) ] ;
    rdfs:range xsd:string .

praxis:license a rdf:Property ;
    rdfs:label "license" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "License type (e.g., 'MIT OR Apache-2.0')." .

praxis:rustVersion a rdf:Property ;
    rdfs:label "rustVersion" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "Minimum Supported Rust Version (e.g., '1.82')." .

praxis:edition a rdf:Property ;
    rdfs:label "edition" ;
    rdfs:domain [ owl:unionOf (praxis:Project praxis:RustCrate) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "Rust edition (e.g., '2021')." .

praxis:dependencySpec a rdf:Property ;
    rdfs:label "dependencySpec" ;
    rdfs:domain praxis:Dependency ;
    rdfs:range xsd:string ;
    rdfs:comment "Cargo dependency specification string." .

praxis:isWorkspace a rdf:Property ;
    rdfs:label "isWorkspace" ;
    rdfs:domain praxis:Project ;
    rdfs:range xsd:boolean .

# Relations
praxis:hasCrate a rdf:Property ;
    rdfs:label "hasCrate" ;
    rdfs:domain praxis:Project ;
    rdfs:range praxis:RustCrate .

praxis:hasComponent a rdf:Property ;
    rdfs:label "hasComponent" ;
    rdfs:domain praxis:RustCrate ;
    rdfs:range praxis:Component .

praxis:hasFeature a rdf:Property ;
    rdfs:label "hasFeature" ;
    rdfs:domain praxis:RustCrate ;
    rdfs:range praxis:Feature .

praxis:hasDependency a rdf:Property ;
    rdfs:label "hasDependency" ;
    rdfs:domain praxis:RustCrate ;
    rdfs:range praxis:Dependency .

praxis:hasConfig a rdf:Property ;
    rdfs:label "hasConfig" ;
    rdfs:domain praxis:Project ;
    rdfs:range praxis:ConfigurationFile .

praxis:hasWorkflow a rdf:Property ;
    rdfs:label "hasWorkflow" ;
    rdfs:domain praxis:Project ;
    rdfs:range praxis:WorkflowFile .

praxis:hasTypestate a rdf:Property ;
    rdfs:label "hasTypestate" ;
    rdfs:domain praxis:Component ;
    rdfs:range praxis:ZstTypestate .

# CLI Command Properties
praxis:noun a rdf:Property ;
    rdfs:label "noun" ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

praxis:verb a rdf:Property ;
    rdfs:label "verb" ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

praxis:nounAbout a rdf:Property ;
    rdfs:label "nounAbout" ;
    rdfs:comment "Human-facing description of the CLI noun this command belongs to, repeated identically across every CliCommand instance sharing the same praxis:noun value. Rendered as the generated noun file's module (//!) doc comment, which clap-noun-verb's #[verb] macro auto-registers as the noun's --help about text at runtime (no hand-written registration needed)." ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

praxis:handler a rdf:Property ;
    rdfs:label "handler" ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

praxis:inCrate a rdf:Property ;
    rdfs:label "inCrate" ;
    rdfs:comment "Which workspace crate a CLI command's noun-verb route is generated into." ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range praxis:RustCrate .

praxis:flag a rdf:Property ;
    rdfs:label "flag" ;
    rdfs:comment "An optional boolean CLI flag exposed by the command and passed to its handler. Value is encoded as \"snake_case_name::help text\" so the generator can emit both the parameter name and its own per-argument --help text (see clap_noun_verb_macros '# Arguments' doc convention)." ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

praxis:arg a rdf:Property ;
    rdfs:label "arg" ;
    rdfs:comment "A value-carrying (non-boolean) CLI argument passed to the command's handler, encoded \"snake_case_name:type::help text\" where type in {string, pathbuf, pathbufs}: string->String, pathbuf->camino::Utf8PathBuf, pathbufs->repeatable multi-value Vec<camino::Utf8PathBuf> emitted with #[arg(action=\"append\")] (a --name option that accepts >=0 occurrences, e.g. --files a --files b). Distinct from praxis:flag, which stays boolean-only. NOTE: published clap-noun-verb 26.7.4 transports multi-value args only through repeatable --name options, not bare positionals (its extract_args reads a positional as a single value), so pathbufs renders a --name option, not a space-separated positional list." ;
    rdfs:domain praxis:CliCommand ;
    rdfs:range xsd:string .

# Standing Artifact Properties
praxis:standing a rdf:Property ;
    rdfs:label "standing" ;
    rdfs:comment "One of the 20 praxis-standing.v1 status tags (SCREAMING_SNAKE_CASE, e.g. \"BUILDS\", \"OCEL_PROVEN\", \"PRODUCTION_READY\") held by this artifact. Repeatable: an artifact may carry multiple standing triples." ;
    rdfs:domain praxis:StandingArtifact ;
    rdfs:range xsd:string .

praxis:ladderLevel a rdf:Property ;
    rdfs:label "ladderLevel" ;
    rdfs:comment "The computed 0-9 readiness ladder rung (docs/standing/PRODUCTION_READINESS.md) — the max ladder position among this artifact's praxis:standing values. Never asserted independent of the standing set; the compiler (cargo-cicd standing refresh) recomputes it." ;
    rdfs:domain praxis:StandingArtifact ;
    rdfs:range xsd:integer .

praxis:scope a rdf:Property ;
    rdfs:label "scope" ;
    rdfs:comment "Non-empty scope string, required when praxis:standing includes any of PRODUCTION_READY/PILOT_READY/PUBLISH_READY/PUBLICATION_READY (the scoped-readiness validation rule). Absent otherwise." ;
    rdfs:domain praxis:StandingArtifact ;
    rdfs:range xsd:string .

praxis:evidenceRef a rdf:Property ;
    rdfs:label "evidenceRef" ;
    rdfs:comment "A pointer to one piece of evidence backing this artifact's standing: a command invocation, an OCEL event, a receipt chain hash, or another artifact path/hash, per the EvidenceRef shape in docs/standing/STANDING_SCHEMA.md." ;
    rdfs:domain praxis:StandingArtifact ;
    rdfs:range xsd:string .

# Hygiene Config Properties
praxis:targetPath a rdf:Property ;
    rdfs:label "targetPath" ;
    rdfs:domain [ owl:unionOf (praxis:ConfigurationFile praxis:WorkflowFile) ] ;
    rdfs:range xsd:string .

# ===========================================================================
# 3. Reference Instance Model: my-conforming-project
# ===========================================================================

praxis:MyConformingProject a praxis:Project ;
    praxis:name "my-conforming-project" ;
    praxis:version "26.6.0" ;
    praxis:description "A standardized, structurally conforming boilerplate project." ;
    praxis:license "MIT OR Apache-2.0" ;
    praxis:rustVersion "1.82" ;
    praxis:edition "2021" ;
    praxis:isWorkspace true ;
    praxis:hasCrate praxis:CrateCore, praxis:CrateGgen ;
    praxis:hasConfig praxis:ConfigRustfmt, praxis:ConfigDeny, praxis:ConfigTypos ;
    praxis:hasWorkflow praxis:WorkflowCI, praxis:WorkflowRelease .

# Crate Definitions
praxis:CrateCore a praxis:RustCrate ;
    praxis:name "my-conforming-project" ;
    praxis:hasComponent praxis:CompTypestates, praxis:CompLsp, praxis:CompCli ;
    praxis:hasFeature praxis:FeatLsp, praxis:FeatTypestate ;
    praxis:hasDependency praxis:DepLspMax, praxis:DepSerde .

# Components
praxis:CompTypestates a praxis:Component ;
    praxis:name "GenerativeTypestates" ;
    praxis:hasTypestate praxis:StateRaw, praxis:StateValidated, praxis:StateAdmitted .

praxis:CompLsp a praxis:Component ;
    praxis:name "RulePackServer" .

praxis:CompCli a praxis:Component ;
    praxis:name "NounVerbCli" .

# ZST Typestates
praxis:StateRaw a praxis:ZstTypestate ;
    praxis:name "Raw" .

praxis:StateValidated a praxis:ZstTypestate ;
    praxis:name "Validated" .

praxis:StateAdmitted a praxis:ZstTypestate ;
    praxis:name "Admitted" .

# Features
praxis:FeatLsp a praxis:Feature ;
    praxis:name "lsp" .

praxis:FeatTypestate a praxis:Feature ;
    praxis:name "typestate" .

# Dependencies
praxis:DepLspMax a praxis:Dependency ;
    praxis:name "lsp-max" ;
    praxis:dependencySpec "path = \"/Users/sac/lsp-max\"" .

praxis:DepSerde a praxis:Dependency ;
    praxis:name "serde" ;
    praxis:dependencySpec "1" .

# Hygiene Config Instances
praxis:ConfigRustfmt a praxis:ConfigurationFile ;
    praxis:name "rustfmt" ;
    praxis:targetPath "rustfmt.toml" .

praxis:ConfigDeny a praxis:ConfigurationFile ;
    praxis:name "deny" ;
    praxis:targetPath "deny.toml" .

praxis:ConfigTypos a praxis:ConfigurationFile ;
    praxis:name "typos" ;
    praxis:targetPath "typos.toml" .

# CLI Commands
praxis:CmdDodRun a praxis:CliCommand ;
    praxis:noun "dod" ;
    praxis:verb "run" ;
    praxis:handler "handle_dod_run" .

praxis:CmdVerifierVerify a praxis:CliCommand ;
    praxis:noun "verifier" ;
    praxis:verb "verify" ;
    praxis:handler "handle_verifier_verify" .

# ---------------------------------------------------------------------------
# ggen crate (crates/ggen): SPARQL-in-Tera code generation
# ---------------------------------------------------------------------------

praxis:CrateGgen a praxis:RustCrate ;
    praxis:name "ggen" ;
    praxis:description "SPARQL-in-Tera code generation: ggen sync as the single verb." .

praxis:CmdGgenSyncRun a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "sync" ;
    praxis:verb "run" ;
    praxis:handler "handle_sync_run" ;
    praxis:flag "dry_run::Resolve and render but do not write any files to disk; report what would change." ;
    praxis:flag "watch::Watch the filesystem and re-run the pipeline automatically whenever a watched file changes." ;
    praxis:nounAbout "Run the ggen code-generation pipeline: resolve, enrich, extract, render, write." ;
    rdfs:comment "Run the five-stage generation pipeline: resolve, enrich, extract, render, write. --watch re-runs the pipeline on filesystem changes." .

praxis:CmdGgenGraphValidate a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "graph" ;
    praxis:verb "validate" ;
    praxis:handler "handle_graph_validate" ;
    praxis:arg "files:pathbufs::Turtle files to validate independently (repeatable --files a.ttl --files b.ttl). If omitted, validate the project ontology and templates." ;
    praxis:arg "shapes:pathbufs::SHACL shapes Turtle files (repeatable --shapes a.ttl --shapes b.ttl) to validate every --files target against, as one union graph. Ignored when --files is empty (project mode); with no --shapes, --files targets are Turtle-parse-only, unchanged from before this option existed." ;
    praxis:nounAbout "Validate RDF/Turtle ontology graphs against praxis vocabulary constraints." ;
    rdfs:comment "Load a Turtle ontology and report parse or constraint violations." .

praxis:CmdGgenReceiptVerify a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "receipt" ;
    praxis:verb "verify" ;
    praxis:handler "handle_receipt_verify" ;
    praxis:nounAbout "Inspect and verify sync receipt chains (BLAKE3-hashed provenance log)." ;
    rdfs:comment "Recompute and verify the BLAKE3 chain hash of a sync receipt." .

praxis:CmdGgenReceiptHistory a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "receipt" ;
    praxis:verb "history" ;
    praxis:handler "handle_receipt_history" ;
    praxis:nounAbout "Inspect and verify sync receipt chains (BLAKE3-hashed provenance log)." ;
    rdfs:comment "Verify the full chain of sync receipts in .ggen-v2/receipt-log.jsonl." .

praxis:CmdGgenDoctorRun a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "doctor" ;
    praxis:verb "run" ;
    praxis:handler "handle_doctor" ;
    praxis:nounAbout "Check environment health: lockfile drift, orphaned artifacts, receipt staleness." ;
    rdfs:comment "Check lockfile/pack drift, orphaned generated artifacts, and receipt-vs-disk staleness." .

praxis:CmdGgenLawLoad a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "law" ;
    praxis:verb "load" ;
    praxis:handler "handle_law_load" ;
    praxis:nounAbout "Law-state operations on the project graph: load rules, materialize, validate gates, explain derivations, export." ;
    rdfs:comment "Load every [law].rules file into the GraphLaw engine and report the rule count per file (refuses on the first unparseable rule document)." .

praxis:CmdGgenLawValidate a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "law" ;
    praxis:verb "validate" ;
    praxis:handler "handle_law_validate" ;
    praxis:nounAbout "Law-state operations on the project graph: load rules, materialize, validate gates, explain derivations, export." ;
    rdfs:comment "Materialize rules, then run every [law].shapes SHACL gate and the denial check; any violation is a typed FM-LAW refusal (non-zero exit)." .

praxis:CmdGgenLawDerive a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "law" ;
    praxis:verb "derive" ;
    praxis:handler "handle_law_derive" ;
    praxis:nounAbout "Law-state operations on the project graph: load rules, materialize, validate gates, explain derivations, export." ;
    rdfs:comment "Materialize [law].rules to fixpoint and report the derived-triple count plus the post-materialization graph hash." .

praxis:CmdGgenLawExplain a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "law" ;
    praxis:verb "explain" ;
    praxis:handler "handle_law_explain" ;
    praxis:nounAbout "Law-state operations on the project graph: load rules, materialize, validate gates, explain derivations, export." ;
    rdfs:comment "Materialize and report which facts the rules derived: rules-loaded count and the full derived-triple diff (canonical N-Triples lines)." .

praxis:CmdGgenLawExport a praxis:CliCommand ;
    praxis:inCrate praxis:CrateGgen ;
    praxis:noun "law" ;
    praxis:verb "export" ;
    praxis:handler "handle_law_export" ;
    praxis:nounAbout "Law-state operations on the project graph: load rules, materialize, validate gates, explain derivations, export." ;
    rdfs:comment "Dump the fully materialized graph as canonical N-Triples (post-rule fixpoint), with its BLAKE3 state hash." .

# ---------------------------------------------------------------------
# praxis-lean: Lean 4 kernel admission gate (praxis:flag values here use
# an extended "name:type::help" encoding -- backward compatible with the
# plain "name::help" (implicit bool) encoding above, since splitting on
# "::" first still isolates the name(:type) prefix from the help text.
# type in {bool, string, pathbuf}.
# ---------------------------------------------------------------------

praxis:CrateLean a praxis:RustCrate ;
    praxis:name "praxis-lean" ;
    praxis:description "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." .

praxis:CmdLeanInit a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "init" ;
    praxis:handler "init" ;
    praxis:flag "root:pathbuf::Directory to scaffold a fresh Lake package in." ;
    praxis:flag "toolchain:string::Lean toolchain identifier to pin (e.g. leanprover/lean4:stable)." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Scaffold a fresh Lake package (lean-toolchain, lakefile.lean, Praxis.lean) -- does not touch any existing bare-lean-verified files." .

praxis:CmdLeanVerify a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "verify" ;
    praxis:handler "verify" ;
    praxis:flag "root:pathbuf::Directory containing .lean files to verify." ;
    praxis:flag "receipts:pathbuf::Path to the receipt ledger (JSONL) to append to." ;
    praxis:flag "lean:string::Lean binary to invoke." ;
    praxis:flag "lake:string::Lake binary to invoke." ;
    praxis:flag "lake_env:bool::Invoke via `lake env lean` instead of bare `lean`." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Walk a directory of .lean files, kernel-check each one, run the no-sorry audit, and append a genesis-folded receipt for every file." .

praxis:CmdLeanNoSorry a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "no-sorry" ;
    praxis:handler "no_sorry" ;
    praxis:flag "root:pathbuf::Directory containing .lean files to audit." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Refuse any .lean file using `sorry`, `admit`, or an unauthorized `axiom`, ignoring comments." .

praxis:CmdLeanIndexBuild a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "index-build" ;
    praxis:handler "index_build" ;
    praxis:flag "repo_root:pathbuf::Repository root (for locating paper_factory_engine.py)." ;
    praxis:flag "corpus:pathbuf::Path to the corpus.ttl RDF file." ;
    praxis:flag "lean_pilot_dir:pathbuf::Directory where per-label .lean files live." ;
    praxis:flag "out:pathbuf::Path to write the built index JSON to." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Build a LeanDeclarationIndex from the real corpus.ttl via SPARQL, and save it as JSON." .

praxis:CmdLeanReconcile a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "reconcile" ;
    praxis:handler "reconcile" ;
    praxis:flag "index:pathbuf::Path to a built LeanDeclarationIndex JSON file." ;
    praxis:flag "receipts:pathbuf::Path to the receipt ledger (JSONL) to reconcile against." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Cross-reference the corpus index against the receipt ledger: report orphan labels, orphan files, and orphan receipts as typed refusals, not silently." .

praxis:CmdLeanReport a praxis:CliCommand ;
    praxis:inCrate praxis:CrateLean ;
    praxis:noun "l4" ;
    praxis:verb "report" ;
    praxis:handler "report" ;
    praxis:flag "index:pathbuf::Path to a built LeanDeclarationIndex JSON file." ;
    praxis:flag "receipts:pathbuf::Path to the receipt ledger (JSONL) to report on." ;
    praxis:flag "out:pathbuf::Path to write the verification report JSON to." ;
    praxis:nounAbout "Lean 4/Lake kernel admission gate: verify, no-sorry audit, corpus reconciliation, and receipt reporting." ;
    rdfs:comment "Write a VerificationReport (status counts, missing receipts, duplicate labels) as JSON for downstream ggen/LaTeX rendering." .
