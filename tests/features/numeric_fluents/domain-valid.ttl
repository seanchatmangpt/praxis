@prefix pddl: <http://seanchatmangpt.github.io/praxis/pddl#> .

pddl:domain_rover_numeric
    a pddl:Domain ;
    pddl:name "rover-numeric" .

pddl:req_numeric a pddl:Requirement ; pddl:name ":numeric-fluents" .

pddl:type_rover a pddl:Type ; pddl:name "rover" .
pddl:type_waypoint a pddl:Type ; pddl:name "waypoint" .

pddl:pred_at a pddl:Predicate ;
    pddl:name "at" ;
    pddl:param [ pddl:index 0 ; pddl:var "?r" ; pddl:ofType "rover" ] ,
               [ pddl:index 1 ; pddl:var "?w" ; pddl:ofType "waypoint" ] .

pddl:func_energy a pddl:Fluent ;
    pddl:name "energy" ;
    pddl:param [ pddl:index 0 ; pddl:var "?r" ; pddl:ofType "rover" ] .

pddl:action_move a pddl:Action ;
    pddl:name "move" ;
    pddl:param [ pddl:index 0 ; pddl:var "?r" ; pddl:ofType "rover" ] ,
               [ pddl:index 1 ; pddl:var "?from" ; pddl:ofType "waypoint" ] ,
               [ pddl:index 2 ; pddl:var "?to" ; pddl:ofType "waypoint" ] ;
    pddl:precondition "(and (at ?r ?from) (>= (energy ?r) 10))" ;
    pddl:effect "(and (not (at ?r ?from)) (at ?r ?to) (decrease (energy ?r) 10))" .
