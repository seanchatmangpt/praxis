# measurement-mass-by-activity.rq — PROJ-766, Rail G measurement profile
# (PRD.md sec.16/22). Computes the raw per-family execution measure mu_x
# at the "activity" declared process scale: mass_i = count of admitted
# G_OCEL events attributed to activity family i, grouped directly by
# ocel:activityName (otel-to-ocel.construct.rq, PROJ-764, already asserts
# this on every derived ocel:Event — no attribute-node indirection needed
# here, unlike the workflow scale). Raw count only; see
# measurement-mass-by-workflow.rq's header for the normalization/statistics
# scope boundary, which applies identically here.
#
# Compiled into crates/cng/src/measurement.rs via include_str! (library
# query, per the crate's no-inline-SPARQL convention).
PREFIX ocel: <https://www.ocel-standard.org/2.0/>

SELECT ?family (COUNT(?ev) AS ?mass)
WHERE {
  GRAPH <urn:graph:ocel> {
    ?ev ocel:activityName ?family .
  }
}
GROUP BY ?family
ORDER BY ?family
