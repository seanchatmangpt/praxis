# shape-bad-precedes.rq — structural validator query (compiled in via include_str!).
# Placeholders: {PREFIX} = POWL2 vocabulary IRI prefix.
SELECT ?s WHERE { ?s <{PREFIX}precedes> ?o . FILTER(NOT EXISTS { ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <{PREFIX}ChildBinding> } || NOT EXISTS { ?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <{PREFIX}ChildBinding> }) }
