# bench-roles.dl — Datalog role/obligation/custody/closure layer for the
# rwai benchmark. Format: praxis-graphlaw legacy line rules `{body}=>{head}`
# (crates/praxis-graphlaw/src/parser/mod.rs Parser::parse). Facts are fed by
# the harness as `:wN :declaredRole :ROLE.` / `:wN :department :DEPT.` lines
# built from roster_admitted observation facts. Deterministic; no wall clock.
{?w :declaredRole ?r}=>{?w :derivedRole ?r}
{?w :derivedRole ?r. ?w :department ?d}=>{?w :custodyOf ?d}
{?w :derivedRole :reviewer}=>{?w :obligation :review-then-escalate-to-approver}
{?w :derivedRole :approver}=>{?w :obligation :authorize-transition}
{?w :derivedRole :operator}=>{?w :obligation :execute-standard-procedure}
{?w :derivedRole :auditor}=>{?w :obligation :verify-evidence-chain}
{?w :derivedRole :coordinator}=>{?w :obligation :route-and-schedule}
{?w :obligation ?o. ?w :custodyOf ?d}=>{?w :closure :accounted}
# PROJ-609: coordinators absorb interruption workloads and plan the next
# tick's standing (the two content-bearing categories both route to the
# coordinator role in the Mycin layer; these facts mirror that capacity).
{?w :derivedRole :coordinator}=>{?w :canAbsorb :interruption}
{?w :derivedRole :coordinator}=>{?w :canPlan :next-tick-standing}
# PROJ-621: operators execute external-API orchestration dispatches through
# the broker's machine surface (api-orchestration routes to the operator
# role in the Mycin layer; this fact mirrors that capacity).
{?w :derivedRole :operator}=>{?w :canOrchestrate :external-api}
# v26.7.12/13 Stage 2: SOC2 audit-engagement standing roles. The identity
# rule at the top of this file (:declaredRole -> :derivedRole) already
# covers any role name, including these 5; only the per-role obligation
# needs a new rule. Obligation text mirrors bench/roles.rs::soc2_role_rules
# EXACTLY (Mycin/Datalog parity — roles_test.rs::soc2_standing_roles_mycin_
# and_datalog_agree asserts the two never drift). Every obligation names an
# EVIDENCE deliverable, never a compliance verdict or auditor opinion (the
# same COMPLIANCE-OVERCLAIM FENCE bench/soc2.rs enforces mechanically over
# the PDDL domain).
{?w :derivedRole :control-owner}=>{?w :obligation :document-control-design-and-attach-evidence}
{?w :derivedRole :internal-audit-lead}=>{?w :obligation :execute-readiness-assessment-and-oe-testing}
{?w :derivedRole :compliance-program-manager}=>{?w :obligation :coordinate-scope-and-assemble-evidence-bundle}
{?w :derivedRole :remediation-engineer}=>{?w :obligation :implement-remediation-for-identified-exception}
{?w :derivedRole :evidence-custodian}=>{?w :obligation :maintain-evidence-chain-of-custody}
