# ocel-admissions.construct.rq (PROJ-611)
# Inputs: obs graph (obs:obsKind in admission_requested|admission_granted|
# resumed — the bounded-admission → resume loop of the workday).
# Outputs: ocel:Event + ocel:EventType triples, so refusal, admission
# request, admission grant, and resume all land in the OCEL evidence graph.
# eventId = obsSetId + '-' + obsSeq. activityName = the obs kind.
# Timestamp encoding: logical, deterministic — epoch 2000-01-01T00:00:00Z +
# obs:obsSeq seconds, identical to ocel-events.construct.rq. No wall clock;
# obsSeq is a logical sequence counter.
PREFIX obs:  <https://ggen.io/ontology/bench-obs#>
PREFIX ocel: <https://www.ocel-standard.org/2.0/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?ev a ocel:Event ;
      ocel:eventId ?eid ;
      ocel:activityName ?kind ;
      ocel:timestamp ?ts ;
      ocel:hasEventType ?etype .
  ?etype a ocel:EventType ;
      ocel:eventTypeName ?kind .
}
WHERE {
  ?o obs:obsKind ?kind ;
     obs:obsSeq ?seq ;
     obs:obsSetId ?setId .
  FILTER(?kind IN ("admission_requested", "admission_granted", "resumed"))
  BIND(CONCAT(?setId, "-", STR(?seq)) AS ?eid)
  BIND(IRI(CONCAT("https://ggen.io/bench/event/", ENCODE_FOR_URI(?eid))) AS ?ev)
  BIND(IRI(CONCAT("https://ggen.io/bench/event-type/", ENCODE_FOR_URI(?kind))) AS ?etype)
  BIND("2000-01-01T00:00:00Z"^^xsd:dateTime
       + STRDT(CONCAT("PT", STR(?seq), "S"), xsd:dayTimeDuration) AS ?ts)
}
ORDER BY ?setId ?seq
