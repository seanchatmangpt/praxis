# ocel-objects.construct.rq
# Inputs: obs graph (roster_admitted facts; any fact carrying obs:obsWorkflowId).
# Outputs: ocel:Object triples of ObjectType Worker and WorkflowExecution.
# Worker object IRI keyed by obsWorkerId; WorkflowExecution keyed by
# obsWorkflowId. Determinism: IRIs are pure functions of ids; ORDER BY.
PREFIX obs:  <https://ggen.io/ontology/bench-obs#>
PREFIX ocel: <https://www.ocel-standard.org/2.0/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT {
  ?obj a ocel:Object ;
       ocel:objectId ?oid ;
       ocel:hasObjectType ?otype .
  ?otype a ocel:ObjectType ;
       ocel:objectTypeName ?tname .
}
WHERE {
  {
    ?o obs:obsKind "roster_admitted" ;
       obs:obsWorkerId ?oid .
    BIND("Worker" AS ?tname)
    BIND(IRI(CONCAT("https://ggen.io/bench/object/worker/", ENCODE_FOR_URI(?oid))) AS ?obj)
  }
  UNION
  {
    ?o obs:obsWorkflowId ?oid .
    BIND("WorkflowExecution" AS ?tname)
    BIND(IRI(CONCAT("https://ggen.io/bench/object/workflow/", ENCODE_FOR_URI(?oid))) AS ?obj)
  }
  BIND(IRI(CONCAT("https://ggen.io/bench/object-type/", ENCODE_FOR_URI(?tname))) AS ?otype)
}
ORDER BY ?tname ?oid
