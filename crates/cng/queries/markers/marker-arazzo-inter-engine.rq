# marker-arazzo-inter-engine.rq (PROJ-727)
# Marker: ARAZZO_INTER_ENGINE_WORKFLOW_PROVEN.
# Inputs: OBSERVATION graph (bench-obs vocabulary; the marker store union).
# Output: single row ?value.
# *** INVERTED EXISTENCE MARKER (0 = proven convention preserved) ***
# Asserts an EXISTENTIAL: at least one rendered Arazzo/contract projection
# was dispatched to a REMOTE engine (an arazzo_workflow_dispatched and a
# remote_dispatch_sent sharing the same ex:dispatchId). The 0-iff-proven
# convention is kept by INVERSION: ?value = 0 when such a pair exists,
# 1 otherwise. Belongs ONLY to DISTRIBUTED_MARKER_MAP — a single-operator
# workday (loopback only) lawfully has no such pair.
# Determinism: aggregate + IF over a fixed graph.
PREFIX obs: <https://ggen.io/ontology/bench-obs#>
PREFIX ex:  <http://example.org/rwai#>

SELECT (IF(?pairs > 0, 0, 1) AS ?value)
WHERE {
  {
    SELECT (COUNT(DISTINCT ?d) AS ?pairs)
    WHERE {
      ?w obs:obsKind "arazzo_workflow_dispatched" ; ex:dispatchId ?d .
      ?r obs:obsKind "remote_dispatch_sent" ; ex:dispatchId ?d .
    }
  }
}
