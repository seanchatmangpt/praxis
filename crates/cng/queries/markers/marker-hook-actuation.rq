# marker-hook-actuation.rq (PROJ-622)
# Markers: HOOK_ACTUATION_PROVEN + ZERO_UNRECEIPTED_ACTUATION.
# Inputs: materialized OCEL graph (union of ocel-events.construct.rq and
# ocel-hook-receipts.construct.rq outputs).
# Predicate sources: ocel:eventTypeName "transition_fired"
# (ocel-events.construct.rq puts the ACTIVITY LABEL in ocel:activityName,
# so the kind is only reachable through the event type);
# ocel:activityName "hook_receipt" (ocel-hook-receipts.construct.rq puts
# the kind there); ex:hookDeltaHash (carried onto hook_receipt events by
# ocel-hook-receipts.construct.rq). Same law as the reconcile-gate
# metric-hook-actuations.rq (?mismatches column) — the marker restates it
# as a single ?value for the marker protocol.
# Output: single row ?value = (total transition_fired events) -
# (hook_receipt events carrying a hook delta hash). Expectation: 0
# (every executed transition has exactly one receipted actuation).
# Determinism: aggregates over a fixed graph; scalar subtraction.
PREFIX ocel: <https://www.ocel-standard.org/2.0/>
PREFIX ex:   <http://example.org/rwai#>

SELECT ((?total - ?receipted) AS ?value)
WHERE {
  {
    SELECT (COUNT(DISTINCT ?t) AS ?total)
    WHERE {
      ?t a ocel:Event ;
         ocel:hasEventType ?et .
      ?et ocel:eventTypeName "transition_fired" .
    }
  }
  {
    SELECT (COUNT(DISTINCT ?r) AS ?receipted)
    WHERE {
      ?r ocel:activityName "hook_receipt" ;
         ex:hookDeltaHash ?dh .
    }
  }
}
