# metric-replay.rq (PROJ-614)
# Inputs: materialized OCEL graph.
# Outputs: single row: ?count = COUNT(DISTINCT events with attributeKey 'replay.verified').
# ocel-replays.construct.rq projects replay_verified observations (emitted
# by the run/workday replay re-manufacture pass) into events carrying this
# attribute, so this metric is nonzero (== replayed-and-passed sets) after
# any replayed run; the reconcile gate compares it against the replay
# telemetry counter (the graph is the authority).
PREFIX ocel: <https://www.ocel-standard.org/2.0/>

SELECT (COUNT(DISTINCT ?ev) AS ?count)
WHERE {
  ?ev ocel:hasAttribute ?a .
  ?a ocel:attributeKey "replay.verified" .
}
ORDER BY ?count
