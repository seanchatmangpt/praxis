# registry-missing-fields.rq (PROJ-613)
# Inputs: ONE oxigraph store holding both dialect-registry.ttl (entries) and
# dialect-registry.shape.ttl (the closed SHACL law). Shape-driven: the
# required field list is read from the shape graph's sh:property/sh:path
# declarations (sh:minCount >= 1), never duplicated in Rust or here.
# Outputs: rows (?entry ?field) — one per registry entry missing a required
# field. A non-empty result is CNG_R14 DialectRegistryRefused naming the
# first (?entry, ?field) pair.
# Determinism: ORDER BY ?entry ?field over a fixed graph.
PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?entry ?field
WHERE {
  ?shape sh:targetClass ?class ;
         sh:property ?ps .
  ?ps sh:path ?field ;
      sh:minCount ?min .
  FILTER(?min >= 1)
  ?entry a ?class .
  FILTER NOT EXISTS { ?entry ?field ?value }
}
ORDER BY ?entry ?field
