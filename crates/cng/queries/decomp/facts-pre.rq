# facts-pre.rq — EDB projection (PROJ-704): (action, precondition atom)
# pairs over the lifted pddl-strips graph. Deterministic ORDER BY.
PREFIX pddl: <https://truex.io/ontology/pddl-strips#>

SELECT ?action ?atom
WHERE {
  ?action a pddl:Action ;
          pddl:precondition ?atom .
}
ORDER BY ?action ?atom
