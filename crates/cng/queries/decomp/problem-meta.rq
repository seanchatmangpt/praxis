# problem-meta.rq — problemName + domainName of a given Problem (PROJ-703).
# Placeholder {PROBLEM} substituted via str::replace.
PREFIX pddl: <https://truex.io/ontology/pddl-strips#>

SELECT ?problemName ?domainName
WHERE {
  <{PROBLEM}> pddl:problemName ?problemName ;
              pddl:fromDomain ?dom .
  ?dom pddl:domainName ?domainName .
}
