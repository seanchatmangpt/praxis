# metric-soc2-exceptions.rq
# Inputs: the SOC2 case-study INSTANCE graph (prov:/skos: vocabulary), same
#         graph metric-soc2-evidenced-controls.rq reads.
# Outputs: single row: ?count = COUNT(DISTINCT exception-register deliverable
#          entities generated by the Exception Identification phase
#          (skos:notation "AUDIT-EXCEPTION-ID"), per
#          packs/soc2-audit-pack/ontology.ttl's 10-phase SKOS scheme).
# Meaning: this counts EXCEPTION-REGISTER EVIDENCE ARTIFACTS produced by the
#          engagement — it does NOT count individual exceptions within a
#          register (this pipeline does not model that granularity; a human
#          auditor's exception register is itself the evidentiary artifact).
#          A nonzero count means "exception identification was performed and
#          evidenced for this engagement," never a claim about how many
#          deviations were found, and never a compliance verdict. See
#          crates/cng/src/bench/soc2.rs's module doc for the full
#          COMPLIANCE-OVERCLAIM FENCE.
# Determinism: aggregate over a fixed graph; single row needs no ORDER BY,
# one is present for uniformity.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT (COUNT(DISTINCT ?exceptionArtifact) AS ?count)
WHERE {
  ?phase a prov:Activity ;
         skos:notation "AUDIT-EXCEPTION-ID" ;
         prov:generated ?exceptionArtifact .
  ?exceptionArtifact a prov:Entity .
}
ORDER BY ?count
