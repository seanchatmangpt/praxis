# rwai-bench observation template (arazzo_workflow_dispatched, PROJ-727):
# a rendered Arazzo/contract projection left the broker (state DISPATCHED)
# — the dispatched twin marker-arazzo-dispatch.rq requires for every
# arazzo_workflow_generated observation sharing the same ex:dispatchId.
# {{TARGET_ENGINE}} is "loopback-local" on the loopback surface and the
# remote engine id on the multi-engine surface.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "arazzo_workflow_dispatched" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:targetEngine "{{TARGET_ENGINE}}" .
