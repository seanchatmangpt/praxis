# rwai-bench observation template (hook_standing, PROJ-613): emitted as a
# hook passes each HookStanding lifecycle state (dialect-registry.ttl
# dreg:HookStanding ladder: DECLARED..REPLAYABLE, REFUSED off-ladder).
# {{STATE}} is the ladder label (e.g. "REGISTERED"); {{STANDING_ORDER}} its
# dreg:standingOrder position. Logical ordering only; no wall clock.
# Vocabulary: crates/praxis-graphlaw/ontologies/core/bench-obs.ttl + ex: +
# dreg: (crates/cng/hooks/dialect-registry.ttl).
@prefix ex:   <http://example.org/rwai#> .
@prefix obs:  <https://ggen.io/ontology/bench-obs#> .
@prefix dreg: <http://seanchatmangpt.github.io/praxis/dreg#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "hook_standing" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:hookName "{{HOOK_NAME}}" ;
  ex:hookStandingState "{{STATE}}" ;
  dreg:hookStanding dreg:{{STATE}} ;
  ex:dialect dreg:{{DIALECT}} ;
  ex:standingOrder "{{STANDING_ORDER}}"^^xsd:integer .
