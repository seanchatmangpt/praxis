# rwai-bench observation template (dispatch_poll, PROJ-619): one bounded
# poll of an awaited dispatch's collection surface. The poll loop is
# structurally bounded by the contract's deadlineTicks (logical ticks) —
# unbounded polling is impossible by construction; every poll is receipted
# as this observation. {{POLL_NO}} is a logic counter, never wall clock.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "dispatch_poll" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:pollNumber "{{POLL_NO}}"^^xsd:integer .
