# rwai-bench observation template (admission_granted): the minimal missing
# admission named by an ex:AdmissionRequest was admitted (PROJ-611). The
# grant is seed-derived and MOCKED-HUMAN: the admission mechanism is real,
# the granting human is simulated by the benchmark. {{TICK}} is a logic
# counter typed xsd:integer — never wall-clock time.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "admission_granted" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:missingAdmission "{{MISSING}}" .
