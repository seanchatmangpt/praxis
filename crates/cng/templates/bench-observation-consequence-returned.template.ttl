# rwai-bench observation template (consequence_returned, PROJ-619): a
# candidate consequence artifact arrived on the collection surface
# (dispatch/inbox/). Returned is NOT admitted: the lawful re-entry pipeline
# (provenance -> correlation -> authority -> structural -> semantic) runs
# AFTER this observation, and only admission lets the result touch standing.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "consequence_returned" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:correlationId "{{CORRELATION_ID}}" .
