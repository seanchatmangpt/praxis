# rwai-bench observation template (dispatch_sent, PROJ-619): an outbound
# DispatchContract left the broker through the loopback adapter (written to
# dispatch/outbox/). Zero-unreceipted-dispatch law: every outbound dispatch
# is receipted as this observation before any acknowledgement. {{TICK}} and
# {{DEADLINE_TICKS}} are logic counters — never wall-clock time.
# {{PARENT_DISPATCH}} is "none" for top-level dispatches; {{CLOSURE_LAW}} is
# "NONE" when the contract declares no parent-child closure law.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "dispatch_sent" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:parentDispatch "{{PARENT_DISPATCH}}" ;
  ex:executionClass "{{EXECUTION_CLASS}}" ;
  ex:correlationId "{{CORRELATION_ID}}" ;
  ex:closureLaw "{{CLOSURE_LAW}}" ;
  ex:deadlineTicks "{{DEADLINE_TICKS}}"^^xsd:integer .
