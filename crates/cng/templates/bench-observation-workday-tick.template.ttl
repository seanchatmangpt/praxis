# rwai-bench observation template (workday_tick): one per logical tick of
# the single-operator workday (PROJ-608). {{TICK}} is a logic counter typed
# xsd:integer — never wall-clock time; nothing time-based enters digests.
# Vocabulary: crates/praxis-graphlaw/ontologies/core/bench-obs.ttl + ex:.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "workday_tick" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:operator ex:{{WORKER_ID}} .
