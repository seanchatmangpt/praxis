# rwai-bench observation template (consequence_admitted, PROJ-619): the
# returned consequence passed every re-entry stage in order (provenance ->
# correlation -> authority -> structural -> semantic) and was admitted into
# the observation store. Only from this point does the external result exist
# for standing derivation and closure evaluation.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "consequence_admitted" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:correlationId "{{CORRELATION_ID}}" .
