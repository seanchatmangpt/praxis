# rwai-bench observation template (dispatch_acknowledged, PROJ-619): the
# dispatch target (loopback adapter; a real network adapter is the documented
# replacement seam) acknowledged receipt of the outbound contract.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "dispatch_acknowledged" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" .
