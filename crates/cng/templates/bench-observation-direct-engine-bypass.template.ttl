# rwai-bench observation template (direct_engine_bypass, PROJ-727):
# FORBIDDEN evidence — a consequence entered an engine's admission surface
# without the lawful remote dispatch/ledger path. NO production code path
# in this crate emits this observation: it exists so the isolation marker
# (marker-engine-isolation.rq, DIRECT_ENGINE_BYPASSES_ZERO) has a defined
# referent and so negative-test fixtures can falsify the marker. Any
# nonzero count is a typed CNG_R20 MarkerFalse refusal.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "direct_engine_bypass" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  obs:producedByEngine "{{ENGINE_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" .
