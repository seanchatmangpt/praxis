# rwai-bench observation template (resumed): an interrupted (refused)
# workday workflow was re-manufactured after its bounded admission was
# granted, at tick+1 (PROJ-611). {{TICK}} is a logic counter typed
# xsd:integer — never wall-clock time.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "resumed" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer .
