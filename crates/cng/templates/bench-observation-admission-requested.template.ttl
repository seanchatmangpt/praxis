# rwai-bench observation template (admission_requested): a workday tick's
# manufacture refused and an ex:AdmissionRequest artifact naming exactly the
# minimal missing admission was manufactured (PROJ-611). {{TICK}} is a logic
# counter typed xsd:integer — never wall-clock time.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "admission_requested" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:missingAdmission "{{MISSING}}" ;
  ex:refusalCode "{{REFUSAL_CODE}}" .
