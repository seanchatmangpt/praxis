# rwai-bench observation template (next_action): the answer of the
# standing-next-action.rq SELECT at a logical tick (PROJ-610). Every answer
# the workday loop acts on is first logged into the observation stream.
# {{TICK}} is a logic counter typed xsd:integer — never wall-clock time.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "next_action" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:action "{{ACTION}}" .
