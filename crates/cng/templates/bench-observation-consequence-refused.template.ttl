# rwai-bench observation template (consequence_refused, PROJ-619/620): the
# returned consequence failed the named re-entry stage (CNG_R17
# ExternalConsequenceRefused). Partial external execution is never silently
# discarded — the refusal itself is evidence (this observation flows into the
# OCEL evidence graph), and the contract's declared remediation follows.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "consequence_refused" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:refusalStage "{{STAGE}}" .
