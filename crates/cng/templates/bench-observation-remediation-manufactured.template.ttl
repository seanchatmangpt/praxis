# rwai-bench observation template (remediation_manufactured, PROJ-620):
# the contract's declared remediation workflow was manufactured — REMEDY is
# "escalation" (deadline expiry, the contract's escalationLaw) or
# "compensation" (refused conformance, the contract's compensationLaw).
# Compensation/escalation IS a workflow: it carries authority, inputs,
# expected consequence, receipt, and replay, and routes back through the
# same broker as {{REMEDY_DISPATCH}}.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "remediation_manufactured" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:remedy "{{REMEDY}}" ;
  ex:remedyDispatch "{{REMEDY_DISPATCH}}" .
