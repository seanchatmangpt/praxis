# rwai-bench observation template (arazzo_workflow_generated, PROJ-727):
# the dispatch broker rendered a contract's Arazzo/contract projection
# (state MANUFACTURED -> ARAZZO_RENDERED). Every generated projection must
# gain an arazzo_workflow_dispatched twin (marker-arazzo-dispatch.rq,
# ARAZZO_WORKFLOWS_DISPATCHED). {{TICK}} is a logic counter, never wall
# clock; {{CONTRACT_DIGEST}} is the content-derived BLAKE3 of the rendered
# contract Turtle.
@prefix ex:  <http://example.org/rwai#> .
@prefix obs: <https://ggen.io/ontology/bench-obs#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:{{SUBJECT}} a obs:Observation ;
  obs:obsKind "arazzo_workflow_generated" ;
  obs:obsSeq {{SEQ}} ;
  obs:obsSetId "{{SET_ID}}" ;
  ex:logicalTick "{{TICK}}"^^xsd:integer ;
  ex:dispatchId "{{DISPATCH_ID}}" ;
  ex:executionClass "{{EXECUTION_CLASS}}" ;
  ex:contractDigest "{{CONTRACT_DIGEST}}" .
