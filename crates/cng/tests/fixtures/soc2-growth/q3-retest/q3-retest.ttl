# SOC2 Type II continuous-evidencing case study (v26.7.13 Stage 3) -- Q3
# quarterly re-test residue for the Operating Effectiveness Testing socket.
# See q1-retest.ttl for the fixture-shape disclosure.
#
# COMPLIANCE-OVERCLAIM FENCE: "quarterly-evidence-closed-q3" is evidence
# closure, never a compliance verdict.
@prefix ceng:    <urn:chatman:engine#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

_:artifact
    skos:notation "OE-TESTING-GROWTH-Q3" ;
    dcterms:description "Q3 quarterly operating-effectiveness re-test residue: draws a fresh quarterly sample and closes Q3's evidence for the 12-month Type II observation period."@en ;
    ceng:pddlDomain """
(define (domain arclight-soc2-oe-quarterly-retest-q3)
  (:requirements :strips)
  (:predicates
    (quarterly-sample-drawn-q3 ?x)
    (quarterly-evidence-closed-q3 ?x))
  (:action retest-operating-effectiveness-q3
    :parameters (?x)
    :precondition (and (quarterly-sample-drawn-q3 ?x))
    :effect (and (quarterly-evidence-closed-q3 ?x))))
""" ;
    ceng:pddlProblem """
(define (problem arclight-soc2-oe-quarterly-retest-q3-p)
  (:domain arclight-soc2-oe-quarterly-retest-q3)
  (:objects arclight)
  (:init (quarterly-sample-drawn-q3 arclight))
  (:goal (and (quarterly-evidence-closed-q3 arclight))))
""" .
