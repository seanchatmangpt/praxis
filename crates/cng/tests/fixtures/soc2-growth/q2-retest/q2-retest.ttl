# SOC2 Type II continuous-evidencing case study (v26.7.13 Stage 3) -- Q2
# quarterly re-test residue for the Operating Effectiveness Testing socket.
# See q1-retest.ttl for the fixture-shape disclosure (self-contained
# domain+problem residue, admitted via pipeline::import_artifacts).
#
# COMPLIANCE-OVERCLAIM FENCE: "quarterly-evidence-closed-q2" is evidence
# closure, never a compliance verdict.
@prefix ceng:    <urn:chatman:engine#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

_:artifact
    skos:notation "OE-TESTING-GROWTH-Q2" ;
    dcterms:description "Q2 quarterly operating-effectiveness re-test residue: draws a fresh quarterly sample and closes Q2's evidence. A separate exception+remediation residue (q2-remediation.ttl) grows a second, independent child at this same socket for the evidence gap this quarter also surfaces."@en ;
    ceng:pddlDomain """
(define (domain arclight-soc2-oe-quarterly-retest-q2)
  (:requirements :strips)
  (:predicates
    (quarterly-sample-drawn-q2 ?x)
    (quarterly-evidence-closed-q2 ?x))
  (:action retest-operating-effectiveness-q2
    :parameters (?x)
    :precondition (and (quarterly-sample-drawn-q2 ?x))
    :effect (and (quarterly-evidence-closed-q2 ?x))))
""" ;
    ceng:pddlProblem """
(define (problem arclight-soc2-oe-quarterly-retest-q2-p)
  (:domain arclight-soc2-oe-quarterly-retest-q2)
  (:objects arclight)
  (:init (quarterly-sample-drawn-q2 arclight))
  (:goal (and (quarterly-evidence-closed-q2 arclight))))
""" .
