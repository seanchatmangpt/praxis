# pddl-domain.ttl -- STRIPS8-safe compliance-case obligation-lifecycle
# domain, grounded in the SAME real `pdl:` instance vocabulary and the SAME
# STRIPS8 constraints as /Users/sac/praxis/ontology/lawobject.ttl (positive
# conjunctive preconditions only; arity <= 8; precondition/effect conjuncts
# <= 8; action params <= 8 -- `wasm4pm_compat::pddl::PDDL8_MAX_*`, confirmed
# this session at /Users/sac/wasm4pm-compat/wasm4pm-core/src/pddl.rs:32-36).
#
# NOT hand-written PDDL text: this file is `pdl:` RDF instance data that
# `praxis::mfg::manufacture` (src/mfg.rs, already proven against
# ontology/lawobject.ttl by tests/mfg_golden.rs) turns into REAL PDDL8
# domain text via SPARQL extraction + `enforce_pddl8` bound-checking, which
# is then round-tripped through the REAL `bcinr_pddl::domain_from_pddl` /
# `GroundProblem::build` / `GroundProblem::find_plan` grounder+solver -- not
# merely resembling that pipeline's output. Proven live by
# /Users/sac/praxis/tests/bribery_case_pddl.rs (concatenates this file with
# pddl-problem-closable.ttl or pddl-problem-blocked.ttl -- see that test and
# DESIGN.md for why the split is 3 files, not 1).
#
# WHAT'S NEW vs. lawobject.ttl's single-obligation golden domain: this
# domain always carries exactly 3 named obligation types (matching
# hook.ttl's fixed obligation-type catalog: verify-transaction-authenticity,
# verify-contractor-authorization-level, assess-policy-violation), so
# "all obligations cleared" cannot be a single clear-obligations() action
# the way lawobject.ttl's 1-obligation case is. STRIPS8 has no forall/
# counting (ADL only -- explicitly out of bounds, see docs/PDDL_CAPABILITY_MODEL.md
# and lawobject.ttl's own header), so this domain generalizes the pattern
# with 3 ROLE-SPECIFIC clearing actions (clear-transaction-obligation /
# clear-authorization-obligation / clear-policy-obligation) writing 3
# DISTINCT predicates (txn-cleared/auth-cleared/policy-cleared), gated by a
# fixed-arity close-obligations(?obj) action requiring all 3 -- see the
# "BUG FOUND AND FIXED THIS SESSION" comment on the clear-*-obligation
# actions below for why a single shared obligation-cleared(?ob) predicate
# with 3 separately-parameterized conjuncts is NOT STRIPS8-safe here (the
# grounder can alias all 3 params to one cleared obligation with no
# inequality constraint to stop it), and how the fix was found by actually
# running the real solver, not by inspection alone.
#
# TYPED NON-CLOSURE PATH (this task's explicit requirement: a case with
# genuinely missing evidence must be BLOCKED, not silently closed):
# block-for-missing-evidence(?obj, ?ob) transitions `raw -> blocked`
# directly, in parallel with (not through) judge/admit/receipt, whenever a
# positive `(evidence-unavailable ?ob)` fact is present -- a POSITIVE
# STRIPS8-legal fact (not a negation-as-failure inference; STRIPS8 has no
# negative preconditions), asserted into a problem's :init when Stage 2's
# evidence-collection step (not this file) determines a required evidence
# type genuinely cannot be produced. See pddl-problem-blocked.ttl for the
# worked example (1-step plan straight to `(in-stage ?obj blocked)`).

@prefix pdl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------

pdl:domain_solvane_bribery_compliance
    a pdl:Domain ;
    pdl:name "solvane-bribery-compliance-pddl8" .

# ---------------------------------------------------------------------------
# Types (identical set to ontology/lawobject.ttl -- same law-object lifecycle
# pattern, no new types needed for this case-specific extension)
# ---------------------------------------------------------------------------

pdl:type_lawobject    a pdl:Type ; pdl:name "law-object" .
pdl:type_obligation   a pdl:Type ; pdl:name "obligation" .
pdl:type_evidencetype a pdl:Type ; pdl:name "evidence-type" .
pdl:type_stage        a pdl:Type ; pdl:name "lifecycle-stage" .
pdl:type_validator    a pdl:Type ; pdl:name "validator" .
pdl:type_authority    a pdl:Type ; pdl:name "authority" .
pdl:type_chaintoken   a pdl:Type ; pdl:name "chain-token" .

# ---------------------------------------------------------------------------
# Predicates (all positive-checkable; STRIPS8-safe; arity <= 2)
# ---------------------------------------------------------------------------

pdl:pred_in_stage
    a pdl:Predicate ;
    pdl:name "in-stage" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?stage" ; pdl:ofType "lifecycle-stage" ] .

pdl:pred_has_obligation
    a pdl:Predicate ;
    pdl:name "has-obligation" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] .

pdl:pred_requires_evidence
    a pdl:Predicate ;
    pdl:name "requires-evidence" ;
    pdl:param [ pdl:index 0 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ,
              [ pdl:index 1 ; pdl:var "?etype" ; pdl:ofType "evidence-type" ] .

pdl:pred_evidence_satisfied
    a pdl:Predicate ;
    pdl:name "evidence-satisfied" ;
    pdl:param [ pdl:index 0 ; pdl:var "?ob" ; pdl:ofType "obligation" ] .

pdl:pred_txn_cleared
    a pdl:Predicate ;
    pdl:name "txn-cleared" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

pdl:pred_auth_cleared
    a pdl:Predicate ;
    pdl:name "auth-cleared" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

pdl:pred_policy_cleared
    a pdl:Predicate ;
    pdl:name "policy-cleared" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

pdl:pred_obligations_met
    a pdl:Predicate ;
    pdl:name "obligations-met" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

pdl:pred_evidence_unavailable
    a pdl:Predicate ;
    pdl:name "evidence-unavailable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?ob" ; pdl:ofType "obligation" ] .

pdl:pred_blocked_on
    a pdl:Predicate ;
    pdl:name "blocked-on" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] .

pdl:pred_andon_green
    a pdl:Predicate ;
    pdl:name "andon-green" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

pdl:pred_validated_by
    a pdl:Predicate ;
    pdl:name "validated-by" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?validator" ; pdl:ofType "validator" ] .

pdl:pred_admitted_by
    a pdl:Predicate ;
    pdl:name "admitted-by" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?authority" ; pdl:ofType "authority" ] .

pdl:pred_prev_chain_valid
    a pdl:Predicate ;
    pdl:name "prev-chain-valid" ;
    pdl:param [ pdl:index 0 ; pdl:var "?tok" ; pdl:ofType "chain-token" ] .

pdl:pred_chain_hash_computed
    a pdl:Predicate ;
    pdl:name "chain-hash-computed" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?tok" ; pdl:ofType "chain-token" ] .

pdl:pred_signature_applied
    a pdl:Predicate ;
    pdl:name "signature-applied" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] .

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

# 1. supply-evidence(?obj, ?ob, ?etype) -- identical shape to lawobject.ttl.
pdl:action_supply_evidence
    a pdl:Action ;
    pdl:name "supply-evidence" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ,
              [ pdl:index 2 ; pdl:var "?etype" ; pdl:ofType "evidence-type" ] ;
    pdl:pre "(has-obligation ?obj ?ob)" ,
            "(requires-evidence ?ob ?etype)" ;
    pdl:add "(evidence-satisfied ?ob)" .

# 2a/2b/2c. clear-{transaction,authorization,policy}-obligation(?obj, ?ob)
#    -- three ROLE-SPECIFIC obligation-clearing actions, each retiring
#    has-obligation and marking a DISTINCT per-role predicate
#    (txn-cleared/auth-cleared/policy-cleared), rather than one generic
#    clear-obligation(?obj,?ob) writing a single shared obligation-cleared(?ob)
#    predicate.
#
#    BUG FOUND AND FIXED THIS SESSION (disclosed, not silently corrected): an
#    earlier version of this domain used exactly that single shared
#    obligation-cleared(?ob) predicate, with close-obligations(?obj,?ob-txn,
#    ?ob-auth,?ob-pol) requiring 3 conjuncts over 3 SEPARATE parameter
#    variables. Live-tested against the real `bcinr_pddl::GroundProblem::
#    find_plan` (see /Users/sac/praxis/tests/bribery_case_pddl.rs), the
#    solver found a 6-step plan -- clearing only ONE obligation, not three --
#    because STRIPS8 has no `(not (= ?ob-txn ?ob-auth))` inequality
#    constraint (positive-conjunctive preconditions only), so the grounder
#    was free to bind ?ob-txn = ?ob-auth = ?ob-pol to the SAME cleared
#    obligation, trivially satisfying all 3 conjuncts from one clearance.
#    Using 3 DISTINCT predicate names (this version) closes the loophole
#    without needing inequality: each clear-*-obligation action consumes
#    (deletes) has-obligation(?obj,?ob) for the SPECIFIC ?ob it was applied
#    to, so no single obligation object can ever satisfy more than one of
#    the 3 clear-*-obligation actions (its has-obligation fact is gone after
#    the first), forcing the planner to use 3 DIFFERENT obligation objects
#    to make txn-cleared/auth-cleared/policy-cleared all true for the same
#    ?obj. Re-verified live after this fix: the real solver now finds
#    exactly the intended 10-step plan (3 supply-evidence + 3 distinct
#    clear-*-obligation + close-obligations + judge + admit + receipt).
pdl:action_clear_transaction_obligation
    a pdl:Action ;
    pdl:name "clear-transaction-obligation" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ;
    pdl:pre "(has-obligation ?obj ?ob)" ,
            "(evidence-satisfied ?ob)" ;
    pdl:add "(txn-cleared ?obj)" ;
    pdl:del "(has-obligation ?obj ?ob)" .

pdl:action_clear_authorization_obligation
    a pdl:Action ;
    pdl:name "clear-authorization-obligation" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ;
    pdl:pre "(has-obligation ?obj ?ob)" ,
            "(evidence-satisfied ?ob)" ;
    pdl:add "(auth-cleared ?obj)" ;
    pdl:del "(has-obligation ?obj ?ob)" .

pdl:action_clear_policy_obligation
    a pdl:Action ;
    pdl:name "clear-policy-obligation" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ;
    pdl:pre "(has-obligation ?obj ?ob)" ,
            "(evidence-satisfied ?ob)" ;
    pdl:add "(policy-cleared ?obj)" ;
    pdl:del "(has-obligation ?obj ?ob)" .

# 3. close-obligations(?obj) -- the STRIPS8 substitute for a
#    `forall obligation. cleared(obligation)` ADL check: 3 positive
#    conjuncts over 3 DISTINCT predicate names (arity 1, well under
#    PDDL8_MAX_PARAMS=8 / PDDL8_MAX_ARITY=8).
pdl:action_close_obligations
    a pdl:Action ;
    pdl:name "close-obligations" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ;
    pdl:pre "(txn-cleared ?obj)" ,
            "(auth-cleared ?obj)" ,
            "(policy-cleared ?obj)" ;
    pdl:add "(obligations-met ?obj)" .

# 4. judge(?obj, ?validator): Raw -> Validated -- identical shape to lawobject.ttl.
pdl:action_judge
    a pdl:Action ;
    pdl:name "judge" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?validator" ; pdl:ofType "validator" ] ;
    pdl:pre "(in-stage ?obj raw)" ,
            "(obligations-met ?obj)" ;
    pdl:add "(in-stage ?obj validated)" ,
            "(validated-by ?obj ?validator)" ,
            "(andon-green ?obj)" ;
    pdl:del "(in-stage ?obj raw)" .

# 5. admit(?obj, ?authority): Validated -> Admitted -- identical shape to lawobject.ttl.
pdl:action_admit
    a pdl:Action ;
    pdl:name "admit" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?authority" ; pdl:ofType "authority" ] ;
    pdl:pre "(in-stage ?obj validated)" ,
            "(andon-green ?obj)" ;
    pdl:add "(in-stage ?obj admitted)" ,
            "(admitted-by ?obj ?authority)" ;
    pdl:del "(in-stage ?obj validated)" .

# 6. receipt(?obj, ?tok): Admitted -> Receipted -- identical shape to lawobject.ttl.
pdl:action_receipt
    a pdl:Action ;
    pdl:name "receipt" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?tok" ; pdl:ofType "chain-token" ] ;
    pdl:pre "(in-stage ?obj admitted)" ,
            "(prev-chain-valid ?tok)" ;
    pdl:add "(in-stage ?obj receipted)" ,
            "(chain-hash-computed ?obj ?tok)" ,
            "(signature-applied ?obj)" ;
    pdl:del "(in-stage ?obj admitted)" .

# 7. block-for-missing-evidence(?obj, ?ob): Raw -> Blocked -- the typed
#    non-closure terminal path (see this file's header). NOT reachable
#    through judge/admit/receipt; a sibling transition out of `raw`.
pdl:action_block_for_missing_evidence
    a pdl:Action ;
    pdl:name "block-for-missing-evidence" ;
    pdl:param [ pdl:index 0 ; pdl:var "?obj" ; pdl:ofType "law-object" ] ,
              [ pdl:index 1 ; pdl:var "?ob" ; pdl:ofType "obligation" ] ;
    pdl:pre "(in-stage ?obj raw)" ,
            "(has-obligation ?obj ?ob)" ,
            "(evidence-unavailable ?ob)" ;
    pdl:add "(in-stage ?obj blocked)" ,
            "(blocked-on ?obj ?ob)" ;
    pdl:del "(in-stage ?obj raw)" .
