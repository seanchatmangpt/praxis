# pddl-problem-closable.ttl -- worked scenario over pddl-domain.ttl where
# ALL 3 obligations' required evidence is (eventually) supplied, so the case
# reaches the `receipted` terminal state (judged/admitted/receipted
# lawfully). Concatenate with pddl-domain.ttl before calling
# `praxis::mfg::manufacture` (see DESIGN.md); proven live by
# /Users/sac/praxis/tests/bribery_case_pddl.rs, which shows the real plan
# `bcinr_pddl::GroundProblem::find_plan` produces.
#
# Object names mirror hook.ttl's derived `sc:hasObligation` targets' local
# names exactly (verify-transaction-authenticity /
# verify-contractor-authorization-level / assess-policy-violation) and
# case.ttl's case identifier (case-brb-2026-0417 <- BRB-2026-0417) for
# cross-file traceability, per this task's "instance data reuses identifiers
# across files" doctrine -- these are bare PDDL symbol names (PDDL objects
# have no IRI form), not the same RDF term, but the local-name match is
# intentional and load-bearing for a human tracing the case end to end.

@prefix pddl: <http://seanchatmangpt.github.io/praxis/pddl#> .

pddl:problem_bribery_case_brb_2026_0417
    a pddl:Problem ;
    pddl:name "bribery-case-brb-2026-0417" ;
    pddl:domain "solvane-bribery-compliance-pddl8" ;
    pddl:object [ pddl:name "case-brb-2026-0417" ; pddl:ofType "law-object" ] ,
               [ pddl:name "verify-transaction-authenticity" ; pddl:ofType "obligation" ] ,
               [ pddl:name "verify-contractor-authorization-level" ; pddl:ofType "obligation" ] ,
               [ pddl:name "assess-policy-violation" ; pddl:ofType "obligation" ] ,
               [ pddl:name "etype-card-statement" ; pddl:ofType "evidence-type" ] ,
               [ pddl:name "etype-authorization-record" ; pddl:ofType "evidence-type" ] ,
               [ pddl:name "etype-compliance-policy-citation" ; pddl:ofType "evidence-type" ] ,
               [ pddl:name "compliance-officer-shreya-patel" ; pddl:ofType "validator" ] ,
               [ pddl:name "general-counsel-marcus-webb" ; pddl:ofType "authority" ] ,
               [ pddl:name "tok-genesis-brb-2026-0417" ; pddl:ofType "chain-token" ] ,
               [ pddl:name "raw" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "validated" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "admitted" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "receipted" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "blocked" ; pddl:ofType "lifecycle-stage" ] ;
    pddl:init "(in-stage case-brb-2026-0417 raw)" ,
             "(has-obligation case-brb-2026-0417 verify-transaction-authenticity)" ,
             "(has-obligation case-brb-2026-0417 verify-contractor-authorization-level)" ,
             "(has-obligation case-brb-2026-0417 assess-policy-violation)" ,
             "(requires-evidence verify-transaction-authenticity etype-card-statement)" ,
             "(requires-evidence verify-contractor-authorization-level etype-authorization-record)" ,
             "(requires-evidence assess-policy-violation etype-compliance-policy-citation)" ,
             "(prev-chain-valid tok-genesis-brb-2026-0417)" ;
    pddl:goal "(in-stage case-brb-2026-0417 receipted)" .
