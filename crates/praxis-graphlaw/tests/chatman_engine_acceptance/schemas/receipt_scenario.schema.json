{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.chatman.io/schemas/receipt_scenario.schema.json",
  "title": "Receipt scenario",
  "description": "Chatman engine acceptance/falsification scenario. The expected_refusal enum mirrors Refusal::name() in crates/praxis-graphlaw/src/chatman/abi.rs exactly; tests/chatman_static_gates.rs asserts set-equality.",
  "type": "object",
  "required": [
    "case",
    "kind",
    "seed",
    "input"
  ],
  "additionalProperties": false,
  "properties": {
    "case": {
      "type": "string",
      "minLength": 1,
      "description": "Unique scenario identifier (kebab-case)."
    },
    "kind": {
      "enum": [
        "acceptance",
        "falsification"
      ],
      "description": "acceptance: input must be admitted; falsification: input must be refused with expected_refusal."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Deterministic seed; same seed => same bytes."
    },
    "mutation": {
      "type": "string",
      "description": "Optional named mutation applied to the acceptance base case to produce this falsification case."
    },
    "expected_refusal": {
      "enum": [
        "ValidationFailed",
        "PlanInfeasible",
        "TraceUnlawful",
        "HookUnpermitted",
        "MissingReceipt",
        "SnapshotNotFound",
        "BoundaryRequestMissingReceipt",
        "Triple8UniverseOverflow",
        "TermNotInTriple8Universe",
        "ProfileSymbolTableMismatch",
        "ProjectionHashMismatch",
        "WarmPathRequired",
        "AdmissionTableMismatch",
        "HookPatternNotAdmitted",
        "OcelEventNotAdmitted",
        "LeastExpressiveRouteViolation",
        "UnsupportedDialect",
        "N3UnavailableByProfile",
        "N3ActuationRefused",
        "RouteDecisionMismatch",
        "GraphSnapshotMismatch",
        "ProfileHashMismatch",
        "AgentOverrideDenied",
        "WitnessNotAuthority",
        "BreedUnpermitted",
        "NondeterministicOperatorRequiresReceipt",
        "ProcessReceiptShadowType",
        "DuplicateCanonicalTapeType",
        "TripleTermInSnapshot"
      ],
      "description": "Required for kind=falsification: the Refusal::name() value the engine must return."
    },
    "expected_behavior": {
      "type": "string",
      "description": "Human-readable statement of the admitted behavior (kind=acceptance)."
    },
    "input": {
      "description": "Receipt construction and verification input.",
      "type": "object",
      "required": [
        "subject",
        "witness",
        "replay_hint",
        "canon_nquads"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "witness": {
          "type": "string",
          "minLength": 1
        },
        "replay_hint": {
          "type": "string",
          "minLength": 1
        },
        "canon_nquads": {
          "type": "string",
          "description": "Canonical N-Quads material, one quad per line, lines sorted; the digest is computed over these bytes with BLAKE3."
        },
        "carried_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Optional digest a mutated scenario carries; verify() must recompute and refuse on mismatch."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "falsification"
          }
        }
      },
      "then": {
        "required": [
          "expected_refusal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "acceptance"
          }
        }
      },
      "then": {
        "required": [
          "expected_behavior"
        ]
      }
    }
  ]
}
