# The Lord's Prayer workflow kernel — v26.7.3 demo domain.
#
# God is not modeled as an agent. God is the receptacle of the unbounded:
# the system models only the HUMAN-SIDE workflow of surrender, provision,
# forgiveness, guard, and deliverance. Raw meaning never triggers execution
# — this document is itself admitted through the quarantine door, and the
# hooks below fire only on admitted graph deltas.
#
# The clause ORDER is not authored: the solver derives it from the declared
# preconditions (orient-to-father -> surrender-will -> request-daily-bread
# -> write-receipt), the same way every praxis plan is derived, never chosen.

@prefix wf:   <http://seanchatmangpt.github.io/praxis/workflow#> .
@prefix hook: <http://seanchatmangpt.github.io/praxis/hook#> .
@prefix prx:  <http://seanchatmangpt.github.io/praxis/life#> .
@prefix ex:   <http://seanchatmangpt.github.io/praxis/prayer#> .
@prefix pk:   <http://seanchatmangpt.github.io/praxis/prayer-kernel#> .

# ---------------------------------------------------------------------------
# The prayer kernel — ALL 11 clauses as typed nodes.
#
# The boundary is a STRING property, never an executable node: God is not
# typed as wf:Capability, hook:Hook, agent, or handler anywhere in this
# document. "god-receives-unbounded" marks the clauses whose object is
# surrendered, not computed; "human-only" marks acts reserved for the human;
# "automatable-support" marks clauses where a bounded support workflow may
# assist the human act.
# ---------------------------------------------------------------------------

pk:LordPrayerKernel a pk:Kernel ;
    pk:clause pk:our-father, pk:hallowed-name, pk:kingdom-come,
        pk:will-be-done, pk:on-earth-as-heaven, pk:daily-bread,
        pk:forgive-debts, pk:forgive-debtors, pk:temptation-guard,
        pk:deliverance, pk:doxology .

pk:our-father a pk:Clause ;
    pk:name "our-father" ;
    pk:problemClass "orientation" ;
    pk:boundary "human-only" ;
    pk:action ex:DailyPrayerWorkflow .

pk:hallowed-name a pk:Clause ;
    pk:name "hallowed-name" ;
    pk:problemClass "reverence" ;
    pk:boundary "human-only" .

pk:kingdom-come a pk:Clause ;
    pk:name "kingdom-come" ;
    pk:problemClass "authority-transfer" ;
    pk:boundary "god-receives-unbounded" .

pk:will-be-done a pk:Clause ;
    pk:name "will-be-done" ;
    pk:problemClass "will-surrender" ;
    pk:boundary "human-only" .

pk:on-earth-as-heaven a pk:Clause ;
    pk:name "on-earth-as-heaven" ;
    pk:problemClass "alignment" ;
    pk:boundary "god-receives-unbounded" .

pk:daily-bread a pk:Clause ;
    pk:name "daily-bread" ;
    pk:problemClass "provision-anxiety" ;
    pk:boundary "automatable-support" ;
    pk:action ex:DailyBreadHook .

pk:forgive-debts a pk:Clause ;
    pk:name "forgive-debts" ;
    pk:problemClass "owed-debt" ;
    pk:boundary "god-receives-unbounded" .

pk:forgive-debtors a pk:Clause ;
    pk:name "forgive-debtors" ;
    pk:problemClass "resentment-loop" ;
    pk:boundary "human-only" ;
    pk:action ex:ForgiveDebtorsHook .

pk:temptation-guard a pk:Clause ;
    pk:name "temptation-guard" ;
    pk:problemClass "temptation-risk" ;
    pk:boundary "automatable-support" ;
    pk:action ex:TemptationGuardHook .

pk:deliverance a pk:Clause ;
    pk:name "deliverance" ;
    pk:problemClass "unbounded-threat" ;
    pk:boundary "god-receives-unbounded" ;
    pk:action ex:DeliveranceHook .

pk:doxology a pk:Clause ;
    pk:name "doxology" ;
    pk:problemClass "closure" ;
    pk:boundary "human-only" .

# ---------------------------------------------------------------------------
# Knowledge hooks — prayer clauses indexed to problem classes.
# ---------------------------------------------------------------------------

# Give us this day our daily bread: provision anxiety -> daily-bread action.
ex:DailyBreadHook a hook:Hook ;
    hook:name "daily-bread" ;
    hook:on "assert" ;
    hook:kind "delta" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#hasProvisionAnxiety" ;
    hook:effect "ground-action" ;
    hook:action ex:DailyPrayerWorkflow ;
    hook:priority 0 .

# As we forgive our debtors: resentment rehearsal loop detected by rule —
# a resentment linked to no release act is an open loop. The actual act of
# forgiveness is a human act; the hook only grounds the SUPPORT workflow.
ex:ForgiveDebtorsHook a hook:Hook ;
    hook:name "forgive-debtors" ;
    hook:kind "datalog" ;
    hook:program "released(?0) :- t(?1, <http://seanchatmangpt.github.io/praxis/life#releases>, ?0). openloop(?0) :- t(?0, <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>, <http://seanchatmangpt.github.io/praxis/life#ResentmentLoop>), !released(?0)." ;
    hook:goal "openloop" ;
    hook:effect "ground-action" ;
    hook:action ex:DailyPrayerWorkflow ;
    hook:priority 1 .

# Deliver us from evil: a problem that cannot be solved inside the day
# window is surrendered, never computed. No agent computes the unbounded —
# the effect is a REFUSAL with standing, which is the surrender receipt.
ex:DeliveranceHook a hook:Hook ;
    hook:name "deliverance" ;
    hook:kind "delta" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#hasUnboundedThreat" ;
    hook:effect "refuse" ;
    hook:reason "unbounded threat surrendered to God; no agent computes the unbounded" ;
    hook:priority 2 .

# Lead us not into temptation: guard when day-window load crosses the bound.
ex:TemptationGuardHook a hook:Hook ;
    hook:name "temptation-guard" ;
    hook:kind "threshold" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#scheduledToday" ;
    hook:op ">" ;
    hook:k 8 ;
    hook:effect "refuse" ;
    hook:reason "day window over the 8-bound; shed before adding" ;
    hook:priority 3 .

# Forgive us our debts: an open debt with no repair act linked to it is a
# standing obligation — the hook grounds the confess-and-repair support
# fragment. Repairing is a bounded human-side act the workflow can walk.
ex:DebtRepairHook a hook:Hook ;
    hook:name "debt-repair" ;
    hook:kind "datalog" ;
    hook:program "repaired(?0) :- t(?1, <http://seanchatmangpt.github.io/praxis/life#repairs>, ?0). opendebt(?0) :- t(?0, <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>, <http://seanchatmangpt.github.io/praxis/life#Debt>), !repaired(?0)." ;
    hook:goal "opendebt" ;
    hook:effect "ground-action" ;
    hook:action ex:ConfessAndRepairWorkflow ;
    hook:priority 4 .

# A day that closed without its receipt: the gap itself is a fact, and the
# repair is a one-step bounded fragment — write the missing receipt.
ex:ReceiptMissingHook a hook:Hook ;
    hook:name "receipt-missing" ;
    hook:kind "delta" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#hasMissingReceipt" ;
    hook:effect "ground-action" ;
    hook:action ex:RepairReceiptWorkflow ;
    hook:priority 5 .

# Too much scheduled INTO one delta: more than 4 same-day placements in a
# single admitted event is an overload burst — refuse, park for reschedule.
ex:DayWindowOverloadHook a hook:Hook ;
    hook:name "day-window-overload" ;
    hook:kind "count" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#scheduledToday" ;
    hook:op ">" ;
    hook:k 4 ;
    hook:effect "refuse" ;
    hook:reason "day window overloaded: refuse-or-reschedule" ;
    hook:priority 6 .

# A sponsor withdrawing a capability is not a problem the runner solves:
# reassignment is a human decision, so the firing refuses with standing.
ex:SponsorUnavailableHook a hook:Hook ;
    hook:name "sponsor-unavailable" ;
    hook:kind "delta" ;
    hook:var "http://seanchatmangpt.github.io/praxis/life#withdrawsCapability" ;
    hook:effect "refuse" ;
    hook:reason "sponsor capability withdrawn; reassignment parks for the human" ;
    hook:priority 7 .

# ---------------------------------------------------------------------------
# The daily prayer workflow fragment (human-side projection).
# ---------------------------------------------------------------------------

ex:DailyPrayerWorkflow a wf:Workflow ;
    wf:budget 4 ;
    wf:init ex:dayOpen ;
    wf:goal ex:receiptWritten ;
    wf:capability ex:orientToFather, ex:surrenderWill,
        ex:requestDailyBread, ex:writePrayerReceipt .

ex:dayOpen a wf:Atom ;
    wf:predicate "day-open" ;
    wf:arg0 "today" .

ex:fatherOriented a wf:Atom ;
    wf:predicate "father-oriented" ;
    wf:arg0 "person" .

ex:willSurrendered a wf:Atom ;
    wf:predicate "will-surrendered" ;
    wf:arg0 "person" .

ex:breadRequested a wf:Atom ;
    wf:predicate "daily-bread-requested" ;
    wf:arg0 "person" .

ex:receiptWritten a wf:Atom ;
    wf:predicate "prayer-receipted" ;
    wf:arg0 "person" .

ex:orientToFather a wf:Capability ;
    wf:name "orient-to-father" ;
    wf:params 0 ;
    wf:cost 2 ;
    wf:pre ex:dayOpen ;
    wf:add ex:fatherOriented .

ex:surrenderWill a wf:Capability ;
    wf:name "surrender-will" ;
    wf:params 0 ;
    wf:cost 3 ;
    wf:pre ex:fatherOriented ;
    wf:add ex:willSurrendered .

ex:requestDailyBread a wf:Capability ;
    wf:name "request-daily-bread" ;
    wf:params 0 ;
    wf:cost 5 ;
    wf:pre ex:willSurrendered ;
    wf:add ex:breadRequested .

ex:writePrayerReceipt a wf:Capability ;
    wf:name "write-prayer-receipt" ;
    wf:params 0 ;
    wf:cost 2 ;
    wf:pre ex:breadRequested ;
    wf:add ex:receiptWritten .

# ---------------------------------------------------------------------------
# The confess-and-repair workflow fragment (debt-repair support).
# Capabilities belong to a fragment only through the workflow's declared
# wf:capability membership edges — fragments never share capabilities
# implicitly.
# ---------------------------------------------------------------------------

ex:ConfessAndRepairWorkflow a wf:Workflow ;
    wf:budget 3 ;
    wf:init ex:debtSeen ;
    wf:goal ex:debtRepaired ;
    wf:capability ex:confessDebt, ex:releaseResentment, ex:repairDebt .

ex:debtSeen a wf:Atom ;
    wf:predicate "debt-seen" ;
    wf:arg0 "person" .

ex:debtConfessed a wf:Atom ;
    wf:predicate "debt-confessed" ;
    wf:arg0 "person" .

ex:resentmentReleased a wf:Atom ;
    wf:predicate "resentment-released" ;
    wf:arg0 "person" .

ex:debtRepaired a wf:Atom ;
    wf:predicate "debt-repaired" ;
    wf:arg0 "person" .

ex:confessDebt a wf:Capability ;
    wf:name "confess-debt" ;
    wf:params 0 ;
    wf:cost 2 ;
    wf:pre ex:debtSeen ;
    wf:add ex:debtConfessed .

ex:releaseResentment a wf:Capability ;
    wf:name "release-resentment" ;
    wf:params 0 ;
    wf:cost 3 ;
    wf:pre ex:debtConfessed ;
    wf:add ex:resentmentReleased .

ex:repairDebt a wf:Capability ;
    wf:name "repair-debt" ;
    wf:params 0 ;
    wf:cost 3 ;
    wf:pre ex:resentmentReleased ;
    wf:add ex:debtRepaired .

# ---------------------------------------------------------------------------
# The repair-receipt workflow fragment (receipt-missing support, one step).
# ---------------------------------------------------------------------------

ex:RepairReceiptWorkflow a wf:Workflow ;
    wf:budget 1 ;
    wf:init ex:receiptGapSeen ;
    wf:goal ex:receiptRestored ;
    wf:capability ex:restoreReceipt .

ex:receiptGapSeen a wf:Atom ;
    wf:predicate "receipt-gap-seen" ;
    wf:arg0 "person" .

ex:receiptRestored a wf:Atom ;
    wf:predicate "receipt-restored" ;
    wf:arg0 "person" .

ex:restoreReceipt a wf:Capability ;
    wf:name "restore-receipt" ;
    wf:params 0 ;
    wf:cost 1 ;
    wf:pre ex:receiptGapSeen ;
    wf:add ex:receiptRestored .
