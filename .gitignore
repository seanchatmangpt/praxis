.agents/
target/
playground/target/
template/target/
templates/*/target/
.DS_Store
*.backup
.claude/
**/*.rs.backup
**/*.orig
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.pem
*.key
.env
.env.*
*_SUMMARY.md
# Root-only, .md-only: matches macOS's case-insensitive git config (core.ignorecase=true)
# was previously bare `AGENT_*`, which silently ignored real nested files whose lowercase
# name happened to start with "agent_" (e.g. tests/.../schemas/agent_scenario.schema.json,
# tests/.../fixtures/agents/agent_*.json) -- those were untracked and invisible to git
# status for an unknown period. See docs/jira/v26.7.11/ADVERSARIAL_DOD.md.
/AGENT_*.md
checkpoints/
# Runtime artifacts: receipt ledgers and their validated archives written by
# `receipt issue` / `receipt validate` when run from the repo root.
/receipts/
/data/validated_receipts/

# Combinatorial-maximalism G0-G9 evidence is regenerated against an exact head.
# Canonical law, ontologies, templates, kernels, and tests remain tracked; runtime
# observations, grants, receipts, replay, and verifier reports do not.
/.ggen/cmd/
/.ggen/.cmd-stage-*/

# Runtime artifacts: ad-hoc session transcripts and cargo-cicd standing-refresh
# receipts (regenerated by `just standing` / cargo-cicd runs; never commit).
scratch_transcript_*.txt
.cargo-cicd/receipts/standing-refresh-*.json
# Operation Dogfood runtime session lifecycle logs + receipts (captured live by
# the dogfood-lifecycle-capture.sh PostToolUse hook; per-session, never commit).
.cargo-cicd/lifecycle/

# cargo-mutants scratch output (regenerated by `cargo mutants`; the kill matrix
# lives in tests/, not here).
mutants.out/
mutants.out.old/

# LaTeX build intermediates (docs/thesis). The .tex sources and compiled .pdf
# deliverables stay tracked; every latexmk byproduct is regenerated on build.
docs/thesis/*.aux
docs/thesis/*.fls
docs/thesis/*.fdb_latexmk
docs/thesis/*.log
docs/thesis/*.out
docs/thesis/*.toc
docs/thesis/*.synctex.gz
docs/thesis/*.bbl
docs/thesis/*.blg
docs/thesis/*.nav
docs/thesis/*.snm
docs/thesis/*.vrb

# Lake (Lean 4 build tool) caches and dependency checkouts, anywhere in the
# repo -- includes full git clones of dependencies (e.g. Mathlib4, several
# GiB) plus downloaded prebuilt .olean cache files. Regenerate with
# `lake update && lake exe cache get`; never commit.
**/.lake/
**/lake-manifest.json

# Vendored external crates and cloned repositories for auditing (cargo vendor)
/vendors/

# Erlang/OTP (apps/*): rebar3's build output. `_build/` (umbrella-root and
# per-app, e.g. apps/air_core/_build/) is fully regenerated by
# `rebar3 compile` / `rebar3 eunit` -- compiled .beam files, generated .app
# files, and rebar3's own rebar_compiler_erl DAG cache. *.beam covers
# compiled bytecode wherever it lands outside _build/ too (e.g. an app's
# own ebin/, or a stray root-level artifact) -- none of it belongs in
# version control; every eunit/compile run mutates it.
_build/
*.beam

# Erlang/OTP and rebar3 crash dumps (regenerated on the next crash; never
# useful to keep in history).
/erl_crash.dump
/rebar3.crashdump

# Root-level scratch scripts and one-off debug/rewrite/patch/fix tooling
# from interactive sessions -- not part of the build, never a durable
# artifact. Real tooling belongs under scripts/ or tools/.
/fix*.py
/patch*.py
/rewrite*.py
/refactor*.py
/remove_debug.py
/update_powl.py
/debug_*.py
/debug_*.sh
/debug_test
/debug_test.rs
/run_test_debug
/run_test_debug.rs
/scratch.rs
/test_*
/tmp_sparql2/
crates/praxis-graphlaw/run_test_debug.rs
crates/praxis-graphlaw/test_empty.rs
**/*.rs.bak

# Test run logs and scratch failure lists from local nextest/cargo runs.
/nextest.log
/nextest_log.txt
/nextest_oom.log
/nextest_output.log
/cng_tests.txt
/test_failures.txt
/test_list.txt
/tier_failures.txt

# Terraform local state/provider-cache (deploy/**/*.tf and *.tftest.hcl are
# ggen-generated tracked source, and .terraform.lock.hcl is the standard
# provider-version pin Terraform itself recommends committing; .terraform/
# is a local provider *binary* cache re-downloaded by `terraform init`, and
# *.tfstate* would hold live resource state -- neither belongs in version
# control).
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

