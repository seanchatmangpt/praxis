# Runtime artifacts: receipt ledgers and their validated archives written by
# `receipt issue` / `receipt validate` when run from the repo root.
/receipts/
/data/validated_receipts/

# cargo-mutants scratch output (regenerated by `cargo mutants`; the kill matrix
# lives in tests/, not here).
mutants.out/
mutants.out.old/

# LaTeX build intermediates (docs/thesis). The .tex sources and compiled .pdf
# deliverables stay tracked; every latexmk byproduct is regenerated on build.
docs/thesis/*.aux
docs/thesis/*.fls
docs/thesis/*.fdb_latexmk
docs/thesis/*.log
docs/thesis/*.out
docs/thesis/*.toc
docs/thesis/*.synctex.gz
docs/thesis/*.bbl
docs/thesis/*.blg
docs/thesis/*.nav
docs/thesis/*.snm
docs/thesis/*.vrb

# Lake (Lean 4 build tool) caches and dependency checkouts, anywhere in the
# repo -- includes full git clones of dependencies (e.g. Mathlib4, several
# GiB) plus downloaded prebuilt .olean cache files. Regenerate with
# `lake update && lake exe cache get`; never commit.
**/.lake/
**/lake-manifest.json
