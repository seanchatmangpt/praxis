---
to: "crates/ggen/src/verbs/law.rs"
force: true
sparql:
  results: |
    PREFIX praxis: <http://seanchatmangpt.github.io/praxis/schema#>
    PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?noun ?verb ?handler ?comment ?nounAbout (GROUP_CONCAT(?flag; separator=",") AS ?flags)
    WHERE {
      {
        SELECT ?cmd ?noun ?verb ?handler ?comment ?nounAbout ?flag
        WHERE {
          ?cmd a praxis:CliCommand ;
               praxis:inCrate ?c ;
               praxis:noun ?noun ;
               praxis:verb ?verb ;
               praxis:handler ?handler ;
               praxis:nounAbout ?nounAbout .
          ?c praxis:name "ggen" .
          OPTIONAL { ?cmd rdfs:comment ?comment }
          OPTIONAL { ?cmd praxis:flag ?flag }
          FILTER(?noun = "law")
        }
        ORDER BY ?flag
      }
    }
    GROUP BY ?noun ?verb ?handler ?comment ?nounAbout
    ORDER BY ?verb
---
//! {{ results.0.nounAbout }}
//
// GENERATED by `ggen sync` from `schema/praxis.ttl` (`praxis:CliCommand`
// instances). Do not edit by hand: routes are a pure projection of the
// ontology (mode = Overwrite); logic lives in `crate::verbs::handlers`.

use clap_noun_verb::Result;

{% for row in results -%}
{% set flags = row.flags | default(value="") | split(pat=",") -%}
{% set_global has_flags = false -%}
{% for f in flags %}{% if f %}{% set_global has_flags = true %}{% endif %}{% endfor -%}
/// {{ row.comment | default(value="Generated route.") }}
{% if has_flags -%}
///
/// # Arguments
{% for f in flags -%}{% if f %}{% set parts = f | split(pat="::") %}/// * `{{ parts.0 }}` - {{ parts.1 | default(value="") }}
{% endif %}{% endfor -%}
{% endif -%}
#[clap_noun_verb_macros::verb("{{ row.verb }}")]
fn {{ row.noun }}_{{ row.verb }}({% for f in flags %}{% if f %}{% set parts = f | split(pat="::") %}{{ parts.0 }}: bool{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}) -> Result<serde_json::Value> {
    crate::verbs::handlers::{{ row.handler }}({% for f in flags %}{% if f %}{% set parts = f | split(pat="::") %}{{ parts.0 }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %})
}
{% endfor -%}
