---
to: "crates/ggen/src/verbs/graph.rs"
force: true
sparql:
  results: |
    PREFIX praxis: <http://seanchatmangpt.github.io/praxis/schema#>
    PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?noun ?verb ?handler ?comment ?nounAbout (GROUP_CONCAT(?flag; separator=",") AS ?flags) (GROUP_CONCAT(?arg; separator="||") AS ?args)
    WHERE {
      {
        SELECT ?cmd ?noun ?verb ?handler ?comment ?nounAbout ?flag ?arg
        WHERE {
          ?cmd a praxis:CliCommand ;
               praxis:inCrate ?c ;
               praxis:noun ?noun ;
               praxis:verb ?verb ;
               praxis:handler ?handler ;
               praxis:nounAbout ?nounAbout .
          ?c praxis:name "ggen" .
          OPTIONAL { ?cmd rdfs:comment ?comment }
          OPTIONAL { ?cmd praxis:flag ?flag }
          OPTIONAL { ?cmd praxis:arg ?arg }
          FILTER(?noun = "graph")
        }
        ORDER BY ?flag ?arg
      }
    }
    GROUP BY ?noun ?verb ?handler ?comment ?nounAbout
    ORDER BY ?verb
---
//! {{ results.0.nounAbout }}
//
// GENERATED by `ggen sync` from `schema/praxis.ttl` (`praxis:CliCommand`
// instances). Do not edit by hand: routes are a pure projection of the
// ontology (mode = Overwrite); logic lives in `crate::verbs::handlers`.
//
// Flags (`praxis:flag`) render as boolean options; value-carrying args
// (`praxis:arg`, encoded "name:type::help") render after them, with type
// in {string, pathbuf, pathbufs}. `pathbufs` becomes a repeatable
// `--name` multi-value option (`#[arg(action = "append")]`,
// Vec<camino::Utf8PathBuf>, >=0 occurrences) — the only multi-value shape
// clap-noun-verb 26.7.4 transports (a bare positional is read as a single
// value). NOTE: a command carrying BOTH praxis:flag and praxis:arg would
// hit a flag×arg cross-product in this single-subquery SELECT; no graph
// command does today (validate has 0 flags), so it is left simple.

use clap_noun_verb::Result;

{% for row in results -%}
{% set flags = row.flags | default(value="") | split(pat=",") -%}
{% set args = row.args | default(value="") | split(pat="||") -%}
{% set_global has_flags = false -%}
{% for f in flags %}{% if f %}{% set_global has_flags = true %}{% endif %}{% endfor -%}
/// {{ row.comment | default(value="Generated route.") }}
{% if has_flags -%}
///
/// # Arguments
{% for f in flags -%}{% if f %}{% set parts = f | split(pat="::") %}/// * `{{ parts.0 }}` - {{ parts.1 | default(value="") }}
{% endif %}{% endfor -%}
{% endif -%}
#[clap_noun_verb_macros::verb("{{ row.verb }}")]
fn {{ row.noun }}_{{ row.verb }}({% for f in flags %}{% if f %}{% set parts = f | split(pat="::") %}{{ parts.0 }}: bool{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}{% for a in args %}{% if a %}{% if not loop.first or has_flags %}, {% endif %}{% set ah = a | split(pat="::") %}{% set at = ah.0 | split(pat=":") %}{% if at.1 == "pathbufs" %}#[arg(action = "append")] {{ at.0 }}: Vec<camino::Utf8PathBuf>{% elif at.1 == "pathbuf" %}{{ at.0 }}: camino::Utf8PathBuf{% elif at.1 == "string" %}{{ at.0 }}: String{% else %}{{ at.0 }}: bool{% endif %}{% endif %}{% endfor %}) -> Result<serde_json::Value> {
    crate::verbs::handlers::{{ row.handler }}({% for f in flags %}{% if f %}{% set parts = f | split(pat="::") %}{{ parts.0 }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}{% for a in args %}{% if a %}{% if not loop.first or has_flags %}, {% endif %}{% set ah = a | split(pat="::") %}{% set at = ah.0 | split(pat=":") %}{{ at.0 }}{% endif %}{% endfor %})
}
{% endfor -%}
