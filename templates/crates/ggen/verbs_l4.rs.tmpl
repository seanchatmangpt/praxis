---
to: "crates/praxis-lean/src/verbs/l4.rs"
force: true
sparql:
  results: |
    PREFIX praxis: <http://seanchatmangpt.github.io/praxis/schema#>
    PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?noun ?verb ?handler ?comment ?nounAbout (GROUP_CONCAT(?flag; separator="||") AS ?flags)
    WHERE {
      {
        SELECT ?cmd ?noun ?verb ?handler ?comment ?nounAbout ?flag
        WHERE {
          ?cmd a praxis:CliCommand ;
               praxis:inCrate ?c ;
               praxis:noun ?noun ;
               praxis:verb ?verb ;
               praxis:handler ?handler ;
               praxis:nounAbout ?nounAbout .
          ?c praxis:name "praxis-lean" .
          OPTIONAL { ?cmd rdfs:comment ?comment }
          OPTIONAL { ?cmd praxis:flag ?flag }
          FILTER(?noun = "l4")
        }
        ORDER BY ?flag
      }
    }
    GROUP BY ?noun ?verb ?handler ?comment ?nounAbout
    ORDER BY ?verb
---
//! {{ results.0.nounAbout }}
//
// GENERATED by `ggen sync` from `schema/praxis.ttl` (`praxis:CliCommand`
// instances, `praxis:inCrate praxis:CrateLean`). Do not edit by hand:
// routes are a pure projection of the ontology; logic lives in
// `crate::cli`'s free functions.
//
// Unlike `crates/ggen`'s own `verbs_sync.rs.tmpl` (bool-only flags), this
// template supports typed flags: each `praxis:flag` value is encoded as
// "name:type::help text", type in {bool, string, pathbuf}, mapped below
// to `bool` / `String` / `camino::Utf8PathBuf` function parameters.

use clap_noun_verb::Result;

{% for row in results -%}
{% set flags = row.flags | default(value="") | split(pat="||") -%}
{% set_global has_flags = false -%}
{% for f in flags %}{% if f %}{% set_global has_flags = true %}{% endif %}{% endfor -%}
/// {{ row.comment | default(value="Generated route.") }}
{% if has_flags -%}
///
/// # Arguments
{% for f in flags -%}{% if f %}{% set head_help = f | split(pat="::") %}{% set name_type = head_help.0 | split(pat=":") %}/// * `{{ name_type.0 }}` - {{ head_help.1 | default(value="") }}
{% endif %}{% endfor -%}
{% endif -%}
#[clap_noun_verb_macros::verb("{{ row.verb }}")]
fn l4_{{ row.verb | replace(from="-", to="_") }}({% for f in flags %}{% if f %}{% set head_help = f | split(pat="::") %}{% set name_type = head_help.0 | split(pat=":") %}{{ name_type.0 }}: {% if name_type.1 == "pathbuf" %}camino::Utf8PathBuf{% elif name_type.1 == "string" %}String{% else %}bool{% endif %}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}) -> Result<serde_json::Value> {
    crate::cli::{{ row.handler }}({% for f in flags %}{% if f %}{% set head_help = f | split(pat="::") %}{% set name_type = head_help.0 | split(pat=":") %}{% if name_type.1 == "pathbuf" %}&{{ name_type.0 }}{% else %}{{ name_type.0 }}{% endif %}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %})
        .map_err(|e| ::clap_noun_verb::NounVerbError::Generic(e.to_string()))
}
{% endfor -%}
