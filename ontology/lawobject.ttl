# PDDL8-safe RDF instance ontology for the CPhy LawObject lifecycle.
#
# This is a *flattening* of docs/PDDL_CAPABILITY_MODEL.md and
# docs/lawobject-capability.pddl down to the STRIPS8 subset that
# `bcinr_pddl::ground::GroundProblem::find_plan` can actually solve:
#
#   - Positive conjunctive preconditions only (no forall/implies/not-in-pre).
#   - Arity <= 8, precondition/effect conjuncts <= 8, action params <= 8.
#   - Obligation-clearing is pre-compiled into flat positive predicates
#     (`obligations-met`) produced by `supply-evidence` + `clear-obligations`,
#     replacing the ADL exemplar's `forall`/`implies` obligation check.
#
# The ADL file (docs/lawobject-capability.pddl) is still the canonical
# *documentation* of the full obligation algebra; it parses via
# `bcinr_pddl::domain_from_pddl` but will NOT ground/solve because `forall`
# and `implies` are not part of STRIPS8. This file is the sibling that DOES
# solve, produced by `praxis::mfg::manufacture` (src/mfg.rs).
#
# CONTRACT (relied on by tests/mfg_golden.rs and, per the CPhy plan, by the
# `plan lawobject` self-test in a later lane): the golden plan manufactured
# from this file is exactly, in order:
#
#   supply-evidence -> clear-obligations -> judge -> admit -> receipt
#
# Do not rename the action/predicate/object identifiers below, or the
# object/problem name `obligation-validation-case-001`, without updating
# every consumer of this contract.

@prefix pddl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------

pddl:domain_lawobject
    a pddl:Domain ;
    pddl:name "lawobject-capability-pddl8" .

# ---------------------------------------------------------------------------
# Types (flat mirror of docs/PDDL_CAPABILITY_MODEL.md's type table; andon-state
# is declared for documentation parity even though the STRIPS8 flattening
# below represents "Andon green" as a plain predicate rather than an enum).
# ---------------------------------------------------------------------------

pddl:type_lawobject    a pddl:Type ; pddl:name "law-object" .
pddl:type_obligation   a pddl:Type ; pddl:name "obligation" .
pddl:type_evidencetype a pddl:Type ; pddl:name "evidence-type" .
pddl:type_stage        a pddl:Type ; pddl:name "lifecycle-stage" .
pddl:type_andonstate   a pddl:Type ; pddl:name "andon-state" .
pddl:type_validator    a pddl:Type ; pddl:name "validator" .
pddl:type_authority    a pddl:Type ; pddl:name "authority" .
pddl:type_chaintoken   a pddl:Type ; pddl:name "chain-token" .

# ---------------------------------------------------------------------------
# Predicates (all positive-checkable; STRIPS8-safe)
# ---------------------------------------------------------------------------

pddl:pred_in_stage
    a pddl:Predicate ;
    pddl:name "in-stage" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?stage" ; pddl:ofType "lifecycle-stage" ] .

pddl:pred_has_obligation
    a pddl:Predicate ;
    pddl:name "has-obligation" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?ob" ; pddl:ofType "obligation" ] .

pddl:pred_requires_evidence
    a pddl:Predicate ;
    pddl:name "requires-evidence" ;
    pddl:param [ pddl:index 0 ; pddl:var "?ob" ; pddl:ofType "obligation" ] ,
              [ pddl:index 1 ; pddl:var "?etype" ; pddl:ofType "evidence-type" ] .

pddl:pred_evidence_satisfied
    a pddl:Predicate ;
    pddl:name "evidence-satisfied" ;
    pddl:param [ pddl:index 0 ; pddl:var "?ob" ; pddl:ofType "obligation" ] .

pddl:pred_obligations_met
    a pddl:Predicate ;
    pddl:name "obligations-met" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] .

pddl:pred_andon_green
    a pddl:Predicate ;
    pddl:name "andon-green" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] .

pddl:pred_validated_by
    a pddl:Predicate ;
    pddl:name "validated-by" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?validator" ; pddl:ofType "validator" ] .

pddl:pred_admitted_by
    a pddl:Predicate ;
    pddl:name "admitted-by" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?authority" ; pddl:ofType "authority" ] .

pddl:pred_prev_chain_valid
    a pddl:Predicate ;
    pddl:name "prev-chain-valid" ;
    pddl:param [ pddl:index 0 ; pddl:var "?tok" ; pddl:ofType "chain-token" ] .

pddl:pred_chain_hash_computed
    a pddl:Predicate ;
    pddl:name "chain-hash-computed" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?tok" ; pddl:ofType "chain-token" ] .

pddl:pred_signature_applied
    a pddl:Predicate ;
    pddl:name "signature-applied" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] .

# ---------------------------------------------------------------------------
# Actions (STRIPS8 flattening of the five-step golden lifecycle plan)
# ---------------------------------------------------------------------------

# 1. supply-evidence(?obj, ?ob, ?etype)
#    Satisfies the EvidenceRequired obligation ?ob for law-object ?obj.
pddl:action_supply_evidence
    a pddl:Action ;
    pddl:name "supply-evidence" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?ob" ; pddl:ofType "obligation" ] ,
              [ pddl:index 2 ; pddl:var "?etype" ; pddl:ofType "evidence-type" ] ;
    pddl:pre "(has-obligation ?obj ?ob)" ,
            "(requires-evidence ?ob ?etype)" ;
    pddl:add "(evidence-satisfied ?ob)" .

# 2. clear-obligations(?obj, ?ob)
#    Once evidence is satisfied, retires the obligation and marks the
#    law-object as fully obligations-met (the flat replacement for the ADL
#    domain's `forall obligation. implies(...)` universal check).
pddl:action_clear_obligations
    a pddl:Action ;
    pddl:name "clear-obligations" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?ob" ; pddl:ofType "obligation" ] ;
    pddl:pre "(has-obligation ?obj ?ob)" ,
            "(evidence-satisfied ?ob)" ;
    pddl:add "(obligations-met ?obj)" ;
    pddl:del "(has-obligation ?obj ?ob)" .

# 3. judge(?obj, ?validator): Raw -> Validated
pddl:action_judge
    a pddl:Action ;
    pddl:name "judge" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?validator" ; pddl:ofType "validator" ] ;
    pddl:pre "(in-stage ?obj raw)" ,
            "(obligations-met ?obj)" ;
    pddl:add "(in-stage ?obj validated)" ,
            "(validated-by ?obj ?validator)" ,
            "(andon-green ?obj)" ;
    pddl:del "(in-stage ?obj raw)" .

# 4. admit(?obj, ?authority): Validated -> Admitted
pddl:action_admit
    a pddl:Action ;
    pddl:name "admit" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?authority" ; pddl:ofType "authority" ] ;
    pddl:pre "(in-stage ?obj validated)" ,
            "(andon-green ?obj)" ;
    pddl:add "(in-stage ?obj admitted)" ,
            "(admitted-by ?obj ?authority)" ;
    pddl:del "(in-stage ?obj validated)" .

# 5. receipt(?obj, ?tok): Admitted -> Receipted
pddl:action_receipt
    a pddl:Action ;
    pddl:name "receipt" ;
    pddl:param [ pddl:index 0 ; pddl:var "?obj" ; pddl:ofType "law-object" ] ,
              [ pddl:index 1 ; pddl:var "?tok" ; pddl:ofType "chain-token" ] ;
    pddl:pre "(in-stage ?obj admitted)" ,
            "(prev-chain-valid ?tok)" ;
    pddl:add "(in-stage ?obj receipted)" ,
            "(chain-hash-computed ?obj ?tok)" ,
            "(signature-applied ?obj)" ;
    pddl:del "(in-stage ?obj admitted)" .

# ---------------------------------------------------------------------------
# Problem instance: obligation-validation-case-001
# ---------------------------------------------------------------------------
#
# Expected plan (pinned by tests/mfg_golden.rs):
#   supply-evidence(obj-001,ob-001,etype-identity)
#   clear-obligations(obj-001,ob-001)
#   judge(obj-001,judge-001)
#   admit(obj-001,authority-001)
#   receipt(obj-001,tok-genesis)

pddl:problem_obligation_validation_case_001
    a pddl:Problem ;
    pddl:name "obligation-validation-case-001" ;
    pddl:domain "lawobject-capability-pddl8" ;
    pddl:object [ pddl:name "obj-001" ; pddl:ofType "law-object" ] ,
               [ pddl:name "ob-001" ; pddl:ofType "obligation" ] ,
               [ pddl:name "etype-identity" ; pddl:ofType "evidence-type" ] ,
               [ pddl:name "judge-001" ; pddl:ofType "validator" ] ,
               [ pddl:name "authority-001" ; pddl:ofType "authority" ] ,
               [ pddl:name "tok-genesis" ; pddl:ofType "chain-token" ] ,
               [ pddl:name "raw" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "validated" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "admitted" ; pddl:ofType "lifecycle-stage" ] ,
               [ pddl:name "receipted" ; pddl:ofType "lifecycle-stage" ] ;
    pddl:init "(in-stage obj-001 raw)" ,
             "(has-obligation obj-001 ob-001)" ,
             "(requires-evidence ob-001 etype-identity)" ,
             "(prev-chain-valid tok-genesis)" ;
    pddl:goal "(in-stage obj-001 receipted)" .
