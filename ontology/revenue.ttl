# =============================================================================
# revenue.ttl — PR-15 revenue-operations domain pack (ontology half)
# =============================================================================
#
# Describes the revenue-operations planning domain implemented in Rust at
# crates/praxis-proposer (PR-14). This file is data: types, stage individuals,
# predicates, numeric fluents, evidence gates, actions, and the objective
# fluent vocabulary. Per PR-8, an ontology like this deterministically
# projects to PDDL domain/problem text; the intended projections are noted
# on each term in `pddl:pddlProjection` comments.
#
# Vocabulary note: ontology/lawobject.ttl did not exist when this file was
# authored, so the `pddl:` planning-description vocabulary below is defined
# standalone (self-contained in this file). If/when lawobject.ttl lands with
# its own pddl: vocabulary, integration reconciles prefixes; the revenue terms
# (rev:) are namespaced separately so they survive that merge untouched.
#
# Boundary note (AR-9 / Non-goal 1): nothing in this file confers authority.
# Weights for the objective fluents are NOT stated here — they live in the
# domain-authored revenue_objective.json. This file only names the fluents
# the algebra understands.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pddl:  <http://seanchatmangpt.github.io/praxis/pddl#> .
@prefix rev:  <http://seanchatmangpt.github.io/praxis/revenue#> .

# =============================================================================
# 0. The pddl: planning-description vocabulary (standalone definition)
# =============================================================================

pddl:Type a rdfs:Class ;
    rdfs:label "Type" ;
    rdfs:comment "A PDDL object type. Projects to an entry in (:types ...)." .

pddl:Predicate a rdfs:Class ;
    rdfs:label "Predicate" ;
    rdfs:comment "A boolean state predicate. Projects to an entry in (:predicates ...)." .

pddl:Fluent a rdfs:Class ;
    rdfs:label "Fluent" ;
    rdfs:comment "A numeric state function. Projects to an entry in (:functions ...) under :numeric-fluents." .

pddl:Action a rdfs:Class ;
    rdfs:label "Action" ;
    rdfs:comment "A planning operator. Projects to a (:action ...) schema." .

pddl:Individual a rdfs:Class ;
    rdfs:label "Individual" ;
    rdfs:comment "A named constant of some pddl:Type. Projects to (:constants ...) or problem (:objects ...)." .

pddl:parameter a rdf:Property ;
    rdfs:label "parameter" ;
    rdfs:comment "Ordered parameter of a predicate, fluent, or action; range is a pddl:Type." .

pddl:precondition a rdf:Property ;
    rdfs:label "precondition" ;
    rdfs:comment "Precondition formula of an action, as PDDL text (law-bound text is emitted, not templated — AR-6)." ;
    rdfs:range xsd:string .

pddl:effect a rdf:Property ;
    rdfs:label "effect" ;
    rdfs:comment "Effect formula of an action, as PDDL text." ;
    rdfs:range xsd:string .

pddl:pddlName a rdf:Property ;
    rdfs:label "pddlName" ;
    rdfs:comment "Exact lower-kebab token emitted into PDDL text for this term. Byte-stable: hashed into proposal hashes." ;
    rdfs:range xsd:string .

pddl:order a rdf:Property ;
    rdfs:label "order" ;
    rdfs:comment "Position of an individual within an ordered type (e.g. pipeline stage index)." ;
    rdfs:range xsd:integer .

# =============================================================================
# 1. Types
# =============================================================================

rev:Account a pddl:Type ;
    rdfs:label "Account" ;
    pddl:pddlName "account" ;
    rdfs:comment "A revenue account (deal) moving through the pipeline. Rust: praxis_proposer::domain::Account." .

rev:RevenueStage a pddl:Type ;
    rdfs:label "RevenueStage" ;
    pddl:pddlName "revenue-stage" ;
    rdfs:comment "Ordered pipeline stage enum. Rust: praxis_proposer::domain::Stage." .

# =============================================================================
# 2. Stage individuals (ordered)
# =============================================================================

rev:lead a pddl:Individual ;
    rdf:type rev:RevenueStage ;
    pddl:pddlName "lead" ;
    pddl:order 0 .

rev:qualified a pddl:Individual ;
    rdf:type rev:RevenueStage ;
    pddl:pddlName "qualified" ;
    pddl:order 1 .

rev:proposal a pddl:Individual ;
    rdf:type rev:RevenueStage ;
    pddl:pddlName "proposal" ;
    pddl:order 2 .

rev:procurement a pddl:Individual ;
    rdf:type rev:RevenueStage ;
    pddl:pddlName "procurement" ;
    pddl:order 3 .

rev:closedWon a pddl:Individual ;
    rdf:type rev:RevenueStage ;
    pddl:pddlName "closed-won" ;
    pddl:order 4 .

# =============================================================================
# 3. Predicates
# =============================================================================

rev:stage a pddl:Predicate ;
    rdfs:label "stage" ;
    pddl:pddlName "stage" ;
    pddl:parameter rev:Account, rev:RevenueStage ;
    rdfs:comment "Account is currently in stage. PDDL: (stage ?a - account ?s - revenue-stage). Proposal::pddl_goal() emits goal atoms of exactly this shape, e.g. (stage acct-7 procurement)." .

rev:securityReviewDone a pddl:Predicate ;
    rdfs:label "securityReviewDone" ;
    pddl:pddlName "security-review-done" ;
    pddl:parameter rev:Account ;
    rdfs:comment "Evidence flag: security review completed. Rust field: security_review_done." .

rev:legalApproved a pddl:Predicate ;
    rdfs:label "legalApproved" ;
    pddl:pddlName "legal-approved" ;
    pddl:parameter rev:Account ;
    rdfs:comment "Evidence flag: legal approved. Gates any move past proposal. Rust field: legal_approved." .

rev:execSponsor a pddl:Predicate ;
    rdfs:label "execSponsor" ;
    pddl:pddlName "exec-sponsor" ;
    pddl:parameter rev:Account ;
    rdfs:comment "Evidence flag: executive sponsor attached. Gates closed-won. Rust field: exec_sponsor." .

# =============================================================================
# 4. Numeric fluents (state)
# =============================================================================

rev:amountCents a pddl:Fluent ;
    rdfs:label "amountCents" ;
    pddl:pddlName "amount-cents" ;
    pddl:parameter rev:Account ;
    rdfs:comment "Deal size in integer cents (integers for determinism). Rust field: amount_cents (i64)." .

rev:daysInStage a pddl:Fluent ;
    rdfs:label "daysInStage" ;
    pddl:pddlName "days-in-stage" ;
    pddl:parameter rev:Account ;
    rdfs:comment "Days the account has sat in its current stage. Rust field: days_in_stage (u32)." .

# =============================================================================
# 5. Actions (evidence gates mirror domain::evidence_permits)
# =============================================================================
#
# One advance action per gated tier. Preconditions restate — as data — the
# same rules the proposer pre-filters with and the admission boundary will
# enforce: the proposer proposing lawfully does not exempt the proposal from
# admission (AR-9).

rev:advanceEarly a pddl:Action ;
    rdfs:label "advanceEarly" ;
    pddl:pddlName "advance-early" ;
    pddl:parameter rev:Account, rev:RevenueStage, rev:RevenueStage ;
    pddl:precondition "(and (stage ?a ?from) (stage-succ ?from ?to) (stage-at-most ?to proposal))" ;
    pddl:effect "(and (not (stage ?a ?from)) (stage ?a ?to))" ;
    rdfs:comment "Advance within the ungated early pipeline (lead/qualified/proposal): no evidence required." .

rev:advanceToProcurement a pddl:Action ;
    rdfs:label "advanceToProcurement" ;
    pddl:pddlName "advance-to-procurement" ;
    pddl:parameter rev:Account ;
    pddl:precondition "(and (stage ?a proposal) (legal-approved ?a) (security-review-done ?a))" ;
    pddl:effect "(and (not (stage ?a proposal)) (stage ?a procurement))" ;
    rdfs:comment "Procurement requires legal-approved AND security-review-done. An account missing legal-approved cannot move past proposal." .

rev:closeWon a pddl:Action ;
    rdfs:label "closeWon" ;
    pddl:pddlName "close-won" ;
    pddl:parameter rev:Account ;
    pddl:precondition "(and (stage ?a procurement) (legal-approved ?a) (security-review-done ?a) (exec-sponsor ?a))" ;
    pddl:effect "(and (not (stage ?a procurement)) (stage ?a closed-won))" ;
    rdfs:comment "Closing requires all three evidence flags: legal-approved, security-review-done, exec-sponsor." .

# =============================================================================
# 6. Objective fluent vocabulary (names only — weights are authored elsewhere)
# =============================================================================
#
# These are the candidate-scoring fluents praxis-proposer computes
# (objective::compute_fluents). Their WEIGHTS are deliberately absent from
# this ontology: the objective function is domain-authored data
# (revenue_objective.json). The system never invents values (Non-goal 1).

rev:realizedRevenue a pddl:Fluent ;
    rdfs:label "realizedRevenue" ;
    pddl:pddlName "realized-revenue" ;
    rdfs:comment "Scoring fluent: amount-cents if the candidate target is closed-won, else 0." .

rev:pipelineValueAtRisk a pddl:Fluent ;
    rdfs:label "pipelineValueAtRisk" ;
    pddl:pddlName "pipeline-value-at-risk" ;
    rdfs:comment "Scoring fluent: amount-cents if the candidate target is still open (below closed-won), else 0." .

rev:timePenalty a pddl:Fluent ;
    rdfs:label "timePenalty" ;
    pddl:pddlName "time-penalty" ;
    rdfs:comment "Scoring fluent: days-in-stage of the account being moved (staleness)." .

rev:stageAdvance a pddl:Fluent ;
    rdfs:label "stageAdvance" ;
    pddl:pddlName "stage-advance" ;
    rdfs:comment "Scoring fluent: number of stages the candidate move jumps forward." .
