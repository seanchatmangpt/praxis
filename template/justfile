# Canonical task runner for the seanchatmangpt Rust house style.
# `just` is the house standard. Run `just` with no args to list recipes.

set shell := ["bash", "-uc"]

# List recipes.
default:
    @just --list

# ── Formatting ────────────────────────────────────────────────────────────────

# Format all code.
fmt:
    cargo fmt --all

# Check formatting (CI-equivalent).
fmt-check:
    cargo fmt --all --check

# ── Linting ───────────────────────────────────────────────────────────────────

# Clippy with warnings denied.
lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

# ── Type / Syntax Check ───────────────────────────────────────────────────────

# Fast syntax + type check without codegen.
check:
    cargo check --workspace --all-features

# ── Tests ─────────────────────────────────────────────────────────────────────

# Run the full test suite.
test:
    cargo test --workspace --all-features

# Run only library unit tests.
test-lib:
    cargo test --workspace --all-features --lib

# Run only integration tests (tests/ directory).
test-e2e:
    cargo test --workspace --all-features --test '*'

# Run tests single-threaded (for determinism / receipt checks).
test-serial:
    cargo test --workspace --all-features -- --test-threads=1

# Run tests matching a pattern. Usage: just test-one <pattern>
test-one pattern:
    cargo test --workspace --all-features -- '{{pattern}}'

# ── Build ─────────────────────────────────────────────────────────────────────

# Build (debug).
build:
    cargo build --workspace

# Build optimized release.
build-release:
    cargo build --workspace --release

# ── Documentation ─────────────────────────────────────────────────────────────

# Build docs the way CI does.
doc:
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features

# Build and open docs in the browser.
doc-open:
    cargo doc --workspace --no-deps --all-features --open

# ── Coverage ──────────────────────────────────────────────────────────────────

# Generate HTML coverage report and open it (needs cargo-llvm-cov).
coverage:
    cargo llvm-cov --workspace --all-features --html --open

# Generate LCOV coverage report for CI upload.
coverage-ci:
    cargo llvm-cov --workspace --all-features --lcov --output-path lcov.info

# ── Benchmarks ────────────────────────────────────────────────────────────────

# Run all Criterion benchmarks.
bench:
    cargo bench --workspace

# Run a single named Criterion benchmark. Usage: just bench-one <name>
bench-one name:
    cargo bench --workspace -- '{{name}}'

# ── Watch ─────────────────────────────────────────────────────────────────────

# Re-run tests on every file change (needs cargo-watch).
watch:
    cargo watch -x "test --workspace --all-features"

# Re-run check on every file change (needs cargo-watch).
watch-check:
    cargo watch -x "check --workspace --all-features"

# ── Supply-chain & Security ───────────────────────────────────────────────────

# Supply-chain + license checks (needs `cargo install cargo-deny`).
deny:
    cargo deny check

# Audit dependencies for known vulnerabilities (needs `cargo install cargo-audit`).
audit:
    cargo audit

# Spell-check (needs `cargo install typos-cli`).
typos:
    typos

# ── Dependencies ──────────────────────────────────────────────────────────────

# Print full dependency tree.
deps:
    cargo tree --workspace

# Print duplicate dependencies.
deps-dupes:
    cargo tree --workspace -d

# Update Cargo.lock to latest compatible versions.
update:
    cargo update

# ── Hollow Gate ───────────────────────────────────────────────────────────────

# Block unimplemented!/todo!/placeholder stubs (mirrors bcinr contract-gate pattern).
# tools/hollow-gate/main.rs scans src/ and exits non-zero if any stubs are found.
hollow-gate:
    cargo run --manifest-path tools/hollow-gate/Cargo.toml --quiet

# ── CI Integrity Tooling ──────────────────────────────────────────────────────

# Verify that cicd.toml required_jobs are all present in .github/workflows/ci.yml.
ci-shape-check:
    python3 scripts/ci-shape-check.py

# Scan for human-only patterns (from anti-llm.toml) in recent AI-authored commits.
# Warns but does not fail by default — use ANTI_LLM_ENFORCE=1 for hard failure.
anti-llm-check:
    bash scripts/anti-llm-check.sh {{ if env_var_or_default("ANTI_LLM_ENFORCE", "0") == "1" { "" } else { "--warn-only" } }}

# Comprehensive health-check dashboard: ci-shape, anti-llm, deny, typos.
doctor:
    @echo ""
    @echo "════════════════════════════════════"
    @echo " praxis doctor — health check"
    @echo "════════════════════════════════════"
    @echo ""
    @echo "── 1/4  CI shape check ─────────────"
    -python3 scripts/ci-shape-check.py
    @echo "── 2/4  Anti-LLM integrity ─────────"
    -bash scripts/anti-llm-check.sh --warn-only
    @echo "── 3/4  Supply-chain (cargo deny) ──"
    -cargo deny check
    @echo "── 4/4  Spell-check (typos) ────────"
    -typos
    @echo ""
    @echo "════════════════════════════════════"
    @echo " doctor complete — review any [FAIL] lines above"
    @echo "════════════════════════════════════"
    @echo ""

# ── Pre-commit & CI ───────────────────────────────────────────────────────────

# Quick local gate: fmt-check + lint + unit tests.
pre-commit: fmt-check lint test-lib
    @echo "Pre-commit checks passed."

# Definition of Done: fmt-check + clippy + test + artifact presence.
# Exit 0=all pass, 1=soft (tests ok, receipts missing/stale), 2=hard (broken).
dod:
    cargo run --bin dod

# Pre-merge gate: run DOD then full CI.
pre-merge: dod ci
    @echo "Pre-merge checks passed."

# Everything CI runs, in order.
ci: fmt-check lint hollow-gate test doc deny typos
    @echo "All CI checks passed."

# ── Command Chaining (++ protocol) ───────────────────────────────────────────
#
# The ++ chaining protocol splits argv on the literal "++" token and runs each
# step sequentially, aborting on the first non-zero exit.
#
# Steps are whitespace-trimmed segments between "++" separators.  Each segment
# is passed verbatim to `cargo run --` so it receives the full CLI surface
# (including --introspect, --format, etc.).
#
# Usage examples:
#   just chain "emit --type build ++ assemble ++ verify receipt.json"
#   just chain "status show ++ receipt verify path/to/receipt.json"
#
# Mirrors the clap-noun-verb ++ convention so tool-callers can compose
# multi-step workflows in a single invocation.
chain *CMDS:
    @echo '{{CMDS}}' | awk 'BEGIN{RS="\\+\\+"} {gsub(/^[ \t\n]+|[ \t\n]+$/, "", $0); if ($0 != "") print $0}' | \
        while IFS= read -r step; do \
            echo "[chain] cargo run -- $step"; \
            cargo run -- $step || exit 1; \
        done

# ── Housekeeping ──────────────────────────────────────────────────────────────

# Remove build artifacts.
clean:
    cargo clean

# ── Living Documentation ──────────────────────────────────────────────────────

# Regenerate living test documentation from tests.
docs-test:
    UPDATE_GOLDEN=1 cargo test --features living-docs -- --test-threads=1
    @echo "docs/test/ updated — commit the changes."

# Verify living docs match committed artifacts (CI equivalent).
docs-verify:
    cargo test --features living-docs -- --test-threads=1

# ── Changelog ─────────────────────────────────────────────────────────────────

# Generate CHANGELOG.md from conventional commits (needs git-cliff).
changelog:
    git cliff --output CHANGELOG.md
    @echo "CHANGELOG.md updated — review and commit."

# Preview unreleased changelog entries.
changelog-preview:
    git cliff --unreleased

# ── Miri ─────────────────────────────────────────────────────────────────────

# Run Miri UB-check (needs nightly + miri component).
miri:
    cargo +nightly miri test --workspace

# ── Git-as-Runtime ────────────────────────────────────────────────────────────

# Run tests and, on success, append a receipt JSON to git notes (praxis/audit).
# Uses `git notes --ref=praxis/audit append` for an immutable NDJSON audit trail.
# Requires git and a valid HEAD commit in the current repository.
receipt-commit:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo test --workspace --all-features
    HEAD_SHA=$(git rev-parse HEAD)
    TIMESTAMP=$(date -u +%s)
    RECEIPT=$(printf '{"timestamp":%s,"event_type":"test.completed","head":"%s","passed":true}' \
        "$TIMESTAMP" "$HEAD_SHA")
    git notes --ref=praxis/audit append --allow-empty -m "$RECEIPT" HEAD
    echo "Receipt appended to git notes (refs/notes/praxis/audit) on $HEAD_SHA"
