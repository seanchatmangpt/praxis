praxis:ExternalSideEffectSeparationRef a praxis:EvidenceRef ;
  skos:definition "docs/standing/EXTERNAL_OPERATOR_SIDE_EFFECTS.md defines a typed EXTERNAL_OPERATOR_SIDE_EFFECT status + external_operator_side_effects artifact field, distinct from any blocking status, used by cargo-cicd's own standing.json schema (e.g. target/praxis-standing/benchmark-summary.json's per-artifact external_operator_side_effects field); every Lane 1-5 report's own 'Remaining external side effects' section is kept structurally separate from its 'Failures found'/blocker section, consistent with this typed model." ;
  praxis:path "docs/standing/EXTERNAL_OPERATOR_SIDE_EFFECTS.md" ;
