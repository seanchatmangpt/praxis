# autonomic-standing-factory case study — PDDL8 repair domain (Lane 3).
#
# A `pddl:` ontology (PDDL8-safe: <=8 params/pre-conjuncts/effect-conjuncts/
# arity per action schema, mirroring examples/v26_7_6_after_neon/goal.ttl's
# exact vocabulary shape) modelling the case study's own evidence pipeline:
# standing emission -> GraphLaw judgment (SHACL/ShEx/N3/Datalog) -> PDDL/POWL
# process modelling -> client smoke + receipt verification + benchmarks ->
# OCEL capture -> wasm4pm conformance -> lawful claim repair -> final verdict.
#
# Honest init state (2026-07-06): `target/praxis-standing/standing.json` and
# `docs/releases/v26.7.6/ocel/*.json` already exist (Lane 1/earlier passes),
# so `(has-evidence repo-praxis)` is true from the start. This case study's
# OWN GraphLaw judgment, PDDL plan, POWL model, OCEL log, and wasm4pm
# validation do not exist yet — those are exactly what this plan produces.
#
# Non-trivial repair scenario (not a 1-step trivial goal-satisfaction): the
# scope's top-level claim was PREVIOUSLY marked promoted
# (`claim-promoted`) by an earlier, evidence-less pass — an unlawful
# promotion. Reaching the goal requires the planner to demote that claim
# (`demote-claim`) and re-promote it lawfully (`promote-claim`) only after
# GraphLaw closure and wasm4pm process validation both hold, and only after
# the fleet's real external side effects (already-open cargo-cicd receipt
# writes) are classified as non-blocking rather than silently ignored.
#
# Expected plan (16 actions, one ground instance each — pinned by this
# lane's report, not asserted in code):
#   emit-standing -> validate-shacl -> validate-shex -> materialize-n3 ->
#   compute-datalog-closure -> solve-pddl-plan -> compile-powl-model ->
#   smoke-client -> verify-receipts -> attach-benchmarks -> record-ocel ->
#   validate-wasm4pm-process -> demote-claim -> classify-external-side-effect
#   -> promote-claim -> render-final-verdict
#
# Consumed by `praxis plan run --goal
# docs/case-studies/autonomic-standing-factory/case-study/pddl/goal.ttl`.

@prefix pddl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ── Domain ────────────────────────────────────────────────────────────────

pddl:domain_autonomic_standing_factory
    a pddl:Domain ;
    pddl:name "autonomic-standing-factory-pddl8" .

# ── Types ─────────────────────────────────────────────────────────────────

pddl:type_repo                a pddl:Type ; pddl:name "repo" .
pddl:type_evidence_artifact    a pddl:Type ; pddl:name "evidence-artifact" .
pddl:type_standing_envelope    a pddl:Type ; pddl:name "standing-envelope" .
pddl:type_ocel_log             a pddl:Type ; pddl:name "ocel-log" .
pddl:type_process_validation   a pddl:Type ; pddl:name "process-validation" .
pddl:type_graphlaw_judgment    a pddl:Type ; pddl:name "graphlaw-judgment" .
pddl:type_client_surface       a pddl:Type ; pddl:name "client-surface" .
pddl:type_benchmark_report     a pddl:Type ; pddl:name "benchmark-report" .
pddl:type_receipt_chain        a pddl:Type ; pddl:name "receipt-chain" .
pddl:type_external_side_effect a pddl:Type ; pddl:name "external-side-effect" .
pddl:type_claim                a pddl:Type ; pddl:name "claim" .

# ── Predicates ────────────────────────────────────────────────────────────

pddl:pred_has_evidence
    a pddl:Predicate ;
    pddl:name "has-evidence" ;
    pddl:param [ pddl:index 0 ; pddl:var "?repo" ; pddl:ofType "repo" ] .

pddl:pred_standing_emitted
    a pddl:Predicate ;
    pddl:name "standing-emitted" ;
    pddl:param [ pddl:index 0 ; pddl:var "?env" ; pddl:ofType "standing-envelope" ] .

pddl:pred_shacl_valid
    a pddl:Predicate ;
    pddl:name "shacl-valid" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] .

pddl:pred_shex_valid
    a pddl:Predicate ;
    pddl:name "shex-valid" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] .

pddl:pred_n3_materialized
    a pddl:Predicate ;
    pddl:name "n3-materialized" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] .

pddl:pred_datalog_closed
    a pddl:Predicate ;
    pddl:name "datalog-closed" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] .

pddl:pred_pddl_plan_generated
    a pddl:Predicate ;
    pddl:name "pddl-plan-generated" ;
    pddl:param [ pddl:index 0 ; pddl:var "?art" ; pddl:ofType "evidence-artifact" ] .

pddl:pred_powl_compiled
    a pddl:Predicate ;
    pddl:name "powl-compiled" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] .

pddl:pred_client_smoked
    a pddl:Predicate ;
    pddl:name "client-smoked" ;
    pddl:param [ pddl:index 0 ; pddl:var "?client" ; pddl:ofType "client-surface" ] .

pddl:pred_receipts_verified
    a pddl:Predicate ;
    pddl:name "receipts-verified" ;
    pddl:param [ pddl:index 0 ; pddl:var "?chain" ; pddl:ofType "receipt-chain" ] .

pddl:pred_benchmarks_attached
    a pddl:Predicate ;
    pddl:name "benchmarks-attached" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bench" ; pddl:ofType "benchmark-report" ] .

pddl:pred_ocel_recorded
    a pddl:Predicate ;
    pddl:name "ocel-recorded" ;
    pddl:param [ pddl:index 0 ; pddl:var "?log" ; pddl:ofType "ocel-log" ] .

pddl:pred_wasm4pm_validated
    a pddl:Predicate ;
    pddl:name "wasm4pm-validated" ;
    pddl:param [ pddl:index 0 ; pddl:var "?val" ; pddl:ofType "process-validation" ] .

pddl:pred_claim_promoted
    a pddl:Predicate ;
    pddl:name "claim-promoted" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] .

pddl:pred_claim_demoted
    a pddl:Predicate ;
    pddl:name "claim-demoted" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] .

pddl:pred_claim_promoted_lawfully
    a pddl:Predicate ;
    pddl:name "claim-promoted-lawfully" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] .

pddl:pred_external_side_effect_open
    a pddl:Predicate ;
    pddl:name "external-side-effect-open" ;
    pddl:param [ pddl:index 0 ; pddl:var "?eff" ; pddl:ofType "external-side-effect" ] .

pddl:pred_external_side_effect_classified
    a pddl:Predicate ;
    pddl:name "external-side-effect-classified" ;
    pddl:param [ pddl:index 0 ; pddl:var "?eff" ; pddl:ofType "external-side-effect" ] .

pddl:pred_ready_for_scope
    a pddl:Predicate ;
    pddl:name "ready-for-scope" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] .

# ── Actions (16) ──────────────────────────────────────────────────────────

# 1. emit-standing(?repo, ?env): compile real workspace evidence to a
#    standing envelope.
pddl:action_emit_standing
    a pddl:Action ;
    pddl:name "emit-standing" ;
    pddl:param [ pddl:index 0 ; pddl:var "?repo" ; pddl:ofType "repo" ] ,
              [ pddl:index 1 ; pddl:var "?env" ; pddl:ofType "standing-envelope" ] ;
    pddl:pre "(has-evidence ?repo)" ;
    pddl:add "(standing-emitted ?env)" .

# 2. validate-shacl(?env, ?judg): GraphLaw shapes gate (Lane 2).
pddl:action_validate_shacl
    a pddl:Action ;
    pddl:name "validate-shacl" ;
    pddl:param [ pddl:index 0 ; pddl:var "?env" ; pddl:ofType "standing-envelope" ] ,
              [ pddl:index 1 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ;
    pddl:pre "(standing-emitted ?env)" ;
    pddl:add "(shacl-valid ?judg)" .

# 3. validate-shex(?env, ?judg): GraphLaw topology gate (Lane 2).
pddl:action_validate_shex
    a pddl:Action ;
    pddl:name "validate-shex" ;
    pddl:param [ pddl:index 0 ; pddl:var "?env" ; pddl:ofType "standing-envelope" ] ,
              [ pddl:index 1 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ;
    pddl:pre "(standing-emitted ?env)" ;
    pddl:add "(shex-valid ?judg)" .

# 4. materialize-n3(?env, ?judg): GraphLaw N3 rule materialization (Lane 2).
pddl:action_materialize_n3
    a pddl:Action ;
    pddl:name "materialize-n3" ;
    pddl:param [ pddl:index 0 ; pddl:var "?env" ; pddl:ofType "standing-envelope" ] ,
              [ pddl:index 1 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ;
    pddl:pre "(standing-emitted ?env)" ;
    pddl:add "(n3-materialized ?judg)" .

# 5. compute-datalog-closure(?judg): readiness closure over blockers/deps —
#    requires all three GraphLaw validations to have landed on the SAME
#    judgment object.
pddl:action_compute_datalog_closure
    a pddl:Action ;
    pddl:name "compute-datalog-closure" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ;
    pddl:pre "(shacl-valid ?judg)" ,
            "(shex-valid ?judg)" ,
            "(n3-materialized ?judg)" ;
    pddl:add "(datalog-closed ?judg)" .

# 6. solve-pddl-plan(?judg, ?art): this lane's own planner invocation,
#    gated on a closed judgment — the repair plan itself is an artifact of
#    the case study, not a precondition of it.
pddl:action_solve_pddl_plan
    a pddl:Action ;
    pddl:name "solve-pddl-plan" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ,
              [ pddl:index 1 ; pddl:var "?art" ; pddl:ofType "evidence-artifact" ] ;
    pddl:pre "(datalog-closed ?judg)" ;
    pddl:add "(pddl-plan-generated ?art)" .

# 7. compile-powl-model(?art, ?judg): compile the generated plan into a POWL
#    process model.
pddl:action_compile_powl_model
    a pddl:Action ;
    pddl:name "compile-powl-model" ;
    pddl:param [ pddl:index 0 ; pddl:var "?art" ; pddl:ofType "evidence-artifact" ] ,
              [ pddl:index 1 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ;
    pddl:pre "(pddl-plan-generated ?art)" ,
            "(datalog-closed ?judg)" ;
    pddl:add "(powl-compiled ?judg)" .

# 8. smoke-client(?judg, ?client): Playwright smoke of the Autonomic
#    Platform display (Lane 5).
pddl:action_smoke_client
    a pddl:Action ;
    pddl:name "smoke-client" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ,
              [ pddl:index 1 ; pddl:var "?client" ; pddl:ofType "client-surface" ] ;
    pddl:pre "(powl-compiled ?judg)" ;
    pddl:add "(client-smoked ?client)" .

# 9. verify-receipts(?judg, ?chain): `receipt validate --dir` over this
#    case study's own receipts ledger.
pddl:action_verify_receipts
    a pddl:Action ;
    pddl:name "verify-receipts" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ,
              [ pddl:index 1 ; pddl:var "?chain" ; pddl:ofType "receipt-chain" ] ;
    pddl:pre "(powl-compiled ?judg)" ;
    pddl:add "(receipts-verified ?chain)" .

# 10. attach-benchmarks(?judg, ?bench): fold benchmark evidence onto the
#     judgment.
pddl:action_attach_benchmarks
    a pddl:Action ;
    pddl:name "attach-benchmarks" ;
    pddl:param [ pddl:index 0 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ,
              [ pddl:index 1 ; pddl:var "?bench" ; pddl:ofType "benchmark-report" ] ;
    pddl:pre "(powl-compiled ?judg)" ;
    pddl:add "(benchmarks-attached ?bench)" .

# 11. record-ocel(?client, ?chain, ?bench, ?log): this case study's own
#     OCEL log, only once all three downstream evidence strands exist.
pddl:action_record_ocel
    a pddl:Action ;
    pddl:name "record-ocel" ;
    pddl:param [ pddl:index 0 ; pddl:var "?client" ; pddl:ofType "client-surface" ] ,
              [ pddl:index 1 ; pddl:var "?chain" ; pddl:ofType "receipt-chain" ] ,
              [ pddl:index 2 ; pddl:var "?bench" ; pddl:ofType "benchmark-report" ] ,
              [ pddl:index 3 ; pddl:var "?log" ; pddl:ofType "ocel-log" ] ;
    pddl:pre "(client-smoked ?client)" ,
            "(receipts-verified ?chain)" ,
            "(benchmarks-attached ?bench)" ;
    pddl:add "(ocel-recorded ?log)" .

# 12. validate-wasm4pm-process(?log, ?val): wasm4pm conformance over the
#     recorded OCEL log (Lane 4).
pddl:action_validate_wasm4pm_process
    a pddl:Action ;
    pddl:name "validate-wasm4pm-process" ;
    pddl:param [ pddl:index 0 ; pddl:var "?log" ; pddl:ofType "ocel-log" ] ,
              [ pddl:index 1 ; pddl:var "?val" ; pddl:ofType "process-validation" ] ;
    pddl:pre "(ocel-recorded ?log)" ;
    pddl:add "(wasm4pm-validated ?val)" .

# 13. demote-claim(?claim): REPAIR — an earlier, evidence-less pass marked
#     the scope's claim promoted; that is unlawful and must be undone
#     before it can be re-earned.
pddl:action_demote_claim
    a pddl:Action ;
    pddl:name "demote-claim" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] ;
    pddl:pre "(claim-promoted ?claim)" ;
    pddl:add "(claim-demoted ?claim)" ;
    pddl:del "(claim-promoted ?claim)" .

# 14. classify-external-side-effect(?eff): separate the fleet's real
#     external operator side effects (open cargo-cicd receipt writes) from
#     release blockers — non-goal per CASE_STUDY_CONTROL.md.
pddl:action_classify_external_side_effect
    a pddl:Action ;
    pddl:name "classify-external-side-effect" ;
    pddl:param [ pddl:index 0 ; pddl:var "?eff" ; pddl:ofType "external-side-effect" ] ;
    pddl:pre "(external-side-effect-open ?eff)" ;
    pddl:add "(external-side-effect-classified ?eff)" .

# 15. promote-claim(?claim, ?judg, ?val): lawful re-promotion — only once
#     demoted AND backed by both a closed GraphLaw judgment and a passing
#     wasm4pm process validation.
pddl:action_promote_claim
    a pddl:Action ;
    pddl:name "promote-claim" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] ,
              [ pddl:index 1 ; pddl:var "?judg" ; pddl:ofType "graphlaw-judgment" ] ,
              [ pddl:index 2 ; pddl:var "?val" ; pddl:ofType "process-validation" ] ;
    pddl:pre "(claim-demoted ?claim)" ,
            "(datalog-closed ?judg)" ,
            "(wasm4pm-validated ?val)" ;
    pddl:add "(claim-promoted-lawfully ?claim)" .

# 16. render-final-verdict(?claim, ?eff): the scope becomes ready only once
#     the claim is lawfully promoted AND external side effects are
#     accounted for (never silently folded into the verdict).
pddl:action_render_final_verdict
    a pddl:Action ;
    pddl:name "render-final-verdict" ;
    pddl:param [ pddl:index 0 ; pddl:var "?claim" ; pddl:ofType "claim" ] ,
              [ pddl:index 1 ; pddl:var "?eff" ; pddl:ofType "external-side-effect" ] ;
    pddl:pre "(claim-promoted-lawfully ?claim)" ,
            "(external-side-effect-classified ?eff)" ;
    pddl:add "(ready-for-scope ?claim)" .

# ── Problem: autonomic-standing-factory-case-001 ─────────────────────────

pddl:problem_autonomic_standing_factory_case_001
    a pddl:Problem ;
    pddl:name "autonomic-standing-factory-case-001" ;
    pddl:domain "autonomic-standing-factory-pddl8" ;
    pddl:object [ pddl:name "repo-praxis" ; pddl:ofType "repo" ] ,
               [ pddl:name "env-case-study" ; pddl:ofType "standing-envelope" ] ,
               [ pddl:name "judg-case-study" ; pddl:ofType "graphlaw-judgment" ] ,
               [ pddl:name "art-pddl-plan" ; pddl:ofType "evidence-artifact" ] ,
               [ pddl:name "client-autonomic-platform" ; pddl:ofType "client-surface" ] ,
               [ pddl:name "chain-case-study" ; pddl:ofType "receipt-chain" ] ,
               [ pddl:name "bench-case-study" ; pddl:ofType "benchmark-report" ] ,
               [ pddl:name "log-case-study" ; pddl:ofType "ocel-log" ] ,
               [ pddl:name "val-wasm4pm" ; pddl:ofType "process-validation" ] ,
               [ pddl:name "eff-cargo-cicd-receipts" ; pddl:ofType "external-side-effect" ] ,
               [ pddl:name "autonomic-standing-factory-local-first" ; pddl:ofType "claim" ] ;
    pddl:init "(has-evidence repo-praxis)" ,
             "(claim-promoted autonomic-standing-factory-local-first)" ,
             "(external-side-effect-open eff-cargo-cicd-receipts)" ;
    pddl:goal "(ready-for-scope autonomic-standing-factory-local-first)" .
