@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix ceng: <https://praxis.chatman.io/ontology/ceng#> .
@prefix ggen: <https://praxis.chatman.io/ontology/ggen#> .

#################################################################
# Ontology Declaration
#################################################################

ceng:ChatmanEngineOntology a owl:Ontology ;
    rdfs:label "Chatman Engine Semantic Architecture"@en ;
    rdfs:comment "A governed process CPU that preserves RDF authority while lowering admitted bounded work into deterministic execution surfaces."@en .

#################################################################
# Core Classes
#################################################################

ceng:Component a owl:Class ;
    rdfs:label "Component"@en .

ceng:ExecutionRoute a owl:Class ;
    rdfs:label "Execution Route"@en .

ceng:Dialect a owl:Class ;
    rdfs:label "Semantic Dialect"@en .

ceng:Crate a owl:Class ;
    rdfs:label "Rust Crate"@en .

ceng:CanonicalType a owl:Class ;
    rdfs:label "Canonical Type"@en .

ceng:GeneratedArtifact a owl:Class ;
    rdfs:label "Generated Artifact"@en .

ceng:GenerationDirective a owl:Class ;
    rdfs:label "Generation Directive"@en .

ceng:AcceptanceCase a owl:Class ;
    rdfs:label "Acceptance Case"@en .

ceng:FalsificationCase a owl:Class ;
    rdfs:label "Falsification Case"@en .

ceng:Refusal a owl:Class ;
    rdfs:label "Typed Refusal"@en .

ceng:Invariant a owl:Class ;
    rdfs:label "Invariant"@en .

ceng:ProjectionLens a owl:Class ;
    rdfs:label "Projection Lens"@en .

ceng:BoundaryRequest a owl:Class ;
    rdfs:label "Boundary Request"@en .

ceng:ActuationAttempt a owl:Class ;
    rdfs:label "Actuation Attempt"@en .

ceng:ReceiptEnvelope a owl:Class ;
    rdfs:label "Receipt Envelope"@en .

ceng:ForbiddenCapability a owl:Class ;
    rdfs:label "Forbidden Capability"@en .

ceng:LifecycleStage a owl:Class ;
    rdfs:label "Lifecycle Stage"@en .

ceng:RouteDecision a owl:Class ;
    rdfs:label "Route Decision"@en .

ceng:FixtureSchema a owl:Class ;
    rdfs:label "Fixture Schema"@en .

ceng:TestHarness a owl:Class ;
    rdfs:label "Test Harness"@en .

ceng:PropertyTest a owl:Class ;
    rdfs:label "Property Test"@en .

ceng:MetamorphicTest a owl:Class ;
    rdfs:label "Metamorphic Test"@en .

#################################################################
# ggen Classes
#################################################################

ggen:Template a owl:Class ;
    rdfs:label "ggen Template"@en .

ggen:OutputFile a owl:Class ;
    rdfs:label "ggen Output File"@en .

ggen:Fixture a owl:Class ;
    rdfs:label "ggen Fixture"@en .

ggen:GeneratorRun a owl:Class ;
    rdfs:label "ggen Generator Run"@en .

#################################################################
# Core Object Properties
#################################################################

ceng:executesIn a owl:ObjectProperty ;
    rdfs:label "executes in"@en .

ceng:routesWorkloadTo a owl:ObjectProperty ;
    rdfs:label "routes workload to"@en .

ceng:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en .

ceng:wrapsCanonicalType a owl:ObjectProperty ;
    rdfs:label "wraps canonical type"@en .

ceng:bridgesCanonicalType a owl:ObjectProperty ;
    rdfs:label "bridges canonical type"@en .

ceng:forbidsDefinitionOf a owl:ObjectProperty ;
    rdfs:label "forbids definition of"@en .

ceng:forbidsCapability a owl:ObjectProperty ;
    rdfs:label "forbids capability"@en .

ceng:requiresReceipt a owl:ObjectProperty ;
    rdfs:label "requires receipt"@en .

ceng:expectedRefusal a owl:ObjectProperty ;
    rdfs:label "expected refusal"@en .

ceng:protectsInvariant a owl:ObjectProperty ;
    rdfs:label "protects invariant"@en .

ceng:violatesInvariant a owl:ObjectProperty ;
    rdfs:label "violates invariant"@en .

ceng:generatesArtifact a owl:ObjectProperty ;
    rdfs:label "generates artifact"@en .

ceng:targetCrate a owl:ObjectProperty ;
    rdfs:label "target crate"@en .

ceng:usesFixtureSchema a owl:ObjectProperty ;
    rdfs:label "uses fixture schema"@en .

ceng:usesProjectionLens a owl:ObjectProperty ;
    rdfs:label "uses projection lens"@en .

ceng:nextStage a owl:ObjectProperty ;
    rdfs:label "next stage"@en .

ceng:precedesStage a owl:ObjectProperty ;
    rdfs:label "precedes stage"@en .

ceng:mustRefuse a owl:ObjectProperty ;
    rdfs:label "must refuse"@en .

ceng:mustAdmit a owl:ObjectProperty ;
    rdfs:label "must admit"@en .

ceng:hasSuccessCase a owl:ObjectProperty ;
    rdfs:label "has success case"@en .

ceng:hasFalsificationCase a owl:ObjectProperty ;
    rdfs:label "has falsification case"@en .

ceng:hasPropertyTest a owl:ObjectProperty ;
    rdfs:label "has property test"@en .

ceng:hasMetamorphicTest a owl:ObjectProperty ;
    rdfs:label "has metamorphic test"@en .

ggen:usesTemplate a owl:ObjectProperty ;
    rdfs:label "uses template"@en .

ggen:writesFile a owl:ObjectProperty ;
    rdfs:label "writes file"@en .

ggen:loadsFixture a owl:ObjectProperty ;
    rdfs:label "loads fixture"@en .

ggen:manufacturesFrom a owl:ObjectProperty ;
    rdfs:label "manufactures from"@en .

#################################################################
# Core Datatype Properties
#################################################################

ceng:maxConstraints a owl:DatatypeProperty ;
    rdfs:label "max constraints"@en ;
    rdfs:range xsd:integer .

ceng:defaultEnabled a owl:DatatypeProperty ;
    rdfs:label "default enabled"@en ;
    rdfs:range xsd:boolean .

ceng:mayActuate a owl:DatatypeProperty ;
    rdfs:label "may actuate"@en ;
    rdfs:range xsd:boolean .

ceng:crateName a owl:DatatypeProperty ;
    rdfs:label "crate name"@en ;
    rdfs:range xsd:string .

ceng:modulePath a owl:DatatypeProperty ;
    rdfs:label "module path"@en ;
    rdfs:range xsd:string .

ceng:filePath a owl:DatatypeProperty ;
    rdfs:label "file path"@en ;
    rdfs:range xsd:string .

ceng:testFixturePath a owl:DatatypeProperty ;
    rdfs:label "test fixture path"@en ;
    rdfs:range xsd:string .

ceng:schemaPath a owl:DatatypeProperty ;
    rdfs:label "schema path"@en ;
    rdfs:range xsd:string .

ceng:rustPath a owl:DatatypeProperty ;
    rdfs:label "Rust path"@en ;
    rdfs:range xsd:string .

ceng:rustVariant a owl:DatatypeProperty ;
    rdfs:label "Rust variant"@en ;
    rdfs:range xsd:string .

ceng:mayDuplicate a owl:DatatypeProperty ;
    rdfs:label "may duplicate"@en ;
    rdfs:range xsd:boolean .

ceng:wrapperAllowed a owl:DatatypeProperty ;
    rdfs:label "wrapper allowed"@en ;
    rdfs:range xsd:boolean .

ceng:adapterAllowed a owl:DatatypeProperty ;
    rdfs:label "adapter allowed"@en ;
    rdfs:range xsd:boolean .

ceng:expectedBehavior a owl:DatatypeProperty ;
    rdfs:label "expected behavior"@en ;
    rdfs:range xsd:string .

ceng:antiHardcodeProperty a owl:DatatypeProperty ;
    rdfs:label "anti-hardcode property"@en ;
    rdfs:range xsd:string .

ceng:falsificationMutation a owl:DatatypeProperty ;
    rdfs:label "falsification mutation"@en ;
    rdfs:range xsd:string .

ceng:generatedDataStrategy a owl:DatatypeProperty ;
    rdfs:label "generated data strategy"@en ;
    rdfs:range xsd:string .

ceng:expectedRoute a owl:DatatypeProperty ;
    rdfs:label "expected route"@en ;
    rdfs:range xsd:string .

ceng:expectedExitCode a owl:DatatypeProperty ;
    rdfs:label "expected exit code"@en ;
    rdfs:range xsd:integer .

ceng:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:range xsd:string .

#################################################################
# Projection Lenses
#################################################################

ceng:SemanticAuthority a ceng:ProjectionLens ;
    rdfs:label "Lens 1 — Semantic Authority"@en ;
    rdfs:comment "Preserves RDF/Oxigraph as source of truth and forbids semantic shadow copies."@en .

ceng:RoutingConstitution a ceng:ProjectionLens ;
    rdfs:label "Lens 2 — Routing Constitution"@en ;
    rdfs:comment "Preserves least-expressive-power routing across hot, warm, and cold paths."@en .

ceng:TypeKernelOwnership a ceng:ProjectionLens ;
    rdfs:label "Lens 3 — Type Kernel Ownership"@en ;
    rdfs:comment "Preserves canonical type ownership and prevents duplicate constitutional types."@en .

ceng:TransitionLifecycle a ceng:ProjectionLens ;
    rdfs:label "Lens 4 — Transition Lifecycle"@en ;
    rdfs:comment "Preserves invocation-to-replay lifecycle admissibility."@en .

ceng:EventHookActuation a ceng:ProjectionLens ;
    rdfs:label "Lens 5 — Event / Hook / Actuation"@en ;
    rdfs:comment "Preserves OCEL event ingestion, Knowledge Hook matching, and receipted boundary actuation."@en .

ceng:HotPathPerformance a ceng:ProjectionLens ;
    rdfs:label "Lens 6 — Performance / 8-Constraint Hot Path"@en ;
    rdfs:comment "Preserves RDFTriple8, ConditionCell, 256-state tables, and branchless admission."@en .

ceng:RefusalGovernance a ceng:ProjectionLens ;
    rdfs:label "Lens 7 — Refusal / Risk / Governance"@en ;
    rdfs:comment "Preserves typed refusal taxonomy, N3 quarantine, profile denial, and board governance."@en .

ceng:TpsDflssContinuousImprovement a ceng:ProjectionLens ;
    rdfs:label "Lens 8 — TPS / DfLSS / Continuous Improvement"@en ;
    rdfs:comment "Preserves flow, waste removal, CTQ mapping, falsification, benchmark feedback, and kaizen loops."@en .

#################################################################
# Execution Routes
#################################################################

ceng:HotPath a ceng:ExecutionRoute ;
    rdfs:label "Hot Path"@en ;
    rdfs:comment "O(1) bounded local admission route for no more than eight local constraints."@en ;
    ceng:maxConstraints 8 .

ceng:WarmPath a ceng:ExecutionRoute ;
    rdfs:label "Warm Path"@en ;
    rdfs:comment "Structured graph, validation, derivation, planning, workflow, and event route."@en .

ceng:ColdPath a ceng:ExecutionRoute ;
    rdfs:label "Cold Path"@en ;
    rdfs:comment "Permissioned expressive route for bounded N3 or external engines."@en .

#################################################################
# Dialects
#################################################################

ceng:RDFTriple8 a ceng:Dialect ;
    rdfs:label "RDFTriple8"@en ;
    rdfs:comment "Profile-local hot-path RDF projection. It is not semantic authority."@en ;
    ceng:executesIn ceng:HotPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:BitMaskAdmission a ceng:Dialect ;
    rdfs:label "Bit Mask Admission"@en ;
    rdfs:comment "Byte-mask and table-based admission over bounded local constraints."@en ;
    ceng:executesIn ceng:HotPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:SHACL a ceng:Dialect ;
    rdfs:label "SHACL"@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:ShEx a ceng:Dialect ;
    rdfs:label "ShEx"@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:SPARQL a ceng:Dialect ;
    rdfs:label "SPARQL"@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:OwlRl a ceng:Dialect ;
    rdfs:label "OWL-RL"@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:Datalog a ceng:Dialect ;
    rdfs:label "Datalog"@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:PDDL a ceng:Dialect ;
    rdfs:label "PDDL"@en ;
    rdfs:comment "Feasibility planning dialect. It cannot actuate directly."@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:POWL a ceng:Dialect ;
    rdfs:label "POWL"@en ;
    rdfs:comment "Workflow legality dialect. It admits or refuses traces but cannot actuate directly."@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:OCEL a ceng:Dialect ;
    rdfs:label "OCEL"@en ;
    rdfs:comment "Object-centric event log representation used as observed execution material."@en ;
    ceng:executesIn ceng:WarmPath ;
    ceng:defaultEnabled true ;
    ceng:mayActuate false .

ceng:N3 a ceng:Dialect ;
    rdfs:label "N3"@en ;
    rdfs:comment "Cold-path expressive dialect. Disabled by default. No direct actuation."@en ;
    ceng:executesIn ceng:ColdPath ;
    ceng:defaultEnabled false ;
    ceng:mayActuate false .

#################################################################
# Forbidden Capabilities
#################################################################

ceng:DefaultEnablement a ceng:ForbiddenCapability ;
    rdfs:label "Default enablement"@en .

ceng:DirectActuation a ceng:ForbiddenCapability ;
    rdfs:label "Direct actuation"@en .

ceng:AgentProfileOverride a ceng:ForbiddenCapability ;
    rdfs:label "Agent profile override"@en .

ceng:SemanticShadowCopy a ceng:ForbiddenCapability ;
    rdfs:label "Semantic shadow copy"@en .

ceng:UntypedPanic a ceng:ForbiddenCapability ;
    rdfs:label "Untyped panic"@en .

ceng:SilentFallback a ceng:ForbiddenCapability ;
    rdfs:label "Silent fallback"@en .

ceng:ColdPath ceng:forbidsCapability ceng:DefaultEnablement .
ceng:N3 ceng:forbidsCapability ceng:DefaultEnablement, ceng:DirectActuation .
ceng:DialectRouter ceng:forbidsCapability ceng:UntypedPanic, ceng:SilentFallback .
ceng:RDFTriple8 ceng:forbidsCapability ceng:SemanticShadowCopy .

#################################################################
# Crates
#################################################################

ceng:Wasm4pmCompat a ceng:Crate ;
    rdfs:label "wasm4pm-compat"@en ;
    ceng:crateName "wasm4pm-compat" .

ceng:Wasm4pmCognition a ceng:Crate ;
    rdfs:label "wasm4pm-cognition"@en ;
    ceng:crateName "wasm4pm-cognition" .

ceng:BcinrPddl a ceng:Crate ;
    rdfs:label "bcinr-pddl"@en ;
    ceng:crateName "bcinr-pddl" .

ceng:BcinrPowl a ceng:Crate ;
    rdfs:label "bcinr-powl"@en ;
    ceng:crateName "bcinr-powl" .

ceng:PraxisGraphlaw a ceng:Crate ;
    rdfs:label "praxis-graphlaw"@en ;
    ceng:crateName "praxis-graphlaw" .

#################################################################
# Canonical Type Ownership
#################################################################

ceng:ProcessReceipt a ceng:CanonicalType ;
    rdfs:label "ProcessReceipt"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::receipt::ProcessReceipt" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:Pddl8Tape a ceng:CanonicalType ;
    rdfs:label "Pddl8Tape"@en ;
    ceng:ownedBy ceng:BcinrPddl ;
    ceng:rustPath "bcinr_pddl::Pddl8Tape" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:PowlTape a ceng:CanonicalType ;
    rdfs:label "PowlTape"@en ;
    ceng:ownedBy ceng:BcinrPowl ;
    ceng:rustPath "bcinr_powl::tape::v2::PowlTape" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:OcelEvent a ceng:CanonicalType ;
    rdfs:label "OcelEvent"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::ocel::OcelEvent" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:PowlModel a ceng:CanonicalType ;
    rdfs:label "Powl"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::powl::Powl" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:DfgModel a ceng:CanonicalType ;
    rdfs:label "Dfg"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::dfg::Dfg" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:WfNetModel a ceng:CanonicalType ;
    rdfs:label "WfNet"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::petri::WfNet" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:CausalChain a ceng:CanonicalType ;
    rdfs:label "CausalChain"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::causality::CausalChain" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

ceng:ConditionCell a ceng:CanonicalType ;
    rdfs:label "ConditionCell<BITS>"@en ;
    ceng:ownedBy ceng:Wasm4pmCompat ;
    ceng:rustPath "wasm4pm_compat::law::ConditionCell" ;
    ceng:mayDuplicate false ;
    ceng:wrapperAllowed true ;
    ceng:adapterAllowed true .

#################################################################
# Components
#################################################################

ceng:OxigraphStore a ceng:Component ;
    rdfs:label "Oxigraph RDF Store"@en ;
    rdfs:comment "The semantic source of truth for admitted graph state."@en ;
    ceng:usesProjectionLens ceng:SemanticAuthority .

ceng:DialectRouter a ceng:Component ;
    rdfs:label "Dialect Router"@en ;
    rdfs:comment "Routes workloads by least expressive admitted power."@en ;
    ceng:routesWorkloadTo ceng:HotPath, ceng:WarmPath, ceng:ColdPath ;
    ceng:usesProjectionLens ceng:RoutingConstitution .

ceng:ReceiptEnvelope a ceng:Component ;
    rdfs:label "Receipt Envelope"@en ;
    rdfs:comment "Graphlaw-owned envelope that references canonical receipt material without redefining ProcessReceipt."@en ;
    ceng:wrapsCanonicalType ceng:ProcessReceipt ;
    ceng:forbidsDefinitionOf ceng:ProcessReceipt ;
    ceng:usesProjectionLens ceng:TypeKernelOwnership .

ceng:TapeBridge a ceng:Component ;
    rdfs:label "Tape Bridge"@en ;
    rdfs:comment "Orchestration bridge over canonical planning and workflow tapes."@en ;
    ceng:wrapsCanonicalType ceng:Pddl8Tape, ceng:PowlTape ;
    ceng:forbidsDefinitionOf ceng:Pddl8Tape, ceng:PowlTape ;
    ceng:usesProjectionLens ceng:TypeKernelOwnership .

ceng:OcelIngestion a ceng:Component ;
    rdfs:label "OCEL Ingestion"@en ;
    ceng:wrapsCanonicalType ceng:OcelEvent ;
    ceng:forbidsDefinitionOf ceng:OcelEvent ;
    ceng:usesProjectionLens ceng:EventHookActuation .

ceng:KnowledgeHookBoundary a ceng:Component ;
    rdfs:label "Knowledge Hook Boundary"@en ;
    rdfs:comment "Matches admitted graph/event constellations and emits boundary requests only under receipt control."@en ;
    ceng:usesProjectionLens ceng:EventHookActuation .

ceng:AgentWitnessBoundary a ceng:Component ;
    rdfs:label "Agent Witness Boundary"@en ;
    rdfs:comment "Constrains agents and LLMs as governed witnesses/operators, not authorities."@en ;
    ceng:usesProjectionLens ceng:RefusalGovernance .

ceng:TelemetryCollector a ceng:Component ;
    rdfs:label "Benchmark Telemetry Collector"@en ;
    ceng:usesProjectionLens ceng:TpsDflssContinuousImprovement .

ceng:KaizenLoop a ceng:Component ;
    rdfs:label "Kaizen Optimization Loop"@en ;
    ceng:usesProjectionLens ceng:TpsDflssContinuousImprovement .

#################################################################
# Lifecycle Stages
#################################################################

ceng:InvocationStage a ceng:LifecycleStage ;
    rdfs:label "Invocation"@en .

ceng:ValidationStage a ceng:LifecycleStage ;
    rdfs:label "Validation"@en .

ceng:PlanningStage a ceng:LifecycleStage ;
    rdfs:label "Planning"@en .

ceng:WorkflowAdmissionStage a ceng:LifecycleStage ;
    rdfs:label "Workflow Admission"@en .

ceng:HookBoundaryStage a ceng:LifecycleStage ;
    rdfs:label "Hook Boundary"@en .

ceng:ReceiptingStage a ceng:LifecycleStage ;
    rdfs:label "Receipting"@en .

ceng:ReplayStage a ceng:LifecycleStage ;
    rdfs:label "Replay"@en .

ceng:InvocationStage ceng:nextStage ceng:ValidationStage .
ceng:ValidationStage ceng:nextStage ceng:PlanningStage .
ceng:PlanningStage ceng:nextStage ceng:WorkflowAdmissionStage .
ceng:WorkflowAdmissionStage ceng:nextStage ceng:HookBoundaryStage .
ceng:HookBoundaryStage ceng:nextStage ceng:ReceiptingStage .
ceng:ReceiptingStage ceng:nextStage ceng:ReplayStage .

#################################################################
# Invariants
#################################################################

ceng:NoReceiptShadowType a ceng:Invariant ;
    rdfs:label "No receipt shadow type"@en ;
    rdfs:comment "praxis-graphlaw must not define a standalone ProcessReceipt."@en ;
    ceng:usesProjectionLens ceng:TypeKernelOwnership .

ceng:RDFTriple8ProjectionOnly a ceng:Invariant ;
    rdfs:label "RDFTriple8 is projection only"@en ;
    rdfs:comment "RDFTriple8 may accelerate admitted local checks but cannot replace RDF/Oxigraph authority."@en ;
    ceng:usesProjectionLens ceng:SemanticAuthority, ceng:HotPathPerformance .

ceng:NoDefaultN3 a ceng:Invariant ;
    rdfs:label "N3 disabled by default"@en ;
    ceng:usesProjectionLens ceng:RoutingConstitution, ceng:RefusalGovernance .

ceng:NoUnreceiptedActuation a ceng:Invariant ;
    rdfs:label "No unreceipted actuation"@en ;
    ceng:usesProjectionLens ceng:EventHookActuation, ceng:RefusalGovernance .

ceng:AgentCannotOverrideProfile a ceng:Invariant ;
    rdfs:label "Agent cannot override profile"@en ;
    ceng:usesProjectionLens ceng:RefusalGovernance .

ceng:NoSilentFallback a ceng:Invariant ;
    rdfs:label "No silent fallback"@en ;
    ceng:usesProjectionLens ceng:RoutingConstitution, ceng:RefusalGovernance .

ceng:NoDuplicateCanonicalTypes a ceng:Invariant ;
    rdfs:label "No duplicate canonical types"@en ;
    ceng:usesProjectionLens ceng:TypeKernelOwnership .

ceng:AdmissionTableHas256States a ceng:Invariant ;
    rdfs:label "Admission table has 256 states"@en ;
    ceng:usesProjectionLens ceng:HotPathPerformance .

ceng:ReplayIsInputSpecific a ceng:Invariant ;
    rdfs:label "Replay is input-specific"@en ;
    ceng:usesProjectionLens ceng:TransitionLifecycle, ceng:RefusalGovernance .

ceng:DistinctInputsProduceDistinctReceipts a ceng:Invariant ;
    rdfs:label "Distinct inputs produce distinct receipts"@en ;
    ceng:usesProjectionLens ceng:TransitionLifecycle, ceng:TpsDflssContinuousImprovement .

#################################################################
# Refusals
#################################################################

ceng:ProcessReceiptShadowType a ceng:Refusal ;
    rdfs:label "Process receipt shadow type"@en ;
    rdfs:comment "Raised when praxis-graphlaw defines a standalone ProcessReceipt instead of wrapping canonical receipt material."@en ;
    ceng:rustVariant "ProcessReceiptShadowType" .

ceng:Triple8UniverseOverflow a ceng:Refusal ;
    rdfs:label "Triple8 universe overflow"@en ;
    ceng:rustVariant "Triple8UniverseOverflow" .

ceng:TermNotInTriple8Universe a ceng:Refusal ;
    rdfs:label "Term not in Triple8 universe"@en ;
    ceng:rustVariant "TermNotInTriple8Universe" .

ceng:WarmPathRequired a ceng:Refusal ;
    rdfs:label "Warm path required"@en ;
    ceng:rustVariant "WarmPathRequired" .

ceng:ProfileSymbolTableMismatch a ceng:Refusal ;
    rdfs:label "Profile symbol table mismatch"@en ;
    ceng:rustVariant "ProfileSymbolTableMismatch" .

ceng:ProjectionHashMismatch a ceng:Refusal ;
    rdfs:label "Projection hash mismatch"@en ;
    ceng:rustVariant "ProjectionHashMismatch" .

