#################################################################
# Generation Artifacts
#################################################################

ceng:ReceiptEnvelopeArtifact a ceng:GeneratedArtifact ;
    rdfs:label "Receipt Envelope Artifact"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:modulePath "crates/praxis-graphlaw/src/abi.rs" ;
    ceng:wrapsCanonicalType ceng:ProcessReceipt ;
    ceng:forbidsDefinitionOf ceng:ProcessReceipt ;
    ceng:protectsInvariant ceng:NoReceiptShadowType .

ceng:RDFTriple8Artifact a ceng:GeneratedArtifact ;
    rdfs:label "RDFTriple8 Projection Artifact"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:modulePath "crates/praxis-graphlaw/src/triple8.rs" ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly .

ceng:DialectRouterArtifact a ceng:GeneratedArtifact ;
    rdfs:label "Dialect Router Artifact"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:modulePath "crates/praxis-graphlaw/src/router.rs" ;
    ceng:protectsInvariant ceng:NoDefaultN3, ceng:NoSilentFallback .

ceng:TapeBridgeArtifact a ceng:GeneratedArtifact ;
    rdfs:label "Tape Bridge Artifact"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:modulePath "crates/praxis-graphlaw/src/bridge.rs" ;
    ceng:wrapsCanonicalType ceng:Pddl8Tape, ceng:PowlTape ;
    ceng:forbidsDefinitionOf ceng:Pddl8Tape, ceng:PowlTape ;
    ceng:protectsInvariant ceng:NoDuplicateCanonicalTypes .

ceng:EngineBoundaryArtifact a ceng:GeneratedArtifact ;
    rdfs:label "Engine Boundary Artifact"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:modulePath "crates/praxis-graphlaw/src/engine.rs" ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation, ceng:AgentCannotOverrideProfile .

#################################################################
# Generation Directives
#################################################################

ceng:GenerateReceiptEnvelope a ceng:GenerationDirective ;
    rdfs:label "Generate Receipt Envelope"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:generatesArtifact ceng:ReceiptEnvelopeArtifact ;
    ceng:protectsInvariant ceng:NoReceiptShadowType .

ceng:GenerateRDFTriple8Projection a ceng:GenerationDirective ;
    rdfs:label "Generate RDFTriple8 Projection"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:generatesArtifact ceng:RDFTriple8Artifact ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly .

ceng:GenerateDialectRouter a ceng:GenerationDirective ;
    rdfs:label "Generate Dialect Router"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:generatesArtifact ceng:DialectRouterArtifact ;
    ceng:protectsInvariant ceng:NoDefaultN3, ceng:NoSilentFallback .

ceng:GenerateTapeBridge a ceng:GenerationDirective ;
    rdfs:label "Generate Tape Bridge"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:generatesArtifact ceng:TapeBridgeArtifact ;
    ceng:protectsInvariant ceng:NoDuplicateCanonicalTypes .

ceng:GenerateEngineBoundary a ceng:GenerationDirective ;
    rdfs:label "Generate Engine Boundary"@en ;
    ceng:targetCrate ceng:PraxisGraphlaw ;
    ceng:generatesArtifact ceng:EngineBoundaryArtifact ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation, ceng:AgentCannotOverrideProfile .

