ceng:HookWithoutReceiptRefused a ceng:FalsificationCase ;
    rdfs:label "Hook without receipt refused"@en ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation ;
    ceng:usesFixtureSchema ceng:HookScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/hooks/unreceipted_actuation_refused.json" ;
    ceng:expectedRefusal ceng:BoundaryRequestMissingReceipt ;
    ceng:falsificationMutation "Remove receipt material from a boundary request that otherwise matches an admitted hook pattern." .

ceng:HookPatternNotAdmittedRefused a ceng:FalsificationCase ;
    rdfs:label "Hook pattern not admitted refused"@en ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation ;
    ceng:usesFixtureSchema ceng:HookScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/hooks/hook_pattern_not_admitted_refused.json" ;
    ceng:expectedRefusal ceng:HookPatternNotAdmitted ;
    ceng:falsificationMutation "Submit an OCEL event that lacks the admitted constellation required by the hook." .

ceng:OcelEventNotAdmittedRefused a ceng:FalsificationCase ;
    rdfs:label "OCEL event not admitted refused"@en ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation ;
    ceng:usesFixtureSchema ceng:HookScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/hooks/ocel_event_not_admitted_refused.json" ;
    ceng:expectedRefusal ceng:OcelEventNotAdmitted ;
    ceng:falsificationMutation "Use an event that has not passed the OCEL admission gate." .

ceng:AgentOverrideDeniedCase a ceng:FalsificationCase ;
    rdfs:label "Agent override denied"@en ;
    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:usesFixtureSchema ceng:AgentScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/agents/agent_override_denied.json" ;
    ceng:expectedRefusal ceng:AgentOverrideDenied ;
    ceng:falsificationMutation "Add agent-provided profile override instructions to an otherwise valid request." .

ceng:WitnessTreatedAsAuthorityRefused a ceng:FalsificationCase ;
    rdfs:label "Witness treated as authority refused"@en ;
    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:usesFixtureSchema ceng:AgentScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/agents/witness_treated_as_authority_refused.json" ;
    ceng:expectedRefusal ceng:WitnessNotAuthority ;
    ceng:falsificationMutation "Treat LLM or agent witness output as admitted authority." .

ceng:DisabledBreedRefused a ceng:FalsificationCase ;
    rdfs:label "Disabled breed refused"@en ;
    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:usesFixtureSchema ceng:AgentScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/agents/disabled_breed_refused.json" ;
    ceng:expectedRefusal ceng:BreedUnpermitted ;
    ceng:falsificationMutation "Invoke a breed that is not enabled by the active profile." .

ceng:NondeterministicBreedWithoutReceiptRefused a ceng:FalsificationCase ;
