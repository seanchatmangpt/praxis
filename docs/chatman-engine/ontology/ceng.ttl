    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:usesFixtureSchema ceng:RoutingScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/routing/sparql_escalates_to_n3_refused.json" ;
    ceng:expectedRefusal ceng:LeastExpressiveRouteViolation ;
    ceng:falsificationMutation "Escalate a SPARQL-sufficient workload to N3 without admitted need." .

ceng:UnsupportedDialectRefused a ceng:FalsificationCase ;
    rdfs:label "Unsupported dialect refused"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:usesFixtureSchema ceng:RoutingScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/routing/unsupported_dialect_refused.json" ;
