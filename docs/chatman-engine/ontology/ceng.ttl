    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:usesFixtureSchema ceng:AgentScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/agents/nondeterministic_breed_without_receipt_refused.json" ;
    ceng:expectedRefusal ceng:NondeterministicOperatorRequiresReceipt ;
    ceng:falsificationMutation "Invoke nondeterministic breed without receipt/replay metadata." .

ceng:Pddl8TapeDuplicateRefused a ceng:FalsificationCase ;
    rdfs:label "Pddl8Tape duplicate refused"@en ;
    ceng:protectsInvariant ceng:NoDuplicateCanonicalTypes ;
    ceng:usesFixtureSchema ceng:StaticGateScenarioSchema ;
