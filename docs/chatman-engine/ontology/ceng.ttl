#################################################################
# Anti-Hardcode Property Tests
#################################################################

ceng:DistinctInputsProduceDistinctReceiptsProperty a ceng:PropertyTest ;
    rdfs:label "Distinct inputs produce distinct receipts"@en ;
    ceng:protectsInvariant ceng:DistinctInputsProduceDistinctReceipts ;
    ceng:generatedDataStrategy "Generate two different valid graph/profile/symbol/admission input sets. Both must admit. Their receipt material must differ unless canonical material is identical." ;
    ceng:antiHardcodeProperty "Reject constant receipt, constant hash, constant run id, constant ok response." .

ceng:ReplayIsInputSpecificProperty a ceng:PropertyTest ;
    rdfs:label "Replay is input-specific"@en ;
    ceng:protectsInvariant ceng:ReplayIsInputSpecific ;
    ceng:generatedDataStrategy "Generate valid scenario A and valid scenario B, then swap receipt material." ;
    ceng:antiHardcodeProperty "Reject replay implementation that always returns true or ignores graph/profile/symbol/admission hashes." .

ceng:RefusalsAreSpecificProperty a ceng:PropertyTest ;
    rdfs:label "Refusals are specific"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:generatedDataStrategy "Generate distinct invalid cases with distinct expected refusals." ;
    ceng:antiHardcodeProperty "Reject generic error, constant unsupported, constant success, or return zero." .

ceng:RouteDependsOnInputShapeProperty a ceng:PropertyTest ;
    rdfs:label "Route depends on input shape"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:generatedDataStrategy "Generate hot-path, warm-path, and cold-path workloads with materially different shapes." ;
    ceng:antiHardcodeProperty "Reject always-hot, always-warm, always-cold, always-N3 route decisions." .

ceng:OverflowChangesOutcomeProperty a ceng:PropertyTest ;
    rdfs:label "Overflow changes outcome"@en ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly ;
    ceng:generatedDataStrategy "Generate profile dictionaries at 256 terms and 257 terms." ;
    ceng:antiHardcodeProperty "Reject silent truncation, clamping, or success with corrupted projection." .

ceng:RequiredAndForbiddenMasksMatterProperty a ceng:PropertyTest ;
    rdfs:label "Required and forbidden masks matter"@en ;
    ceng:protectsInvariant ceng:AdmissionTableHas256States ;
    ceng:generatedDataStrategy "Generate varying required masks, forbidden masks, and state masks." ;
    ceng:antiHardcodeProperty "Reject constant zero mask, always admit, always refuse, or ignoring forbidden bits." .

ceng:BoundaryActuationRequiresReceiptProperty a ceng:PropertyTest ;
    rdfs:label "Boundary actuation requires receipt"@en ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation ;
    ceng:generatedDataStrategy "Generate the same boundary request with missing, invalid, and valid receipt material." ;
    ceng:antiHardcodeProperty "Reject hooks that actuate without valid receipt material or treat any string as a receipt." .

ceng:AgentCannotOverrideProfileProperty a ceng:PropertyTest ;
    rdfs:label "Agent cannot override profile"@en ;
    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:generatedDataStrategy "Generate valid payloads with and without agent override attempts." ;
    ceng:antiHardcodeProperty "Reject prompt text or witness material that changes profile governance." .

#################################################################
# Acceptance Cases
#################################################################

ceng:ReceiptEnvelopeAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Receipt envelope admitted"@en ;
    ceng:protectsInvariant ceng:NoReceiptShadowType ;
    ceng:usesFixtureSchema ceng:ReceiptScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/receipt_boundary/canonical_receipt_envelope_admitted.json" ;
    ceng:expectedBehavior "Graphlaw envelope references canonical receipt material and does not define standalone ProcessReceipt." .

ceng:Triple8ProfileWithinBoundAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Triple8 profile within bound admitted"@en ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly ;
    ceng:usesFixtureSchema ceng:Triple8ScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/triple8/profile_256_terms_admitted.json" ;
    ceng:expectedBehavior "Projection succeeds when the profile-local symbol universe contains no more than 256 admitted terms." .

ceng:AdmissionTableValidMaskAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Admission table valid mask admitted"@en ;
    ceng:protectsInvariant ceng:AdmissionTableHas256States ;
    ceng:usesFixtureSchema ceng:AdmissionTableScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/admission_tables/all_required_no_forbidden_admitted.json" ;
    ceng:expectedBehavior "Admission succeeds when all required bits are present and no forbidden bits are present." .

ceng:HotPathRouteAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Hot path route admitted"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:usesFixtureSchema ceng:RoutingScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/routing/hot_path_local_constraints_admitted.json" ;
    ceng:expectedRoute "HotPath" ;
    ceng:expectedBehavior "A workload with no more than eight admitted local constraints routes to the hot path." .

ceng:HookWithReceiptAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Hook with receipt admitted"@en ;
    ceng:protectsInvariant ceng:NoUnreceiptedActuation ;
    ceng:usesFixtureSchema ceng:HookScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/hooks/hook_with_valid_receipt_admitted.json" ;
    ceng:expectedBehavior "Boundary request is permitted only when admitted constellation and valid receipt material are present." .

ceng:AgentWitnessAdmitted a ceng:AcceptanceCase ;
    rdfs:label "Agent witness admitted"@en ;
    ceng:protectsInvariant ceng:AgentCannotOverrideProfile ;
    ceng:usesFixtureSchema ceng:AgentScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/agents/agent_witness_without_override_admitted.json" ;
    ceng:expectedBehavior "Agent output is accepted only as witness or candidate material under an allowed profile." .

#################################################################
# Falsification Cases
#################################################################

ceng:DuplicateProcessReceiptRefused a ceng:FalsificationCase ;
    rdfs:label "Duplicate ProcessReceipt refused"@en ;
    ceng:protectsInvariant ceng:NoReceiptShadowType ;
    ceng:violatesInvariant ceng:NoDuplicateCanonicalTypes ;
    ceng:usesFixtureSchema ceng:ReceiptScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/receipt_boundary/duplicate_process_receipt_refused.json" ;
    ceng:expectedRefusal ceng:ProcessReceiptShadowType ;
    ceng:falsificationMutation "Define a standalone ProcessReceipt in praxis-graphlaw production code." .

ceng:Triple8UniverseOverflowRefused a ceng:FalsificationCase ;
    rdfs:label "Triple8 universe overflow refused"@en ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly ;
    ceng:usesFixtureSchema ceng:Triple8ScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/triple8/profile_257_terms_refused.json" ;
    ceng:expectedRefusal ceng:Triple8UniverseOverflow ;
    ceng:falsificationMutation "Increase profile-local term universe from 256 to 257 terms." .

ceng:UnknownTriple8TermRefused a ceng:FalsificationCase ;
    rdfs:label "Unknown Triple8 term refused"@en ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly ;
    ceng:usesFixtureSchema ceng:Triple8ScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/triple8/unknown_term_refused.json" ;
    ceng:expectedRefusal ceng:TermNotInTriple8Universe ;
    ceng:falsificationMutation "Reference a subject, predicate, or object not admitted by the profile-local symbol table." .

ceng:TooManyLocalConstraintsWarmPathRequired a ceng:FalsificationCase ;
    rdfs:label "Too many local constraints require warm path"@en ;
    ceng:protectsInvariant ceng:RDFTriple8ProjectionOnly ;
    ceng:usesFixtureSchema ceng:Triple8ScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/triple8/more_than_8_constraints_warm_path_required.json" ;
    ceng:expectedRefusal ceng:WarmPathRequired ;
    ceng:falsificationMutation "Increase local constraint count beyond eight." .

ceng:MissingRequiredBitRefused a ceng:FalsificationCase ;
    rdfs:label "Missing required bit refused"@en ;
    ceng:protectsInvariant ceng:AdmissionTableHas256States ;
    ceng:usesFixtureSchema ceng:AdmissionTableScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/admission_tables/missing_required_bit_refused.json" ;
    ceng:expectedRefusal ceng:AdmissionTableMismatch ;
    ceng:falsificationMutation "Clear one required bit from the state mask." .

ceng:ForbiddenBitPresentRefused a ceng:FalsificationCase ;
    rdfs:label "Forbidden bit present refused"@en ;
    ceng:protectsInvariant ceng:AdmissionTableHas256States ;
    ceng:usesFixtureSchema ceng:AdmissionTableScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/admission_tables/forbidden_bit_present_refused.json" ;
    ceng:expectedRefusal ceng:AdmissionTableMismatch ;
    ceng:falsificationMutation "Set one forbidden bit in the state mask." .

ceng:N3DefaultProfileRefused a ceng:FalsificationCase ;
    rdfs:label "N3 default profile refused"@en ;
    ceng:protectsInvariant ceng:NoDefaultN3 ;
    ceng:usesFixtureSchema ceng:RoutingScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/routing/n3_default_profile_refused.json" ;
    ceng:expectedRefusal ceng:N3UnavailableByProfile ;
    ceng:falsificationMutation "Request N3 under the default profile." .

ceng:N3ActuationRefused a ceng:FalsificationCase ;
    rdfs:label "N3 actuation refused"@en ;
    ceng:protectsInvariant ceng:NoDefaultN3, ceng:NoUnreceiptedActuation ;
    ceng:usesFixtureSchema ceng:RoutingScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/routing/n3_actuation_refused.json" ;
    ceng:expectedRefusal ceng:N3ActuationRefused ;
