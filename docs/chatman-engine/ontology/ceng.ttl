#################################################################
# Static Gate Cases
#################################################################

ceng:NoForbiddenProductionTokens a ceng:AcceptanceCase ;
    rdfs:label "No forbidden production tokens"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:usesFixtureSchema ceng:StaticGateScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/static_gates/no_forbidden_production_tokens.json" ;
    ceng:expectedBehavior "New and modified production paths contain no unadjudicated panic, unwrap, expect, todo, unimplemented, placeholder, or same-as-above tokens." .

ceng:NoBroadWarningsAllow a ceng:AcceptanceCase ;
    rdfs:label "No broad warnings allow"@en ;
    ceng:protectsInvariant ceng:NoSilentFallback ;
    ceng:usesFixtureSchema ceng:StaticGateScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/static_gates/no_broad_warnings_allow.json" ;
    ceng:expectedBehavior "Production code does not add broad crate-level warning suppression." .

ceng:NoDuplicateCanonicalDefinitions a ceng:AcceptanceCase ;
    rdfs:label "No duplicate canonical definitions"@en ;
    ceng:protectsInvariant ceng:NoDuplicateCanonicalTypes ;
    ceng:usesFixtureSchema ceng:StaticGateScenarioSchema ;
    ceng:testFixturePath "crates/praxis-graphlaw/tests/fixtures/chatman_engine_acceptance/static_gates/no_duplicate_canonical_definitions.json" ;
    ceng:expectedBehavior "praxis-graphlaw contains wrappers or adapters only, not duplicate canonical structs." .

#################################################################
# ggen Manufacturing Run
#################################################################

ceng:ChicagoTddAcceptanceSurfaceRun a ggen:GeneratorRun ;
    rdfs:label "Chicago TDD Acceptance Surface Run"@en ;
    rdfs:comment "Manufactures external fixtures, schemas, harnesses, property tests, falsification tests, and static gates before production implementation."@en ;
    ggen:manufacturesFrom ceng:ChatmanEngineOntology ;
    ggen:writesFile ceng:ReceiptAcceptanceHarness,
                    ceng:RoutingAcceptanceHarness,
                    ceng:Triple8AcceptanceHarness,
                    ceng:AdmissionAcceptanceHarness,
                    ceng:HookAcceptanceHarness,
                    ceng:AgentAcceptanceHarness,
                    ceng:ReplayAcceptanceHarness,
                    ceng:StaticGateAcceptanceHarness ;
    ceng:hasPropertyTest ceng:DistinctInputsProduceDistinctReceiptsProperty,
                         ceng:ReplayIsInputSpecificProperty,
                         ceng:RefusalsAreSpecificProperty,
                         ceng:RouteDependsOnInputShapeProperty,
                         ceng:OverflowChangesOutcomeProperty,
                         ceng:RequiredAndForbiddenMasksMatterProperty,
                         ceng:BoundaryActuationRequiresReceiptProperty,
                         ceng:AgentCannotOverrideProfileProperty ;
    ceng:hasSuccessCase ceng:ReceiptEnvelopeAdmitted,
                        ceng:Triple8ProfileWithinBoundAdmitted,
                        ceng:AdmissionTableValidMaskAdmitted,
                        ceng:HotPathRouteAdmitted,
                        ceng:HookWithReceiptAdmitted,
                        ceng:AgentWitnessAdmitted ;
    ceng:hasFalsificationCase ceng:DuplicateProcessReceiptRefused,
                              ceng:Triple8UniverseOverflowRefused,
                              ceng:UnknownTriple8TermRefused,
                              ceng:TooManyLocalConstraintsWarmPathRequired,
                              ceng:MissingRequiredBitRefused,
                              ceng:ForbiddenBitPresentRefused,
                              ceng:N3DefaultProfileRefused,
                              ceng:N3ActuationRefused,
                              ceng:SparqlEscalatesToN3Refused,
                              ceng:UnsupportedDialectRefused,
                              ceng:HookWithoutReceiptRefused,
                              ceng:HookPatternNotAdmittedRefused,
                              ceng:OcelEventNotAdmittedRefused,
                              ceng:AgentOverrideDeniedCase,
                              ceng:WitnessTreatedAsAuthorityRefused,
                              ceng:DisabledBreedRefused,
                              ceng:NondeterministicBreedWithoutReceiptRefused,
                              ceng:Pddl8TapeDuplicateRefused,
                              ceng:PowlTapeDuplicateRefused,
                              ceng:ReplayGraphMismatchRefused,
                              ceng:ReplayProfileMismatchRefused,
                              ceng:ReplaySymbolTableMismatchRefused,
                              ceng:ReplayAdmissionTableMismatchRefused,
                              ceng:ReplayRouteDecisionMismatchRefused .

