    math:definedIn math:prop_topology .

math:sym_Geo
    a math:Symbol ;
    math:latex "\\Gamma" ;
    math:definedIn math:def_branch .

math:sym_ca
    a math:Symbol ;
    math:latex "\\mathsf{ca}" ;
    math:definedIn math:prop_topology .

math:sym_chainH
    a math:Symbol ;
    math:latex "\\mathsf{H}" ;
    math:definedIn math:con_fablechain .

math:sym_fr
    a math:Symbol ;
