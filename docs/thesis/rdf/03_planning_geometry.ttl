    math:latex "\\bm x" ;
    math:definedIn math:def_incidence .

math:sym_Poly
    a math:Symbol ;
    math:latex "\\mathcal{P}" ;
    math:definedIn math:def_polytope .

math:sym_y
    a math:Symbol ;
    math:latex "\\bm y" ;
    math:definedIn math:thm_farkas .

math:sym_CL
    a math:Symbol ;
    math:latex "\\kappa" ;
    math:definedIn math:cor_cert .

math:sym_Fitness
    a math:Symbol ;
    math:latex "\\varphi" ;
    math:definedIn math:def_fitness .

math:sym_T
    a math:Symbol ;
    math:latex "T" ;
    math:definedIn math:def_makespan .

math:sym_CostV
    a math:Symbol ;
    math:latex "\\bm c" ;
    math:definedIn math:def_cost .

math:sym_SymId
    a math:Symbol ;
    math:latex "\\mathrm{SymId}" ;
    math:definedIn math:def_symdict .
