# Instance data extracted from docs/thesis/projection_thesis.tex
# ("The Projection Principle: A First-Principles Theory of Bounded Receipted
# Execution for a Trillion Agents Beyond One Another's Comprehension")
# against the tex-math-pack ontology (packs/tex-math-pack/ontology.ttl),
# following the structural conventions of docs/thesis/rdf/00_foundations.ttl.
#
# Extraction notes:
#  - Local names are the paper's own \label{} keys with ':' replaced by '_'.
#    math:label carries the original \label{} string verbatim.
#  - math:kind values follow the paper's own \newtheorem declarations:
#    axiom, construction, definition, theorem, proposition, corollary.
#  - Only \label{}led theorem-environments are extracted as math:Statement
#    individuals, per the instruction to extract "statement + label". Eight
#    environments (attention balance, attention-conservation proposition,
#    cost vector, state-equation/reachability-cone definition,
#    conformance-membership proposition, fitness-as-distance definition,
#    unit-fitness theorem, self-audited-scale proposition) originally carried
#    no \label{} in the source; labels (\label{def:attnbalance},
#    \label{prop:attnconservation}, \label{def:costvector},
#    \label{def:reachcone}, \label{prop:conformembership},
#    \label{def:fitnessdistance}, \label{thm:unitfitness},
#    \label{prop:selfauditedscale}) have since been authored directly onto
#    their \begin{...} lines in projection_thesis.tex so they are now
#    addressable citation targets, extracted below.
#  - dependsOn/justification edges only ever target math:Statement
#    individuals, per check_citations.py's citation-closure requirement.
#  - Flagged UNRESOLVED steps:
#      * proof_thm_rice step 1 rests on the external bibitem rice1953
#        (Rice's 1953 theorem), not an in-paper Statement; ax:obs is the
#        nearest in-paper Statement (it fixes the domain Rice's theorem is
#        specialized to) and is used as the justification target, with the
#        true citation recorded here as unresolved.
#      * proof_thm_lex step 1 now cites def:costvector (its label was
#        authored as part of this pass); step 2 ("ties map to equality") is
#        a trivial closing remark resting on elementary real-analysis
#        manipulation, not on any earlier in-paper Statement, so thm:lex
#        self-references as the closest citable target and the true
#        grounding is recorded as unresolved.
#      * proof_prop_planetary steps for parts (b) and (c) are engineering
#        estimates the paper itself flags as "not claimed as theorems" and
#        rest on hardware/workload assumptions external to any in-paper
#        Statement; con:agent8 (the construction being measured) is used as
#        the nearest justification target and the estimate basis is recorded
#        as unresolved.

@prefix math: <http://seanchatmangpt.github.io/packs/tex-math#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ===========================================================================
# Statements (axiom/definition/construction/theorem/proposition/corollary)
# ===========================================================================

math:ax_obs
    a math:Statement ;
    math:kind "axiom" ;
    math:label "ax:obs" ;
    math:statement "There is a set $\\Obs$, the observation space, whose elements are arbitrary finite records: logs, agent outputs, sensor frames, claims, tool responses. $\\Obs$ carries no decidable semantics: ``does this observation mean what it purports to mean'' is not assumed computable." .

math:thm_rice
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:rice" ;
    math:statement "Let $P$ be any non-trivial semantic property of the meanings observations may encode. Then $\\{o\\in\\Obs : P(o)\\}$ is undecidable." ;
    math:dependsOn math:ax_obs .

math:def_adm
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:adm" ;
    math:statement "Fix a decidable $\\Adm\\subseteq\\Obs$ on which a finite battery of obligations $g_1,\\dots,g_m:\\Obs\\to\\{0,1\\}$ is computable. The admission map is the partial retraction $\\adm:\\Obs\\rightharpoonup\\Adm\\cup\\{\\Rfsl\\}$, $\\adm(o)=\\rho(o)\\in\\Adm$ if $\\bigwedge_i g_i(o)=1$, else $\\Rfsl$, with $\\rho$ a computable bounding/normalization and $\\Rfsl$ the distinguished refusal. Admission is idempotent on its image: $\\adm\\circ\\adm=\\adm$." ;
    math:dependsOn math:thm_rice .

math:con_denial
    a math:Statement ;
    math:kind "construction" ;
    math:label "con:denial" ;
    math:statement "Let $D=(\\{0,1\\}^n,\\lor,\\bm 0)$ be the commutative idempotent monoid of denial words: $n$ independent lanes, componentwise OR, identity $\\bm 0$. Each obligation $g_i$ contributes a lane map $d_i:\\Obs\\to\\{0,1\\}^n$ with $d_i(o)=\\bm 0\\iff g_i(o)=1$. The total denial is $d(o)=\\bigvee_i d_i(o)$, and $\\adm(o)\\ne\\Rfsl\\iff d(o)=\\bm 0$." ;
    math:dependsOn math:def_adm .

math:prop_semilattice
    a math:Statement ;
    math:kind "proposition" ;
    math:label "prop:semilattice" ;
    math:statement "$(\\{0,1\\}^n,\\lor)$ is the join-semilattice of $2^{[n]}$ with bottom $\\bm 0$. Adding obligations only enlarges denials: for $G'\\supseteq G$, $d_{G'}(o)\\succeq d_G(o)$, so $\\{o:\\adm_{G'}(o)\\ne\\Rfsl\\}\\subseteq\\{o:\\adm_G(o)\\ne\\Rfsl\\}$." ;
    math:dependsOn math:con_denial .

math:def_mu
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:mu" ;
    math:statement "$\\muop:\\Adm\\to\\Act$ is a deterministic computable map subject to (M1) determinism/reproducibility: $\\muop(x)$ depends only on $x$, equal admitted inputs give bit-identical artifacts; and (M2) boundedness: $\\muop$ factors through a representation of size bounded by fixed structural constants, so $\\muop$ terminates with a priori bounded cost. The Chatman equation is $\\Act=\\muop(\\Adm)$, operationally $a=\\muop(\\adm(o))$ when $\\adm(o)\\ne\\Rfsl$, and $\\muop(\\Rfsl)=\\Rfsl$." ;
    math:dependsOn math:def_adm .

math:def_receipt
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:receipt" ;
    math:statement "Fix a collision-resistant hash $\\chainH:\\{0,1\\}^*\\to\\{0,1\\}^{256}$ and write $\\dg(\\cdot)=\\chainH(\\cdot)$. For a manufacture with admitted observation $x=\\adm(o)$, obligation set $G$ with denial word $d(o)$, transition identity $\\tau$, artifact $a=\\muop(x)$, replay result $\\Fitness$, refusal reason $r$, and implementation version $v$, the frame is $\\mathsf{fr}=\\langle\\dg(x),\\dg(G),d(o),\\tau,\\dg(a),\\Fitness,r,v\\rangle$, and the chained receipt advances by $h_{+}=\\chainH(h_{-}\\Vert\\mathsf{fr})$. The receipt projection is $\\Proj:\\Sigma\\to\\Recs$, $\\Proj(\\sigma)=(\\text{verdict},h_{+},\\Fitness,r)$, a tuple of at most $\\CL$ chunks." ;
    math:dependsOn math:def_mu .

math:thm_faithful
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:faithful" ;
    math:statement "The receipt is faithful to lawful consequence exactly to the extent the frame commits its fields: for any committed field $\\phi\\in\\{\\dg(x),\\dg(G),d(o),\\tau,\\dg(a),\\Fitness,r,v\\}$, producing a trace $\\sigma'$ that differs in $\\phi$ yet matches the claimed $h_+$ requires a collision of $\\chainH$; under collision resistance a verifier who recomputes the chain rejects any such $\\sigma'$ except with negligible probability. Conversely, fields not committed by the frame are not attested." ;
    math:dependsOn math:def_receipt .

math:cor_noncomp
    a math:Statement ;
    math:kind "corollary" ;
    math:label "cor:noncomp" ;
    math:statement "An accepting verifier's predicate factors as $\\mathrm{Verify}=V\\circ\\Proj$ for a fixed $V:\\Recs\\to\\{0,1\\}$ of input size $\\le\\CL$. Trust in the accept is a function of the $\\CL$-sized projection and the soundness of $V$, not of any agent's comprehension of $\\sigma$." ;
    math:dependsOn math:thm_faithful .

math:thm_conservation
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:conservation" ;
    math:statement "(i) Causation: every actuated artifact $a$ is the image of at least one admitted observation, $a\\in\\im\\muop$, and no $a\\notin\\im\\muop$ is actuated. (ii) Position uniqueness: each actuation appends exactly one receipt-chain position; the map $\\text{actuation}\\mapsto h_+$ is injective up to hash collision. (iii) Observation recoverability / commitment: if $\\muop$ is injective on $\\Adm$, the artifact determines the admitted observation (recoverability); otherwise, when the frame commits $\\dg(x)$, the receipt position uniquely commits to $(\\dg(x),\\dg(G),\\tau,\\dg(a))$ (commitment, not semantic recovery)." ;
    math:dependsOn math:def_adm ;
    math:dependsOn math:def_mu ;
    math:dependsOn math:def_receipt ;
    math:dependsOn math:thm_faithful .

math:def_regimes
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:regimes" ;
    math:statement "For a trace of $n$ committed frames: boundary projection inspection (any verifier, per message) costs $O(\\CL)$; single frame recomputation (spot check) costs $O(1)$ per frame; checkpointed/indexed replay (sampled audit) costs $O(\\log n)$ or bounded path; full chain replay (full audit) costs $O(n)$." ;
    math:dependsOn math:def_receipt .

math:def_attnbalance
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:attnbalance" ;
    math:statement "Let $c(t)\\ge0$ be capacity and admitted action $j$ draw rate $r_j\\ge0$ on $[s_j,e_j]$. Free capacity is $f(t)=c(t)-\\sum_{j:\\,t\\in[s_j,e_j]}r_j$. A schedule is feasible iff $f(t)\\ge0$ for all $t$." ;
    math:dependsOn math:def_adm .

math:prop_attnconservation
    a math:Statement ;
    math:kind "proposition" ;
    math:label "prop:attnconservation" ;
    math:statement "Total attention $\\int_0^T\\!\\sum_j r_j\\mathbf 1_{[s_j,e_j]}(t)\\,dt=\\sum_j r_j(e_j-s_j)$ is independent of ordering. Reordering redistributes \\emph{when} attention is spent, not \\emph{how much}; the optimization target is the makespan functional $T[\\cdot]$ under precedence and the pointwise capacity constraint." ;
    math:dependsOn math:def_attnbalance .

math:def_costvector
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:costvector" ;
    math:statement "Assign a plan $\\bm c=(c_0,c_1,\\dots,c_k)$, $c_0\\in\\{0,1\\}$ the unadmitted indicator ($0=$ admitted), $c_1,\\dots,c_k$ bounded secondary costs. Order by lexicographic $\\preceq_{\\mathrm{lex}}$." ;
    math:dependsOn math:def_adm .

math:thm_gap
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:gap" ;
    math:statement "Let $\\mathrm{Comp}(\\sigma)=\\Theta(\\dim\\Sigma)$ be the cost of comprehending the interior and $\\mathrm{Ver}_{\\partial}(\\sigma)=O(\\CL)$ the cost of boundary verification of $\\Proj(\\sigma)$. Then $\\mathrm{Comp}(\\sigma)/\\mathrm{Ver}_{\\partial}(\\sigma)=\\Omega(\\dim\\Sigma/\\CL)\\to\\infty$ as $\\dim\\Sigma\\to\\infty$, while boundary verification stays constant; replay and full audit honestly cost $O(n)$, reducible to $O(\\log n)$ under checkpoint indexing." ;
    math:dependsOn math:def_regimes ;
    math:dependsOn math:cor_noncomp .

math:thm_lex
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:lex" ;
    math:statement "With $C_\\lambda(\\bm c)=\\sum_{i=0}^k\\lambda^{k-i}c_i$, $\\lambda>1$, $|c_i|\\le M$: there is $\\Lambda$ with $\\bm c\\preceq_{\\mathrm{lex}}\\bm c'\\iff C_\\lambda(\\bm c)\\le C_\\lambda(\\bm c')$ for all $\\lambda>\\Lambda$. As $\\lambda\\to\\infty$ the lawfulness coordinate's weight diverges." ;
    math:dependsOn math:def_costvector .

math:def_reachcone
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:reachcone" ;
    math:statement "Let $N\\in\\mathbb Z^{p\\times|T|}$ have columns $\\bm\\delta_t=\\bm m^+_t-\\bm m^-_t$. A firing sequence with Parikh vector $\\bm x\\ge0$ reaches $\\bm m=\\bm m_0+N\\bm x$. The reachable set lies in the integer points of $\\bm m_0+\\operatorname{cone}(N)$." .

math:prop_conformembership
    a math:Statement ;
    math:kind "proposition" ;
    math:label "prop:conformembership" ;
    math:statement "A trace with Parikh vector $\\bm x$ is conformant only if its marking lies in $\\mathcal P=\\{\\bm m_0+N\\bm x:\\bm x\\ge\\bm0\\}\\cap\\{\\bm m\\ge\\bm0\\}$. If $\\bm m^\\dagger\\notin\\mathcal P$, Farkas' lemma yields $\\bm y$ with $\\bm y^\\top N\\le\\bm0$ and $\\bm y^\\top(\\bm m^\\dagger-\\bm m_0)>0$: a certificate of nonconformance." ;
    math:dependsOn math:def_reachcone .

math:def_fitnessdistance
    a math:Statement ;
    math:kind "definition" ;
    math:label "def:fitnessdistance" ;
    math:statement "$\\Fitness(\\sigma)=1-\\dfrac{\\text{tokens consumed on unenabled transitions}}{\\text{tokens the replay attempted to consume}}\\in[0,1]$; $\\Fitness=1$ iff the replay never forced a disabled firing, and $1-\\Fitness$ is a normalized $\\ell^1$ excursion outside the enabled set." ;
    math:dependsOn math:prop_conformembership .

math:thm_unitfitness
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:unitfitness" ;
    math:statement "A trace is a firing sequence iff $\\Fitness=1$. If $\\Fitness<1$, the first frame forcing an unenabled consumption is a coordinate-localized witness $t^\\star$." ;
    math:dependsOn math:def_fitnessdistance ;
    math:dependsOn math:prop_conformembership .

math:thm_sep
    a math:Statement ;
    math:kind "theorem" ;
    math:label "thm:sep" ;
    math:statement "A sound, separable workflow net admits a recursive decomposition into a POWL~2.0 model whose every node is a choice graph (all exclusive/cyclic logic) or a partial order (all concurrent logic); each node's local marking geometry has dimension bounded by its arity, independent of global net size." ;
    math:dependsOn math:def_adm .

math:con_agent8
    a math:Statement ;
    math:kind "construction" ;
    math:label "con:agent8" ;
    math:statement "Project each agent to a status byte $b\\in\\{0,1\\}^8$ whose lanes name admitted, evidence-ok, within-budget, authority-bound, healthy, conformant, receipted, replayable. A fleet of $N$ agents is a bit-packed vector; a $64$-bit word holds $8$ agents; a fleet admission sweep is the branchless mask reduction of the denial construction applied word-parallel." ;
    math:dependsOn math:con_denial .

math:prop_planetary
    a math:Statement ;
    math:kind "proposition" ;
    math:label "prop:planetary" ;
    math:statement "For a fleet of $N$ agents under Construction~\\ref{con:agent8}: (a) arithmetic -- the status vector occupies exactly $N$ bytes, packed to $N/8$ 64-bit words; a full admission sweep is $N/8$ masked-OR word operations. (b) engineering estimate -- compressed status is $\\sim\\!10\\,\\mathrm{GB}$; a sweep takes $\\Theta(N/(8B))$ wall-clock. (c) order-of-magnitude estimate -- the affordability ratio between one cache-line mask op and one LLM admission decision is $\\sim\\!10^{7}$. (d) consequence, not theorem -- a comprehension-based or per-agent-LLM planetary control plane is infeasible by $\\sim\\!N\\cdot10^{7}$, while a bit-parallel admission sweep is feasible." ;
    math:dependsOn math:con_agent8 ;
    math:dependsOn math:thm_gap .

math:prop_selfauditedscale
    a math:Statement ;
    math:kind "proposition" ;
    math:label "prop:selfauditedscale" ;
    math:statement "Let a system emit claims $c$ with receipts $r(c)$, and define the overclaim set $\\mathrm{Over}=\\{c:\\nexists\\,r(c)\\text{ with }V(\\Proj)=1\\}$. If the system enforces $\\mathrm{Over}=\\varnothing$ (the \\textsf{docs-exceed-mechanism} defect class), the admissible magnitude of a claim is bounded by the mechanism that receipts its limits, not by rhetoric." ;
    math:dependsOn math:thm_gap ;
    math:dependsOn math:cor_noncomp .

# ===========================================================================
# Proofs
# ===========================================================================

math:proof_thm_rice
    a math:Proof ;
    math:proves math:thm_rice ;
    math:step math:proof_thm_rice_s1 .

math:proof_thm_rice_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Rice's theorem: every non-trivial property of the language recognized by a Turing machine is undecidable. Observations are unrestricted encodings and may encode arbitrary machines; any non-trivial semantic predicate inherits undecidability by reduction from the halting problem." ;
    math:justification math:ax_obs .
# UNRESOLVED: the load-bearing citation for this step is the external
# bibitem rice1953 (Rice's 1953 theorem), not an in-paper Statement. ax:obs
# is used as the justification target because it is the nearest in-paper
# Statement (it fixes the domain Obs the reduction is stated over).

math:proof_prop_semilattice
    a math:Proof ;
    math:proves math:prop_semilattice ;
    math:step math:proof_prop_semilattice_s1, math:proof_prop_semilattice_s2 .

math:proof_prop_semilattice_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Idempotence, commutativity, associativity of $\\lor$ per coordinate; products of semilattices are semilattices." ;
    math:justification math:con_denial .

math:proof_prop_semilattice_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "$d_{G'}(o)=d_G(o)\\lor\\bigvee_{i\\in G'\\setminus G}d_i(o)\\succeq d_G(o)$, and $\\bm 0$ is the unique minimum." ;
    math:justification math:con_denial .

math:proof_thm_faithful
    a math:Proof ;
    math:proves math:thm_faithful ;
    math:step math:proof_thm_faithful_s1, math:proof_thm_faithful_s2, math:proof_thm_faithful_s3, math:proof_thm_faithful_s4 .

math:proof_thm_faithful_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Each field appears as an argument to $\\chainH$ inside $\\mathsf{fr}$, and $h_-$ commits all predecessors recursively, so $h_+$ is a function of every committed field of the entire causal history." ;
    math:justification math:def_receipt .

math:proof_thm_faithful_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "If $\\sigma'$ differs in a committed $\\phi$ but the recomputed chain equals the claimed $h_+$, then some application of $\\chainH$ took distinct inputs to equal outputs -- a collision -- which has negligible probability." ;
    math:justification math:def_receipt .

math:proof_thm_faithful_s3
    a math:ProofStep ;
    math:order 3 ;
    math:claim "If $\\sigma'$ differs only in a field absent from $\\mathsf{fr}$, the chain is unchanged and the difference is, correctly, not attested: the theorem claims faithfulness precisely over committed fields, no more." ;
    math:justification math:def_receipt .

math:proof_thm_faithful_s4
    a math:ProofStep ;
    math:order 4 ;
    math:claim "Drop $\\dg(x)$ or $d(o)$ from the frame and the same proof yields only byte-tamper-evidence, establishing that lawfulness attestation requires the law-bearing commitments." ;
    math:justification math:def_receipt .

math:proof_thm_conservation
    a math:Proof ;
    math:proves math:thm_conservation ;
    math:step math:proof_thm_conservation_s1, math:proof_thm_conservation_s2, math:proof_thm_conservation_s3 .

math:proof_thm_conservation_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Actuation is gated by the Chatman equation: $a$ actuates only if $a=\\muop(x)$, $x=\\adm(o)\\ne\\Rfsl$; thus $\\im\\muop$ exhausts the actuated set and its complement never actuates. 'At least one' is all determinism yields, since $\\muop$ need not be injective." ;
    math:justification math:def_mu .

math:proof_thm_conservation_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "The chain appends one position per manufacture; distinct positions with equal $h_+$ force a collision." ;
    math:justification math:thm_faithful .

math:proof_thm_conservation_s3
    a math:ProofStep ;
    math:order 3 ;
    math:claim "If $\\muop$ is injective on $\\Adm$, then $a=\\muop(x)$ determines $x$ outright -- recoverability. Otherwise, because $\\mathsf{fr}$ contains $\\dg(x)$, the frame -- hence $h_+$ -- commits the observation digest; by collision resistance no second $x'$ with $\\dg(x')\\ne\\dg(x)$ shares the position, so the receipt uniquely commits to the digest tuple." ;
    math:justification math:def_receipt .

math:proof_thm_gap
    a math:Proof ;
    math:proves math:thm_gap ;
    math:step math:proof_thm_gap_s1, math:proof_thm_gap_s2, math:proof_thm_gap_s3 .

math:proof_thm_gap_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "$\\mathrm{Ver}_\\partial$ reads $\\Proj(\\sigma)$ of size $\\le\\CL$ and applies $V$: $O(\\CL)$." ;
    math:justification math:cor_noncomp .

math:proof_thm_gap_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "$\\mathrm{Comp}$ must ingest the interior of size $\\Theta(\\dim\\Sigma)$. The ratio diverges." ;
    math:justification math:def_regimes .

math:proof_thm_gap_s3
    a math:ProofStep ;
    math:order 3 ;
    math:claim "The scope clause restates the verification-regimes definition: mechanical replay is $O(n)$, not $O(1)$; the constant-cost claim is confined to boundary inspection." ;
    math:justification math:def_regimes .

math:proof_thm_lex
    a math:Proof ;
    math:proves math:thm_lex ;
    math:step math:proof_thm_lex_s1, math:proof_thm_lex_s2 .

math:proof_thm_lex_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "If $\\bm c\\prec_{\\mathrm{lex}}\\bm c'$ they first differ at $p$ with $c'_p-c_p\\ge\\epsilon>0$; then $C_\\lambda(\\bm c')-C_\\lambda(\\bm c)\\ge\\lambda^{k-p}\\epsilon-2M\\sum_{i>p}\\lambda^{k-i}$, positive once $\\lambda>\\Lambda=1+2Mk/\\epsilon$." ;
    math:justification math:def_costvector .

math:proof_thm_lex_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "Ties map to equality." ;
    math:justification math:thm_lex .
# UNRESOLVED: same basis as step 1 -- no earlier in-paper Statement grounds
# this trivial closing remark.

math:proof_prop_planetary
    a math:Proof ;
    math:proves math:prop_planetary ;
    math:step math:proof_prop_planetary_s1, math:proof_prop_planetary_s2, math:proof_prop_planetary_s3 .

math:proof_prop_planetary_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "(a) is counting: the status vector occupies exactly $N$ bytes by construction of the per-agent status byte." ;
    math:justification math:con_agent8 .

math:proof_prop_planetary_s2
    a math:ProofStep ;
    math:order 2 ;
    math:claim "(b),(c) are estimates and are marked as such; they depend on hardware and workload and are not claimed as theorems." ;
    math:justification math:con_agent8 .
# UNRESOLVED: parts (b)/(c) rest on stated hardware/workload assumptions
# external to any in-paper Statement; con:agent8 (the construction being
# measured) is the nearest citable target, not a true derivation source.

math:proof_prop_planetary_s3
    a math:ProofStep ;
    math:order 3 ;
    math:claim "(d) is the engineering consequence of composing (a) with the Fleet Trust Budget corollary: per-message cost $O(\\CL)$ versus $\\Omega(\\dim\\Sigma)$ for comprehension, scaled by $N$. No part of this proposition asserts a mathematical impossibility; it asserts an economic separation under stated estimates." ;
    math:justification math:thm_gap .

math:proof_prop_attnconservation
    a math:Proof ;
    math:proves math:prop_attnconservation ;
    math:step math:proof_prop_attnconservation_s1 .

math:proof_prop_attnconservation_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Linearity of the integral; each $r_j(e_j-s_j)$ depends only on $j$'s duration and rate." ;
    math:justification math:def_attnbalance .

math:proof_prop_conformembership
    a math:Proof ;
    math:proves math:prop_conformembership ;
    math:step math:proof_prop_conformembership_s1 .

math:proof_prop_conformembership_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Membership is the state equation with $\\bm x\\ge0$; Farkas applied to $N\\bm x=\\bm m^\\dagger-\\bm m_0,\\ \\bm x\\ge0$ gives either a nonnegative solution or the separating $\\bm y$." ;
    math:justification math:def_reachcone .

math:proof_thm_unitfitness
    a math:Proof ;
    math:proves math:thm_unitfitness ;
    math:step math:proof_thm_unitfitness_s1 .

math:proof_thm_unitfitness_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Enabled firings never force consumption, giving numerator $0$ and, inductively, a genuine firing sequence within $\\mathcal P$. A disabled event records a forced consumption at the earliest index $t^\\star$, making the numerator positive." ;
    math:justification math:def_fitnessdistance .

math:proof_prop_selfauditedscale
    a math:Proof ;
    math:proves math:prop_selfauditedscale ;
    math:step math:proof_prop_selfauditedscale_s1 .

math:proof_prop_selfauditedscale_s1
    a math:ProofStep ;
    math:order 1 ;
    math:claim "Every admissible claim has a faithful receipt, verifiable at $O(\\CL)$; a claim lacking one is in $\\mathrm{Over}$ and rejected by the invariant. Admissible claims are exactly receipted claims." ;
    math:justification math:thm_gap .

