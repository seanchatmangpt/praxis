---
to: generated/f15_air_transition_core_generated.rs
sparql:
  states: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX air: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/air-core#> SELECT ?label ?order ?realizedBy WHERE { ?s a air:LifecycleState ; rdfs:label ?label ; air:realizedBy ?realizedBy . OPTIONAL { ?s air:stateOrder ?order } } ORDER BY ?label"
  refusals: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX air: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/air-core#> SELECT ?label ?meaning ?sourceCitation ?status WHERE { ?r a air:RefusalKind ; rdfs:label ?label ; air:meaning ?meaning ; air:sourceCitation ?sourceCitation ; air:status ?status } ORDER BY ?label"
  provs: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX air: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/air-core#> SELECT ?label ?order ?derivedFromLabel ?mirrorsField WHERE { ?p a air:ProvEntity ; rdfs:label ?label ; air:provOrder ?order ; air:derivedFromLabel ?derivedFromLabel ; air:mirrorsField ?mirrorsField } ORDER BY ?order"
skip_if: "ggen:local-override"
---
// F15 AIR Single Semantic Core (V12-015) -- GENERATED by `ggen sync` from
// `packs/f15-air-core-pack/ontology.ttl` (`air:LifecycleState`,
// `air:RefusalKind`, and `air:ProvEntity` individuals). Do not edit by
// hand: this file is a pure data projection of the ontology -- citation
// and cross-check catalogs, never AIR transition logic. The real
// transition semantics (readiness, expression evaluation, criteria,
// routing) live in apps/air_core/src/air_core.erl and are neither
// reimplemented nor re-derived here. `f15_air_transition_core.rs`
// `include!`s this file -- a plain `//` comment, not a `//!` inner doc
// comment, because `include!` splices these tokens in after
// `f15_air_transition_core.rs`'s own `use` items, where an inner doc
// comment is not legal (E0753).
//
// Regenerate from a scratch ggen project referencing this pack (does not
// touch the shared root `ggen.toml`), e.g.:
// ```text
// mkdir -p /tmp/f15-ggen-scratch/templates
// cat > /tmp/f15-ggen-scratch/ggen.toml <<'EOF'
// [project]
// name = "f15-ggen-scratch"
// [ontology]
// source = "/Users/sac/praxis/packs/f15-air-core-pack/ontology.ttl"
// [packs]
// f15-air-core-pack = { path = "/Users/sac/praxis/packs/f15-air-core-pack" }
// [templates]
// dir = "templates"
// EOF
// (cd /tmp/f15-ggen-scratch && ggen sync run)
// cp /tmp/f15-ggen-scratch/generated/f15_air_transition_core_generated.rs \
//    /Users/sac/praxis/crates/multifractal-workflow/src/
// ```

/// One named state of the F15 8-state AIR transition lifecycle
/// (`air:LifecycleState`), plus the parallel `REFUSED` terminal (which
/// carries no `state_order`, so `order` is `None` for it).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct LifecycleStateCatalogEntry {
    pub name: &'static str,
    pub state_order: Option<u8>,
    /// Honest citation of the real code (if any) that performs this
    /// stage's work today -- see the ontology's own doc comment for why
    /// this is not auto-derived from the Rust or Erlang source.
    pub realized_by: &'static str,
}

/// The 8-state lifecycle plus `REFUSED`, in `rdfs:label` alphabetical
/// order (NOT chain order -- see [`AirLifecycleState::CHAIN_ORDER`] in
/// `f15_air_transition_core.rs` for the ordered ladder;
/// `lifecycle_catalog_matches_enum_variants` below cross-checks this
/// catalog's names against the hand-written `AirLifecycleState` enum by
/// set membership, not position).
pub const LIFECYCLE_STATE_CATALOG: &[LifecycleStateCatalogEntry] = &[
{% for s in states %}    LifecycleStateCatalogEntry {
        name: "{{ s.label }}",
        state_order: {% if s.order %}Some({{ s.order }}){% else %}None{% endif %},
        realized_by: "{{ s.realizedBy }}",
    },
{% endfor %}];

/// One catalogued `AIRTransitionRefused` variant (`air:RefusalKind`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RefusalCatalogEntry {
    pub name: &'static str,
    pub meaning: &'static str,
    pub source_citation: &'static str,
    pub status: &'static str,
}

/// The full `AIRTransitionRefused` catalog, alphabetical by variant name.
/// `refusal_catalog_matches_enum_variants` in `f15_air_transition_core.rs`
/// cross-checks this catalog's names against the hand-written
/// `AIRTransitionRefused` enum so the two cannot silently drift.
pub const REFUSAL_CATALOG: &[RefusalCatalogEntry] = &[
{% for r in refusals %}    RefusalCatalogEntry {
        name: "{{ r.label }}",
        meaning: "{{ r.meaning }}",
        source_citation: "{{ r.sourceCitation }}",
        status: "{{ r.status }}",
    },
{% endfor %}];

/// One node of the F15 L6 PROV-linked data model (`air:ProvEntity`,
/// `AIRProgram -> ... -> TransitionReceipt`, chain order 0-7).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ProvEntityCatalogEntry {
    pub name: &'static str,
    pub prov_order: u8,
    /// `rdfs:label` of this entity's `prov:wasDerivedFrom` predecessor, or
    /// `""` for the chain root (`AIRProgram`).
    pub derived_from: &'static str,
    /// Which real `air_core.erl` / `arazzo_event_receipt.hrl` field this
    /// entity corresponds to.
    pub mirrors_field: &'static str,
}

/// The fixed 8-entity PROV chain, in chain order.
pub const PROV_CHAIN: &[ProvEntityCatalogEntry] = &[
{% for p in provs %}    ProvEntityCatalogEntry {
        name: "{{ p.label }}",
        prov_order: {{ p.order }},
        derived_from: "{{ p.derivedFromLabel }}",
        mirrors_field: "{{ p.mirrorsField }}",
    },
{% endfor %}];
