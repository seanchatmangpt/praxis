# f16-otp-runner-pack ontology -- V12-016 (F16 "Erlang OTP Outer Runner").
#
# Scope, stated honestly per the F16 family survey's own GGEN_GENERATABLE
# finding: this pack generates ONLY the narrow structural/vocabulary slice the
# survey identified as mechanically generatable -- a table of the 7 refusal
# atoms `arazzo_runner_broker.erl`/`arazzo_runner_workflow.erl` already raise
# for real (with a triggerable negative test each, per the survey's
# justification), the 3 literal L8 claim-ceiling marker names named by the
# atlas, and 3 named HAND_WRITE_REQUIRED gaps this session re-confirmed
# genuinely absent by direct grep of apps/arazzo_runner/. It does NOT generate
# any admission-chain, lifecycle, or receipt LOGIC -- none of that exists in
# Rust and none of it is proposed here; the real logic for the 7 refusal atoms
# lives entirely in Erlang (apps/arazzo_runner/src/arazzo_runner_broker.erl,
# arazzo_runner_workflow.erl) and stays there. This pack's Rust output is a
# typed, cross-checkable *parallel vocabulary*, not a functional port.
#
# Every erlangAtom/sourceModule/sourceSite/stage value below was verified by
# directly reading the cited Erlang source this session (not inferred or
# copied from the prior survey text without re-checking) -- see
# f16_otp_runner.rs's own doc comment and tests for the exact grep/read
# evidence tying each individual back to real, checked-out source.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix otp:    <https://ggen.io/ontology/otp-runner#> .

#################################################################
# Vocabulary
#################################################################

otp: a owl:Ontology ;
  rdfs:label "multifractal-workflow F16 OTP Outer Runner vocabulary" ;
  rdfs:comment "Typed-refusal-atom and claim-marker vocabulary paralleling apps/arazzo_runner's real, tested Erlang refusal atoms and the atlas's L8 claim-ceiling marker names (V12-016)." .

otp:RefusalAtom a rdfs:Class ;
  rdfs:label "Refusal atom" ;
  rdfs:comment "One real, triggerable {refused, Atom, Context} outcome already raised by apps/arazzo_runner's Erlang source." .

otp:variantName    a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:string ; rdfs:comment "PascalCase Rust enum variant name for this atom." .
otp:erlangAtom      a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:string ; rdfs:comment "The literal Erlang atom, exactly as spelled in source (e.g. 'CORRELATION_MISSING')." .
otp:sourceModule    a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:string ; rdfs:comment "Erlang module (without .erl) that raises this atom." .
otp:sourceSite      a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:string ; rdfs:comment "Function/arity within sourceModule that raises this atom." .
otp:stage           a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:string ; rdfs:comment "The PRD 8/13 stage tag Erlang itself attaches in the refusal's context map (stage => ...), or 'actuation_route' for the PRD 13 direct-actuation gate, which is outside the 6-stage return-admission chain." .
otp:ordinal         a rdf:Property ; rdfs:domain otp:RefusalAtom ; rdfs:range xsd:integer .

otp:ClaimMarker a rdfs:Class ;
  rdfs:label "L8 claim marker" ;
  rdfs:comment "One of the 3 named boolean markers the F16 atlas's claim ceiling gates on. New vocabulary: grepped zero hits anywhere in this repo before this pack (see f16_otp_runner.rs tests)." .

otp:markerName  a rdf:Property ; rdfs:domain otp:ClaimMarker ; rdfs:range xsd:string .
otp:markerOrdinal a rdf:Property ; rdfs:domain otp:ClaimMarker ; rdfs:range xsd:integer .

otp:HandWriteGap a rdfs:Class ;
  rdfs:label "Disclosed hand-write gap" ;
  rdfs:comment "A component or state-machine element the atlas requires that this session re-confirmed absent from apps/arazzo_runner/ by direct grep -- tracked, not silently skipped." .

otp:gapName     a rdf:Property ; rdfs:domain otp:HandWriteGap ; rdfs:range xsd:string .
otp:gapOrdinal  a rdf:Property ; rdfs:domain otp:HandWriteGap ; rdfs:range xsd:integer .

#################################################################
# Refusal atoms (7 of 8 named in the broker/correlation catalog; the 8th,
# RETURN_SEMANTIC_REFUSED, is deliberately excluded -- it is a disclosed,
# genuinely unenforced gap in arazzo_runner_broker.erl (admit_return_semantic/1
# always calls admit_return_ok/1; the uppercase atom is never constructed
# anywhere in source, only named in comments), so including it here would
# misrepresent it as a real, triggerable outcome like the other 7.)
#################################################################

otp:correlationMissing a otp:RefusalAtom ;
  otp:variantName "CorrelationMissing" ; otp:erlangAtom "CORRELATION_MISSING" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "dispatch/4" ;
  otp:stage "preactuation" ; otp:ordinal 0 ;
  rdfs:comment "Identity#workflow_identity.correlation_id is missing/empty at dispatch time." .

otp:brokerReceiptPreconditionMissing a otp:RefusalAtom ;
  otp:variantName "BrokerReceiptPreconditionMissing" ; otp:erlangAtom "BROKER_RECEIPT_PRECONDITION_MISSING" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "check_required_prior_receipts/5" ;
  otp:stage "preactuation" ; otp:ordinal 1 ;
  rdfs:comment "Identity#workflow_identity.receipt_head is missing/empty: no prior receipt chain attached to this workflow instance." .

otp:correlationMismatch a otp:RefusalAtom ;
  otp:variantName "CorrelationMismatch" ; otp:erlangAtom "CORRELATION_MISMATCH" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "admit_return/3" ;
  otp:stage "correlation" ; otp:ordinal 2 ;
  rdfs:comment "A known dispatch_token's returner-claimed CorrelationId does not match the ledger's recorded correlation_id." .

otp:returnProvenanceMissing a otp:RefusalAtom ;
  otp:variantName "ReturnProvenanceMissing" ; otp:erlangAtom "RETURN_PROVENANCE_MISSING" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "admit_return_provenance/2" ;
  otp:stage "provenance" ; otp:ordinal 3 ;
  rdfs:comment "Ledger entry status is 'dispatched' or 'dispatch_failed': no consequence was ever actuated to have provenance over." .

otp:returnAuthorityRefused a otp:RefusalAtom ;
  otp:variantName "ReturnAuthorityRefused" ; otp:erlangAtom "RETURN_AUTHORITY_REFUSED" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "admit_return_authority/2" ;
  otp:stage "authority" ; otp:ordinal 4 ;
  rdfs:comment "Returner-supplied ReturnerAuthorityToken does not match the one-shot return_authority_token minted for this dispatch." .

otp:returnStructureRefused a otp:RefusalAtom ;
  otp:variantName "ReturnStructureRefused" ; otp:erlangAtom "RETURN_STRUCTURE_REFUSED" ;
  otp:sourceModule "arazzo_runner_broker" ; otp:sourceSite "admit_return_structure/1" ;
  otp:stage "structure" ; otp:ordinal 5 ;
  rdfs:comment "raw_consequence does not conform to the step's own declared output bind-rule types (required_result_types)." .

otp:directActuationRefused a otp:RefusalAtom ;
  otp:variantName "DirectActuationRefused" ; otp:erlangAtom "DIRECT_ACTUATION_REFUSED" ;
  otp:sourceModule "arazzo_runner_workflow" ; otp:sourceSite "enqueue_io/2" ;
  otp:stage "actuation_route" ; otp:ordinal 6 ;
  rdfs:comment "ActuationToken presented to enqueue_io/2 was not minted by arazzo_runner_broker:dispatch/4 (or was already consumed): the broker is the only actuation route." .

#################################################################
# L8 claim markers (3; new vocabulary, atlas-named, zero prior hits in repo)
#################################################################

otp:otpArazzoRunnerAlive a otp:ClaimMarker ;
  otp:markerName "OTP_ARAZZO_RUNNER_ALIVE" ; otp:markerOrdinal 0 ;
  rdfs:comment "Requires source+graph evidence, unit+negative fixtures, a production reachability trace, chaos/recovery evidence, and receipt/replay equivalence all present at once." .

otp:workflowProcessRestartResumes a otp:ClaimMarker ;
  otp:markerName "WORKFLOW_PROCESS_RESTART_RESUMES" ; otp:markerOrdinal 1 ;
  rdfs:comment "A killed workflow process's identity/state is reconstructed from arazzo_runner_identity's DETS persistence, not from the dead PID." .

otp:noPidSemanticIdentity a otp:ClaimMarker ;
  otp:markerName "NO_PID_SEMANTIC_IDENTITY" ; otp:markerOrdinal 2 ;
  rdfs:comment "Workflow semantic identity (workflow_id) is independent of any Erlang PID that ever executed it." .

#################################################################
# Disclosed HAND_WRITE_REQUIRED gaps (3; re-confirmed absent this session)
#################################################################

otp:genStatemLifecycleGap a otp:HandWriteGap ;
  otp:gapName "gen_statem 8-state lifecycle (MANUFACTURED..REFUSED)" ; otp:gapOrdinal 0 ;
  rdfs:comment "arazzo_runner_workflow.erl runs a plain proc_lib:spawn_link + receive loop (workflow_loop/1), not a gen_statem; none of the atlas's 8 state names appear anywhere in apps/arazzo_runner/src/*.erl or include/*.hrl (grepped, zero hits)." .

otp:dispatchWorkerSupervisorGap a otp:HandWriteGap ;
  otp:gapName "Dispatch Worker Supervisor" ; otp:gapOrdinal 1 ;
  rdfs:comment "io-worker processes are unsupervised plain spawn_link loops (arazzo_runner_workflow:io_worker_loop/0) with no dedicated restart-policy supervisor of their own." .

otp:programRegistryGap a otp:HandWriteGap ;
  otp:gapName "Program Registry" ; otp:gapOrdinal 2 ;
  rdfs:comment "No component under this name exists; only a workflow_id->Pid ETS table (a different thing) is present, and the atlas gives no further definition to build against." .
