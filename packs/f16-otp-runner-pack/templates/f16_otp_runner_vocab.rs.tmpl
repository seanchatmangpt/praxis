---
to: "crates/multifractal-workflow/src/f16_otp_runner_vocab.rs"
force: true
determinism: true
sparql:
  a_atoms: |
    PREFIX otp: <https://ggen.io/ontology/otp-runner#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?variantName ?erlangAtom ?sourceModule ?sourceSite ?stage ?comment WHERE {
      ?a a otp:RefusalAtom ; otp:variantName ?variantName ; otp:erlangAtom ?erlangAtom ;
         otp:sourceModule ?sourceModule ; otp:sourceSite ?sourceSite ; otp:stage ?stage ;
         otp:ordinal ?ordinal ; rdfs:comment ?comment .
    } ORDER BY ?ordinal
  b_markers: |
    PREFIX otp: <https://ggen.io/ontology/otp-runner#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?markerName ?comment WHERE {
      ?m a otp:ClaimMarker ; otp:markerName ?markerName ; otp:markerOrdinal ?ordinal ; rdfs:comment ?comment .
    } ORDER BY ?ordinal
  c_gaps: |
    PREFIX otp: <https://ggen.io/ontology/otp-runner#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?gapName ?comment WHERE {
      ?g a otp:HandWriteGap ; otp:gapName ?gapName ; otp:gapOrdinal ?ordinal ; rdfs:comment ?comment .
    } ORDER BY ?ordinal
---
