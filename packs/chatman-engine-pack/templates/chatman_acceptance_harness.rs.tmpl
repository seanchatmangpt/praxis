---
to: "{{ file_path }}"
force: true
determinism: true
sparql:
  a_harnesses: |
    PREFIX ceng: <https://praxis.chatman.io/ontology/ceng#>
    SELECT ?harness ?file_path ?schema_path WHERE {
      ?harness a ceng:TestHarness ;
               ceng:filePath ?file_path ;
               ceng:usesFixtureSchema ?schema .
      ?schema ceng:schemaPath ?schema_path .
    } ORDER BY ?file_path
  b_success_cases: |
    PREFIX ceng: <https://praxis.chatman.io/ontology/ceng#>
    SELECT ?harness ?case_name ?fixture_path ?expected_behavior WHERE {
      ?case a ceng:AcceptanceCase ;
            ceng:harness ?harness ;
            ceng:testFixturePath ?fixture_path ;
            ceng:expectedBehavior ?expected_behavior .
      BIND(REPLACE(STR(?case), "^.*#", "") AS ?case_name)
    } ORDER BY ?case_name
  c_falsification_cases: |
    PREFIX ceng: <https://praxis.chatman.io/ontology/ceng#>
    SELECT ?harness ?case_name ?fixture_path ?expected_refusal ?falsification_mutation WHERE {
      ?case a ceng:FalsificationCase ;
            ceng:harness ?harness ;
            ceng:testFixturePath ?fixture_path ;
            ceng:expectedRefusal ?refusal ;
            ceng:falsificationMutation ?falsification_mutation .
      ?refusal ceng:rustVariant ?expected_refusal .
      BIND(REPLACE(STR(?case), "^.*#", "") AS ?case_name)
    } ORDER BY ?case_name
  d_all_cases: |
    PREFIX ceng: <https://praxis.chatman.io/ontology/ceng#>
    SELECT ?harness ?fixture_path WHERE {
      { ?case a ceng:AcceptanceCase ; ceng:harness ?harness ; ceng:testFixturePath ?fixture_path . }
      UNION
      { ?case a ceng:FalsificationCase ; ceng:harness ?harness ; ceng:testFixturePath ?fixture_path . }
    } ORDER BY ?fixture_path
---
//! Generated by ggen from packs/chatman-engine-pack/ontology.ttl. Do not edit.
//!
//! Harness: {{ harness }}
//! Fixture schema: {{ schema_path }}

use praxis_graphlaw::chatman::Refusal;

#[path = "chatman_engine_acceptance/harness/mod.rs"]
mod harness;
{% for case_row in b_success_cases %}{% if case_row.harness == harness %}
#[test]
fn acceptance_{{ case_row.case_name | snake_case }}() {
    let fixture = concat!(
        env!("CARGO_MANIFEST_DIR"),
        "/tests/chatman_engine_acceptance/{{ case_row.fixture_path }}"
    );
    // `run_fixture` takes `&Path`; the fixture path here is a `&'static str`
    // (from `concat!`), which does not coerce to `&Path` at a call site, so
    // it is wrapped explicitly.
    let result = harness::run_fixture(std::path::Path::new(fixture));
    // `run_fixture` returns `Result<harness::AdmittedOutcome, Refusal>`, not
    // `Result<&str, Refusal>`, so the acceptance behavior tag
    // (`{{ case_row.expected_behavior }}`) is documentation carried by the
    // fixture, not a literal engine return value to pattern-match via
    // `as_deref()`. Only admission itself is asserted here.
    assert!(
        result.is_ok(),
        "acceptance case {{ case_row.case_name }} must be accepted (expected behavior: \
         `{{ case_row.expected_behavior }}`), got {result:?}"
    );
}
{% endif %}{% endfor %}
{%- for case_row in c_falsification_cases %}{% if case_row.harness == harness %}
#[test]
fn falsification_{{ case_row.case_name | snake_case }}() {
    let fixture = concat!(
        env!("CARGO_MANIFEST_DIR"),
        "/tests/chatman_engine_acceptance/{{ case_row.fixture_path }}"
    );
    let result = harness::run_fixture(std::path::Path::new(fixture));
    assert!(
        matches!(result, Err(Refusal::{{ case_row.expected_refusal }}(_))),
        "mutation {{ case_row.falsification_mutation }} must refuse with Refusal::{{ case_row.expected_refusal }}, got {result:?}"
    );
}
{% endif %}{% endfor %}
/// Deterministic OCEL evidence seal: replays every fixture of this suite
/// sequentially in sorted order on one thread and seals the suite's
/// `.cargo-cicd/ocel/chatman/<suite>.{ocel,receipt}.json` exactly once —
/// the only OCEL emission path (per-case tests above are assertion-only,
/// because their parallel interleaving would make event order racy).
#[test]
fn zz_ocel_evidence_sealed() {
    harness::seal_suite_evidence(&[
{%- for case_row in d_all_cases %}{% if case_row.harness == harness %}
        "{{ case_row.fixture_path }}",
{%- endif %}{% endfor %}
    ]);
}
