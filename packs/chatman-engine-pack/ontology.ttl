@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ceng: <https://praxis.chatman.io/ontology/ceng#> .

ceng:ChatmanEngineOntology a owl:Ontology ;
    rdfs:label "Chatman Engine Acceptance Surface"@en ;
    rdfs:comment "Ontology driving generation of the Chatman Engine acceptance test harnesses, fixtures, and GWT documentation. Version 26.7.9."@en .

#################################################################
# L1 — Vocabulary (classes and properties)
#################################################################

ceng:ExecutionRoute a owl:Class ;
    rdfs:label "Execution Route"@en .

ceng:Dialect a owl:Class ;
    rdfs:label "Semantic Dialect"@en .

ceng:CanonicalType a owl:Class ;
    rdfs:label "Canonical Type"@en .

ceng:GeneratedArtifact a owl:Class ;
    rdfs:label "Generated Artifact"@en .

ceng:GenerationDirective a owl:Class ;
    rdfs:label "Generation Directive"@en .

ceng:AcceptanceCase a owl:Class ;
    rdfs:label "Acceptance Case"@en ;
    rdfs:comment "A success-path case: the engine must accept the fixture and report the expected behavior tag."@en .

ceng:FalsificationCase a owl:Class ;
    rdfs:label "Falsification Case"@en ;
    rdfs:comment "A single-condition mutation of a paired acceptance case; the engine must refuse with the named typed Refusal."@en .

ceng:PropertyTest a owl:Class ;
    rdfs:label "Property Test"@en .

ceng:Refusal a owl:Class ;
    rdfs:label "Typed Refusal"@en .

ceng:Invariant a owl:Class ;
    rdfs:label "Invariant"@en .

ceng:TestHarness a owl:Class ;
    rdfs:label "Test Harness"@en ;
    rdfs:comment "One generated Rust integration-test file; fan-out target of the harness template."@en .

ceng:FixtureSchema a owl:Class ;
    rdfs:label "Fixture Schema"@en .

ceng:Component a owl:Class ;
    rdfs:label "Component"@en .

ceng:filePath a owl:DatatypeProperty ;
    rdfs:label "file path"@en ;
    rdfs:domain ceng:TestHarness .

ceng:schemaPath a owl:DatatypeProperty ;
    rdfs:label "schema path"@en ;
    rdfs:domain ceng:FixtureSchema .

ceng:testFixturePath a owl:DatatypeProperty ;
    rdfs:label "test fixture path"@en ;
    rdfs:comment "Path relative to crates/praxis-graphlaw/tests/chatman_engine_acceptance/."@en .

ceng:expectedBehavior a owl:DatatypeProperty ;
    rdfs:label "expected behavior tag"@en ;
    rdfs:domain ceng:AcceptanceCase .

ceng:expectedRefusal a owl:ObjectProperty ;
    rdfs:label "expected refusal"@en ;
    rdfs:domain ceng:FalsificationCase ;
    rdfs:range ceng:Refusal .

ceng:rustVariant a owl:DatatypeProperty ;
    rdfs:label "Rust Refusal variant name"@en ;
    rdfs:domain ceng:Refusal .

ceng:falsificationMutation a owl:DatatypeProperty ;
    rdfs:label "falsification mutation"@en ;
    rdfs:comment "One-sentence, single-condition mutation applied to the paired acceptance fixture."@en .

ceng:usesFixtureSchema a owl:ObjectProperty ;
    rdfs:label "uses fixture schema"@en ;
    rdfs:range ceng:FixtureSchema .

ceng:protectsInvariant a owl:ObjectProperty ;
    rdfs:label "protects invariant"@en ;
    rdfs:range ceng:Invariant .

ceng:antiHardcodeProperty a owl:DatatypeProperty ;
    rdfs:label "anti-hardcode property"@en .

ceng:generatedDataStrategy a owl:DatatypeProperty ;
    rdfs:label "generated data strategy"@en ;
    rdfs:domain ceng:PropertyTest .

ceng:inputJson a owl:DatatypeProperty ;
    rdfs:label "input JSON payload"@en ;
    rdfs:comment "Compact JSON object matching this case's harness scenario-input struct; embedded verbatim (unquoted) as the fixture's top-level \"input\" property."@en .

ceng:caseSeed a owl:DatatypeProperty ;
    rdfs:label "case seed"@en ;
    rdfs:comment "Stable hex seed derived deterministically from the case local name (blake2b digest prefix)."@en .

ceng:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:domain ceng:CanonicalType ;
    rdfs:range ceng:Component .

ceng:harness a owl:ObjectProperty ;
    rdfs:label "harness"@en ;
    rdfs:comment "Binds a case to the TestHarness file its generated test lives in."@en ;
    rdfs:range ceng:TestHarness .

ceng:falsifies a owl:ObjectProperty ;
    rdfs:label "falsifies"@en ;
    rdfs:domain ceng:FalsificationCase ;
    rdfs:range ceng:AcceptanceCase .

ceng:maxConstraints a owl:DatatypeProperty ;
    rdfs:label "max constraints"@en ;
    rdfs:domain ceng:ExecutionRoute .

ceng:defaultEnabled a owl:DatatypeProperty ;
    rdfs:label "default enabled"@en ;
    rdfs:domain ceng:Dialect .

ceng:mayActuate a owl:DatatypeProperty ;
    rdfs:label "may actuate"@en ;
    rdfs:domain ceng:Dialect .

#################################################################
# L2 — Instances (routes, dialects, canonical types, harnesses,
#      fixture schemas)
#################################################################

ceng:HotPath a ceng:ExecutionRoute ;
    rdfs:label "Hot Path"@en ;
    ceng:maxConstraints "8"^^xsd:integer .

ceng:WarmPath a ceng:ExecutionRoute ;
    rdfs:label "Warm Path"@en .

ceng:ColdPath a ceng:ExecutionRoute ;
    rdfs:label "Cold Path"@en .

ceng:RDFTriple8 a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:SHACL a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:SPARQL a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:OwlRl a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:Datalog a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:PDDL a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:POWL a ceng:Dialect ;
    ceng:defaultEnabled "true"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:N3 a ceng:Dialect ;
    ceng:defaultEnabled "false"^^xsd:boolean ;
    ceng:mayActuate "false"^^xsd:boolean .

ceng:Wasm4pmCompat a ceng:Component ;
    rdfs:label "wasm4pm compatibility layer"@en .

ceng:GraphlawCore a ceng:Component ;
    rdfs:label "praxis-graphlaw core"@en .

ceng:ProcessReceipt a ceng:CanonicalType ;
    ceng:ownedBy ceng:Wasm4pmCompat .

ceng:CanonicalTape a ceng:CanonicalType ;
    ceng:ownedBy ceng:GraphlawCore .

ceng:GraphSnapshot a ceng:CanonicalType ;
    ceng:ownedBy ceng:GraphlawCore .

ceng:ProfileHash a ceng:CanonicalType ;
    ceng:ownedBy ceng:GraphlawCore .

ceng:ReceiptsHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_receipts.rs" ;
    ceng:usesFixtureSchema ceng:ReceiptsFixtureSchema .

ceng:RoutingHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_routing.rs" ;
    ceng:usesFixtureSchema ceng:RoutingFixtureSchema .

ceng:Triple8Harness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_triple8.rs" ;
    ceng:usesFixtureSchema ceng:Triple8FixtureSchema .

ceng:AdmissionHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_admission.rs" ;
    ceng:usesFixtureSchema ceng:AdmissionFixtureSchema .

ceng:HooksHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_hooks.rs" ;
    ceng:usesFixtureSchema ceng:HooksFixtureSchema .

ceng:AgentsHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_agents.rs" ;
    ceng:usesFixtureSchema ceng:AgentsFixtureSchema .

ceng:ReplayHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_replay.rs" ;
    ceng:usesFixtureSchema ceng:ReplayFixtureSchema .

ceng:StaticHarness a ceng:TestHarness ;
    ceng:filePath "crates/praxis-graphlaw/tests/chatman_acceptance_static.rs" ;
    ceng:usesFixtureSchema ceng:StaticFixtureSchema .

ceng:ReceiptsFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/receipts_fixture.schema.json" .

ceng:RoutingFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/routing_fixture.schema.json" .

ceng:Triple8FixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/triple8_fixture.schema.json" .

ceng:AdmissionFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/admission_fixture.schema.json" .

ceng:HooksFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/hooks_fixture.schema.json" .

ceng:AgentsFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/agents_fixture.schema.json" .

ceng:ReplayFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/replay_fixture.schema.json" .

ceng:StaticFixtureSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/static_fixture.schema.json" .

ceng:CommonEnvelopeSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/common_envelope.schema.json" .

ceng:SeedManifestSchema a ceng:FixtureSchema ;
    ceng:schemaPath "crates/praxis-graphlaw/tests/chatman_engine_acceptance/schemas/seed_manifest.schema.json" .

#################################################################
# L3 — Generation directives and laws
#################################################################

ceng:GenerateAcceptanceHarnesses a ceng:GenerationDirective ;
    rdfs:comment "Fan out one Rust integration-test file per TestHarness individual from templates/chatman_acceptance_harness.rs.tmpl."@en .

ceng:GenerateAcceptanceFixtures a ceng:GenerationDirective ;
    rdfs:comment "Fan out one JSON fixture per case from templates/acceptance_fixture.json.tmpl."@en .

ceng:GenerateGwtDoc a ceng:GenerationDirective ;
    rdfs:comment "Render the Given/When/Then acceptance document from templates/chatman_gwt.md.tmpl."@en .

ceng:NoVacuousTest a ceng:Invariant ;
    ceng:antiHardcodeProperty "every generated test contains >=1 uncommented assertion" ;
    rdfs:comment "The fail-loud law: template assertion lines are unconditional literal text, so no case row can render an assert-free test."@en .

#################################################################
# L4 — Refusal individuals and paired acceptance/falsification
#      cases (seeds are blake2b(case name) hex prefixes)
#################################################################

ceng:Triple8UniverseOverflowRefusal a ceng:Refusal ;
    ceng:rustVariant "Triple8UniverseOverflow" .

ceng:TermNotInTriple8UniverseRefusal a ceng:Refusal ;
    ceng:rustVariant "TermNotInTriple8Universe" .

ceng:WarmPathRequiredRefusal a ceng:Refusal ;
    ceng:rustVariant "WarmPathRequired" .

ceng:ProfileSymbolTableMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "ProfileSymbolTableMismatch" .

ceng:ProjectionHashMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "ProjectionHashMismatch" .

ceng:AdmissionTableMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "AdmissionTableMismatch" .

ceng:LeastExpressiveRouteViolationRefusal a ceng:Refusal ;
    ceng:rustVariant "LeastExpressiveRouteViolation" .

ceng:UnsupportedDialectRefusal a ceng:Refusal ;
    ceng:rustVariant "UnsupportedDialect" .

ceng:N3UnavailableByProfileRefusal a ceng:Refusal ;
    ceng:rustVariant "N3UnavailableByProfile" .

ceng:N3ActuationRefusedRefusal a ceng:Refusal ;
    ceng:rustVariant "N3ActuationRefused" .

ceng:RouteDecisionMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "RouteDecisionMismatch" .

ceng:GraphSnapshotMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "GraphSnapshotMismatch" .

ceng:ProfileHashMismatchRefusal a ceng:Refusal ;
    ceng:rustVariant "ProfileHashMismatch" .

ceng:HookPatternNotAdmittedRefusal a ceng:Refusal ;
    ceng:rustVariant "HookPatternNotAdmitted" .

ceng:OcelEventNotAdmittedRefusal a ceng:Refusal ;
    ceng:rustVariant "OcelEventNotAdmitted" .

ceng:BoundaryRequestMissingReceiptRefusal a ceng:Refusal ;
    ceng:rustVariant "BoundaryRequestMissingReceipt" .

ceng:AgentOverrideDeniedRefusal a ceng:Refusal ;
    ceng:rustVariant "AgentOverrideDenied" .

ceng:WitnessNotAuthorityRefusal a ceng:Refusal ;
    ceng:rustVariant "WitnessNotAuthority" .

ceng:BreedUnpermittedRefusal a ceng:Refusal ;
    ceng:rustVariant "BreedUnpermitted" .

ceng:NondeterministicOperatorRequiresReceiptRefusal a ceng:Refusal ;
    ceng:rustVariant "NondeterministicOperatorRequiresReceipt" .

ceng:ProcessReceiptShadowTypeRefusal a ceng:Refusal ;
    ceng:rustVariant "ProcessReceiptShadowType" .

ceng:DuplicateCanonicalTapeTypeRefusal a ceng:Refusal ;
    ceng:rustVariant "DuplicateCanonicalTapeType" .

ceng:TripleTermInSnapshotRefusal a ceng:Refusal ;
    ceng:rustVariant "TripleTermInSnapshot" .

ceng:Accept_Triple8UniverseWithinBounds a ceng:AcceptanceCase ;
    ceng:harness ceng:Triple8Harness ;
    ceng:usesFixtureSchema ceng:Triple8FixtureSchema ;
    ceng:testFixturePath "fixtures/triple8/triple8_universe_within_bounds.json" ;
    ceng:expectedBehavior "triple8_universe_admitted" ;
    ceng:inputJson "{\"universe\":[\"<urn:chatman:triple8:t1>\",\"<urn:chatman:triple8:t2>\",\"<urn:chatman:triple8:t3>\",\"<urn:chatman:triple8:t4>\",\"<urn:chatman:triple8:t5>\"],\"terms\":[\"<urn:chatman:triple8:t1>\",\"<urn:chatman:triple8:t2>\",\"<urn:chatman:triple8:t3>\"]}" ;
    ceng:caseSeed "0x6074b224d3c0ca9e" .

ceng:Falsify_Triple8UniverseOverflow a ceng:FalsificationCase ;
    ceng:harness ceng:Triple8Harness ;
    ceng:falsifies ceng:Accept_Triple8UniverseWithinBounds ;
    ceng:usesFixtureSchema ceng:Triple8FixtureSchema ;
    ceng:testFixturePath "fixtures/triple8/triple8_universe_overflow.json" ;
    ceng:expectedRefusal ceng:Triple8UniverseOverflowRefusal ;
    ceng:falsificationMutation "Add a ninth distinct term so the universe exceeds the Triple8 bound of eight." ;
    ceng:inputJson "{\"universe\":[\"<urn:chatman:triple8:base1>\",\"<urn:chatman:triple8:base2>\",\"<urn:chatman:triple8:base3>\",\"<urn:chatman:triple8:base4>\",\"<urn:chatman:triple8:base5>\",\"<urn:chatman:triple8:base6>\",\"<urn:chatman:triple8:base7>\",\"<urn:chatman:triple8:base8>\"],\"terms\":[\"<urn:chatman:triple8:base1>\",\"<urn:chatman:triple8:base2>\"],\"overflow_terms\":[\"<urn:chatman:triple8:overflow1>\",\"<urn:chatman:triple8:overflow2>\",\"<urn:chatman:triple8:overflow3>\",\"<urn:chatman:triple8:overflow4>\",\"<urn:chatman:triple8:overflow5>\",\"<urn:chatman:triple8:overflow6>\",\"<urn:chatman:triple8:overflow7>\",\"<urn:chatman:triple8:overflow8>\",\"<urn:chatman:triple8:overflow9>\",\"<urn:chatman:triple8:overflow10>\",\"<urn:chatman:triple8:overflow11>\",\"<urn:chatman:triple8:overflow12>\",\"<urn:chatman:triple8:overflow13>\",\"<urn:chatman:triple8:overflow14>\",\"<urn:chatman:triple8:overflow15>\",\"<urn:chatman:triple8:overflow16>\",\"<urn:chatman:triple8:overflow17>\",\"<urn:chatman:triple8:overflow18>\",\"<urn:chatman:triple8:overflow19>\",\"<urn:chatman:triple8:overflow20>\",\"<urn:chatman:triple8:overflow21>\",\"<urn:chatman:triple8:overflow22>\",\"<urn:chatman:triple8:overflow23>\",\"<urn:chatman:triple8:overflow24>\",\"<urn:chatman:triple8:overflow25>\",\"<urn:chatman:triple8:overflow26>\",\"<urn:chatman:triple8:overflow27>\",\"<urn:chatman:triple8:overflow28>\",\"<urn:chatman:triple8:overflow29>\",\"<urn:chatman:triple8:overflow30>\",\"<urn:chatman:triple8:overflow31>\",\"<urn:chatman:triple8:overflow32>\",\"<urn:chatman:triple8:overflow33>\",\"<urn:chatman:triple8:overflow34>\",\"<urn:chatman:triple8:overflow35>\",\"<urn:chatman:triple8:overflow36>\",\"<urn:chatman:triple8:overflow37>\",\"<urn:chatman:triple8:overflow38>\",\"<urn:chatman:triple8:overflow39>\",\"<urn:chatman:triple8:overflow40>\",\"<urn:chatman:triple8:overflow41>\",\"<urn:chatman:triple8:overflow42>\",\"<urn:chatman:triple8:overflow43>\",\"<urn:chatman:triple8:overflo