to: "crates/multifractal-workflow/src/f26_ontology_self_play_vocab.rs"
force: true
determinism: true
sparql:
  a_classes: |
    PREFIX ospl: <https://ggen.io/ontology/f26-ontology-self-play#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?class ?label ?comment WHERE {
      ?class a rdfs:Class ; rdfs:label ?label ; rdfs:comment ?comment .
      FILTER(STRSTARTS(STR(?class), "https://ggen.io/ontology/f26-ontology-self-play#"))
      FILTER(?class != ospl:DerivationEdge && ?class != ospl:LifecycleState && ?class != ospl:RefusalExit && ?class != ospl:ExitEvidenceFlag)
    } ORDER BY ?label
  b_edges: |
    PREFIX ospl: <https://ggen.io/ontology/f26-ontology-self-play#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?from_label ?to_label WHERE {
      ?edge a ospl:DerivationEdge ; ospl:fromClass ?from ; ospl:toClass ?to .
      ?from rdfs:label ?from_label .
      ?to rdfs:label ?to_label .
    } ORDER BY ?from_label ?to_label
  c_states: |
    PREFIX ospl: <https://ggen.io/ontology/f26-ontology-self-play#>
    SELECT ?name ?ordinal WHERE {
      ?s a ospl:LifecycleState ; ospl:stateName ?name ; ospl:ordinal ?ordinal .
    } ORDER BY ?ordinal
  d_refusal_exits: |
    PREFIX ospl: <https://ggen.io/ontology/f26-ontology-self-play#>
    SELECT ?from_state WHERE {
      ?r a ospl:RefusalExit ; ospl:fromState ?from_state .
    } ORDER BY ?from_state
  e_flags: |
    PREFIX ospl: <https://ggen.io/ontology/f26-ontology-self-play#>
    SELECT ?name WHERE {
      ?f a ospl:ExitEvidenceFlag ; ospl:flagName ?name .
    } ORDER BY ?name
