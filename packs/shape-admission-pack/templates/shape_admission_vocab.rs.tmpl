to: "crates/multifractal-workflow/src/f07_shape_admission_vocab.rs"
force: true
determinism: true
sparql:
  a_classes: |
    PREFIX sadm: <https://ggen.io/ontology/shape-admission#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?class ?label ?comment WHERE {
      ?class a rdfs:Class ; rdfs:label ?label ; rdfs:comment ?comment .
      FILTER(STRSTARTS(STR(?class), "https://ggen.io/ontology/shape-admission#"))
      FILTER(?class != sadm:DerivationEdge && ?class != sadm:LifecycleState)
    } ORDER BY ?label
  b_edges: |
    PREFIX sadm: <https://ggen.io/ontology/shape-admission#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?from_label ?to_label WHERE {
      ?edge a sadm:DerivationEdge ; sadm:fromClass ?from ; sadm:toClass ?to .
      ?from rdfs:label ?from_label .
      ?to rdfs:label ?to_label .
    } ORDER BY ?from_label ?to_label
  c_states: |
    PREFIX sadm: <https://ggen.io/ontology/shape-admission#>
    SELECT ?name ?ordinal WHERE {
      ?s a sadm:LifecycleState ; sadm:stateName ?name ; sadm:ordinal ?ordinal .
    } ORDER BY ?ordinal
