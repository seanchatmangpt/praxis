---
to: "registry/otel/manifest.yaml"
force: true
determinism: true
sparql:
  a_ontology: |
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?description ?version WHERE {
      ?ont a owl:Ontology ;
           dcterms:title ?title ;
           dcterms:description ?description ;
           owl:versionInfo ?version .
      FILTER(STR(?ont) = "https://ggen.io/ontology/otel-bridge")
    } ORDER BY ?title
---
{%- set ont = sparql_first(rows=a_ontology) -%}
name: praxis
description: {{ ont.description }}
schema_url: https://ggen.io/schemas/{{ ont.version }}
