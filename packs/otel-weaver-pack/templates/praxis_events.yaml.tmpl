---
to: "registry/otel/praxis-events.yaml"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX ob: <https://ggen.io/ontology/otel-bridge#>
    SELECT ?group_id ?stability ?brief WHERE {
      ?g a ob:EventGroup ;
         ob:groupId ?group_id ;
         ob:stability ?stability ;
         ob:brief ?brief .
    } ORDER BY ?group_id
  b_attributes: |
    PREFIX ob: <https://ggen.io/ontology/otel-bridge#>
    SELECT ?attr_id ?attr_type ?req ?brief WHERE {
      ?a a ob:Attribute ;
         ob:attributeId ?attr_id ;
         ob:attributeType ?attr_type ;
         ob:requirementLevel ?req ;
         ob:brief ?brief ;
         ob:memberOf ?g .
      ?g ob:groupId "event.praxis.activity_executed" .
      VALUES (?attr_id ?idx) {
        ("process.workflow.id"  "1")
        ("process.object.id"    "2")
        ("process.object.type"  "3")
        ("process.activity.iri" "4")
        ("process.outcome"      "5")
      }
    } ORDER BY ?idx
---
# GENERATED BY ggen — do not edit. Source: crates/praxis-graphlaw/ontologies/core/otel-bridge.ttl
{% set group = sparql_first(rows=a_group) -%}
groups:
  - id: {{ group.group_id }}
    type: event
    name: {{ group.group_id | replace(from="event.", to="") }}
    stability: {{ group.stability }}
    brief: {{ group.brief }}
    attributes:
{%- for row in b_attributes %}
      - id: {{ row.attr_id }}
        type: {{ row.attr_type }}
        stability: {{ group.stability }}
        requirement_level: {{ row.req }}
        brief: {{ row.brief }}
        examples: ["{{ row.attr_id | replace(from=".", to="_") }}_sample"]
{%- endfor %}
