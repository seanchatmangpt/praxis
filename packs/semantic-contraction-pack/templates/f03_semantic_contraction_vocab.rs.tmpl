force: true
determinism: true
sparql:
  a_classes: |
    PREFIX sc: <https://ggen.io/ontology/semantic-contraction#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?class ?label ?comment WHERE {
      ?class a rdfs:Class ; rdfs:label ?label ; rdfs:comment ?comment .
      FILTER(STRSTARTS(STR(?class), "https://ggen.io/ontology/semantic-contraction#"))
      FILTER(?class != sc:DerivationEdge && ?class != sc:LifecycleState && ?class != sc:Transition && ?class != sc:PipelineComponent)
    } ORDER BY ?label
  b_edges: |
    PREFIX sc: <https://ggen.io/ontology/semantic-contraction#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?from_label ?relation ?to_label WHERE {
      ?edge a sc:DerivationEdge ; sc:fromClass ?from ; sc:toClass ?to ; sc:relation ?relation .
      ?from rdfs:label ?from_label .
      ?to rdfs:label ?to_label .
    } ORDER BY ?from_label ?to_label
  c_states: |
    PREFIX sc: <https://ggen.io/ontology/semantic-contraction#>
    SELECT ?name ?ordinal WHERE {
      ?s a sc:LifecycleState ; sc:stateName ?name ; sc:ordinal ?ordinal .
    } ORDER BY ?ordinal
  d_transitions: |
    PREFIX sc: <https://ggen.io/ontology/semantic-contraction#>
    SELECT ?from_state ?to_state ?kind WHERE {
      ?t a sc:Transition ; sc:fromState ?from_state ; sc:toState ?to_state ; sc:kind ?kind .
    } ORDER BY ?from_state ?to_state
  e_components: |
    PREFIX sc: <https://ggen.io/ontology/semantic-contraction#>
    SELECT ?name ?status ?ordinal WHERE {
      ?c a sc:PipelineComponent ; sc:componentName ?name ; sc:componentStatus ?status ; sc:componentOrdinal ?ordinal .
    } ORDER BY ?ordinal
