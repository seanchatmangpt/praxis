---
to: generated/f29_capability_roadmap_generated.rs
sparql:
  entities: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwroad: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/roadmap#> SELECT ?label ?order ?stage ?derivedFrom ?realizedBy WHERE { ?e a mfwroad:ProvChainEntity ; rdfs:label ?label ; mfwroad:chainOrder ?order ; mfwroad:pipelineStage ?stage ; mfwroad:derivedFromEntity ?derivedFrom ; mfwroad:realizedBy ?realizedBy } ORDER BY ?order"
  states: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwroad: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/roadmap#> SELECT ?label ?order ?transitions WHERE { ?s a mfwroad:LifecycleStateEntity ; rdfs:label ?label ; mfwroad:stateOrder ?order ; mfwroad:legalTransitions ?transitions } ORDER BY ?order"
  refusals: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwroad: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/roadmap#> SELECT ?label ?meaning ?invariant ?status WHERE { ?r a mfwroad:RefusalKind ; rdfs:label ?label ; mfwroad:meaning ?meaning ; mfwroad:invariant ?invariant ; mfwroad:status ?status } ORDER BY ?label"
skip_if: "ggen:local-override"
---
// F29 Thermodynamic Capability Roadmap (V12-029) -- GENERATED by
// `ggen sync` from `packs/f29-capability-roadmap-pack/ontology.ttl`
// (`mfwroad:ProvChainEntity` / `mfwroad:LifecycleStateEntity` /
// `mfwroad:RefusalKind` individuals). Do not edit by hand: this file is a
// pure data projection of the L6 PROV chain, L5 state catalog, and
// CapabilityRoadmapRefused catalog, `include!`d (not `mod` -- so `//!`
// inner-doc comments are not legal here) into `f29_capability_roadmap.rs`,
// which carries the module-level doc comment and the real, hand-written
// 8-stage pipeline, lifecycle transition table, refusal enum, L7
// idempotency ledger, and L6/L8 replay/claim-ceiling logic. Add
// `ggen:local-override` to the template frontmatter to freeze
// regeneration.
//
// Regenerate from a scratch ggen project referencing this pack (does not
// touch the shared root `ggen.toml`), e.g.:
// ```text
// mkdir -p /tmp/f29-ggen-scratch/templates
// cat > /tmp/f29-ggen-scratch/ggen.toml <<'EOF'
// [project]
// name = "f29-ggen-scratch"
// [ontology]
// source = "/Users/sac/praxis/packs/f29-capability-roadmap-pack/ontology.ttl"
// [packs]
// f29-capability-roadmap-pack = { path = "/Users/sac/praxis/packs/f29-capability-roadmap-pack" }
// [templates]
// dir = "templates"
// EOF
// (cd /tmp/f29-ggen-scratch && ggen sync run)
// cp /tmp/f29-ggen-scratch/generated/f29_capability_roadmap_generated.rs \
//    /Users/sac/praxis/crates/multifractal-workflow/src/
// ```

/// One entity in F29's L6 provenance chain -- a pure data projection of an
/// `mfwroad:ProvChainEntity` individual. Field values are informational
/// strings/integers carried straight from the ontology; nothing here is
/// enforcement (the real pipeline logic lives in `f29_capability_roadmap.rs`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ProvChainEntity {
    pub name: &'static str,
    pub chain_order: u8,
    pub pipeline_stage: &'static str,
    pub derived_from: &'static str,
    pub realized_by: &'static str,
}

/// The generated L6 PROV chain: one [`ProvChainEntity`] per
/// `mfwroad:ProvChainEntity` individual in the pack ontology, in `?order`
/// order. `WorkProfile -> ... -> RoadmapArtifact`, a straight-line chain
/// (each entity's `derived_from` names exactly its predecessor; the head
/// carries `"none"`).
pub const PROV_CHAIN: &[ProvChainEntity] = &[
{% for e in entities %}    ProvChainEntity {
        name: "{{ e.label }}",
        chain_order: {{ e.order }},
        pipeline_stage: "{{ e.stage }}",
        derived_from: "{{ e.derivedFrom }}",
        realized_by: "{{ e.realizedBy }}",
    },
{% endfor %}];

/// One state in F29's L5 state-machine catalog -- a pure data projection of
/// an `mfwroad:LifecycleStateEntity` individual. `legal_transitions` is
/// informational; the real, enforced transition table lives in
/// `LifecycleState::can_transition_to` in `f29_capability_roadmap.rs`, and
/// `provenance_catalog_matches_lifecycle_states`-style tests cross-check
/// the two do not silently drift.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct LifecycleStateCatalogEntry {
    pub name: &'static str,
    pub state_order: u8,
    pub legal_transitions: &'static str,
}

/// The fixed 9-entry L5 lifecycle catalog (8 declared states plus REFUSED),
/// in `?order` order.
pub const LIFECYCLE_STATE_CATALOG: &[LifecycleStateCatalogEntry] = &[
{% for s in states %}    LifecycleStateCatalogEntry {
        name: "{{ s.label }}",
        state_order: {{ s.order }},
        legal_transitions: "{{ s.transitions }}",
    },
{% endfor %}];

/// One catalogued `CapabilityRoadmapRefused` variant (`mfwroad:RefusalKind`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RefusalCatalogEntry {
    pub name: &'static str,
    pub meaning: &'static str,
    pub invariant: &'static str,
    pub status: &'static str,
}

/// The full `CapabilityRoadmapRefused` catalog, alphabetical by variant
/// name. `f29_capability_roadmap.rs`'s own tests cross-check this catalog's
/// names against the hand-written `CapabilityRoadmapRefused` enum so the
/// two cannot silently drift.
pub const REFUSAL_CATALOG: &[RefusalCatalogEntry] = &[
{% for r in refusals %}    RefusalCatalogEntry {
        name: "{{ r.label }}",
        meaning: "{{ r.meaning }}",
        invariant: "{{ r.invariant }}",
        status: "{{ r.status }}",
    },
{% endfor %}];
