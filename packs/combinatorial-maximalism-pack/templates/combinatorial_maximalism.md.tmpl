---
to: "docs/standing/COMBINATORIAL_MAXIMALISM.md"
force: true
determinism: true
sparql:
  a_dimensions: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?domain ?order ?coverage ?risk ?ceiling WHERE {
      ?dimension a cmd:Dimension ;
                 cmd:identity ?identity ;
                 cmd:domain ?domainIri ;
                 cmd:dimensionOrder ?order ;
                 cmd:coverageMode ?coverageIri ;
                 cmd:riskClass ?risk ;
                 cmd:resourceCeiling ?ceiling .
      BIND(REPLACE(STR(?domainIri), "^.*#", "") AS ?domain)
      BIND(REPLACE(STR(?coverageIri), "^.*#", "") AS ?coverage)
    } ORDER BY ?order
  b_options: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?dimension ?implementation ?cost ?authority ?reversal WHERE {
      ?option a cmd:Option ;
              cmd:identity ?identity ;
              cmd:forDimension ?dimensionNode ;
              cmd:implementation ?implementation ;
              cmd:resourceCost ?cost ;
              cmd:authorityRequirement ?authority ;
              cmd:reversalClass ?reversalIri .
      ?dimensionNode cmd:identity ?dimension .
      BIND(REPLACE(STR(?reversalIri), "^.*#", "") AS ?reversal)
    } ORDER BY ?dimension ?identity
  c_packs: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?version ?source ?verifier WHERE {
      ?pack a cmd:Pack ;
            cmd:identity ?identity ;
            cmd:version ?version ;
            cmd:immutableSource ?source ;
            cmd:verifierCommand ?verifier .
    } ORDER BY ?identity
  d_checkpoints: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?code ?order ?ceiling
           (GROUP_CONCAT(DISTINCT ?refusal; separator=", ") AS ?refusals)
    WHERE {
      ?checkpoint a cmd:Checkpoint ;
                  cmd:checkpointCode ?code ;
                  cmd:checkpointOrder ?order ;
                  cmd:standingCeiling ?ceilingIri ;
                  cmd:requiredRefusal ?refusal .
      BIND(REPLACE(STR(?ceilingIri), "^.*#", "") AS ?ceiling)
    }
    GROUP BY ?code ?order ?ceiling
    ORDER BY ?order
  e_exclusions: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?reason ?ceiling WHERE {
      ?exclusion a cmd:Exclusion ;
                 cmd:identity ?identity ;
                 cmd:exclusionReason ?reason ;
                 cmd:standingCeiling ?ceilingIri .
      BIND(REPLACE(STR(?ceilingIri), "^.*#", "") AS ?ceiling)
    } ORDER BY ?identity
---
# Praxis Combinatorial Maximalism

<!-- Generated by ggen from packs/combinatorial-maximalism-pack. Do not edit. -->

## Operating calculus

```text
O → O* → candidates → verification → grant → brokered actuation → receipt → replay
```

This projection describes the admitted internal and external variation graph.
Candidates are inert. A verified candidate is not authorized. An authorized
candidate is not actuated. External production standing remains `UNKNOWN` until
BRCE executes an exact grant and an independent observer verifies the consequence.

