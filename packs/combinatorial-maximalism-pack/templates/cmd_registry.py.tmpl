---
to: "target/ggen-cmd/cmd_registry.py"
force: true
determinism: true
sparql:
  a_standing: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?name WHERE {
      ?state a cmd:StandingState .
      BIND(REPLACE(STR(?state), "^.*#", "") AS ?name)
    } ORDER BY ?name
  b_dimensions: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?domain ?order WHERE {
      ?dimension a cmd:Dimension ;
                 cmd:identity ?identity ;
                 cmd:domain ?domainIri ;
                 cmd:dimensionOrder ?order .
      BIND(REPLACE(STR(?domainIri), "^.*#", "") AS ?domain)
    } ORDER BY ?order
  c_options: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?identity ?dimension WHERE {
      ?option a cmd:Option ;
              cmd:identity ?identity ;
              cmd:forDimension ?dimensionNode .
      ?dimensionNode cmd:identity ?dimension .
    } ORDER BY ?dimension ?identity
  d_checkpoints: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT ?code ?order WHERE {
      ?checkpoint a cmd:Checkpoint ;
                  cmd:checkpointCode ?code ;
                  cmd:checkpointOrder ?order .
    } ORDER BY ?order
  e_refusals: |
    PREFIX cmd: <https://praxis.chatman.io/ontology/cmd#>
    SELECT DISTINCT ?code WHERE {
      ?checkpoint a cmd:Checkpoint ; cmd:requiredRefusal ?code .
    } ORDER BY ?code
---
# Generated by ggen from packs/combinatorial-maximalism-pack. Do not edit.

STANDING_STATES = (
{% for row in a_standing -%}
    {{ row.name | json_encode }},
{% endfor -%}
)

DIMENSIONS = (
{% for row in b_dimensions -%}
    ({{ row.identity | json_encode }}, {{ row.domain | json_encode }}, {{ row.order }}),
{% endfor -%}
)

OPTIONS = (
{% for row in c_options -%}
    ({{ row.dimension | json_encode }}, {{ row.identity | json_encode }}),
{% endfor -%}
)

CHECKPOINTS = (
{% for row in d_checkpoints -%}
    ({{ row.code | json_encode }}, {{ row.order }}),
{% endfor -%}
)

REFUSAL_CODES = (
{% for row in e_refusals -%}
    {{ row.code | json_encode }},
{% endfor -%}
)

assert len(STANDING_STATES) == len(set(STANDING_STATES))
assert tuple(sorted(CHECKPOINTS, key=lambda row: row[1])) == CHECKPOINTS
assert len(REFUSAL_CODES) == len(set(REFUSAL_CODES))
