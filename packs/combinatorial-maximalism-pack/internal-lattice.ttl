@prefix cmd: <https://praxis.chatman.io/ontology/cmd#> .

# Twelve one-of dimensions form a bounded product of 4096 raw combinations.
# The independent verifier applies requiresOption/incompatibleWith/resource
# constraints and selects pairwise plus risk-weighted witnesses without giving
# any candidate authority.

cmd:InternalRuntime a cmd:Dimension ; cmd:identity "internal.runtime" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 10 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "execution" ; cmd:resourceCeiling 8 .
cmd:InternalStorage a cmd:Dimension ; cmd:identity "internal.storage" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 20 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "state" ; cmd:resourceCeiling 8 .
cmd:InternalInvocation a cmd:Dimension ; cmd:identity "internal.invocation" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 30 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "protocol" ; cmd:resourceCeiling 8 .
cmd:InternalSerialization a cmd:Dimension ; cmd:identity "internal.serialization" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 40 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "semantic" ; cmd:resourceCeiling 8 .
cmd:InternalConsistency a cmd:Dimension ; cmd:identity "internal.consistency" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 50 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "state" ; cmd:resourceCeiling 8 .
cmd:InternalScheduling a cmd:Dimension ; cmd:identity "internal.scheduling" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 60 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "concurrency" ; cmd:resourceCeiling 8 .
cmd:InternalErrorModel a cmd:Dimension ; cmd:identity "internal.error-model" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 70 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:RiskWeightedExhaustive ; cmd:riskClass "failure" ; cmd:resourceCeiling 8 .
cmd:InternalProjection a cmd:Dimension ; cmd:identity "internal.deployment-projection" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 80 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "mutation" ; cmd:resourceCeiling 8 .
cmd:InternalGenerationCardinality a cmd:Dimension ; cmd:identity "internal.generation-cardinality" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 90 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:Pairwise ; cmd:riskClass "generation" ; cmd:resourceCeiling 8 .
cmd:InternalOwnershipMode a cmd:Dimension ; cmd:identity "internal.ownership-mode" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 100 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:RiskWeightedExhaustive ; cmd:riskClass "authority" ; cmd:resourceCeiling 8 .
cmd:InternalRecoveryMode a cmd:Dimension ; cmd:identity "internal.recovery-mode" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 110 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:RiskWeightedExhaustive ; cmd:riskClass "recovery" ; cmd:resourceCeiling 8 .
cmd:InternalVerificationMode a cmd:Dimension ; cmd:identity "internal.verification-mode" ; cmd:domain cmd:Internal ; cmd:dimensionOrder 120 ; cmd:selectionCardinality 1 ; cmd:coverageMode cmd:RiskWeightedExhaustive ; cmd:riskClass "proof" ; cmd:resourceCeiling 8 .

cmd:RustNativeRuntime a cmd:Option ; cmd:identity "runtime.rust-native" ; cmd:forDimension cmd:InternalRuntime ; cmd:implementation "Rust native process" ; cmd:resourceCost 2 ; cmd:authorityRequirement "candidate only" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:providesCapability cmd:DeterministicPlanningCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:WasmSandboxRuntime a cmd:Option ; cmd:identity "runtime.wasm-sandbox" ; cmd:forDimension cmd:InternalRuntime ; cmd:implementation "WASM sandbox" ; cmd:resourceCost 3 ; cmd:authorityRequirement "host capability grant" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:incompatibleWith cmd:LspInvocation, cmd:FilesystemProjection ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:InMemoryStorage a cmd:Option ; cmd:identity "storage.in-memory" ; cmd:forDimension cmd:InternalStorage ; cmd:implementation "bounded in-memory state" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:OxigraphStorage a cmd:Option ; cmd:identity "storage.oxigraph" ; cmd:forDimension cmd:InternalStorage ; cmd:implementation "Oxigraph semantic store" ; cmd:resourceCost 3 ; cmd:authorityRequirement "local storage intent" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:providesCapability cmd:SemanticAuthorityCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:CliInvocation a cmd:Option ; cmd:identity "invocation.cli" ; cmd:forDimension cmd:InternalInvocation ; cmd:implementation "black-box CLI" ; cmd:resourceCost 1 ; cmd:authorityRequirement "adapter only" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:LspInvocation a cmd:Option ; cmd:identity "invocation.lsp" ; cmd:forDimension cmd:InternalInvocation ; cmd:implementation "LSP request/response" ; cmd:resourceCost 2 ; cmd:authorityRequirement "adapter only" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:incompatibleWith cmd:WasmSandboxRuntime ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:JsonSerialization a cmd:Option ; cmd:identity "serialization.json" ; cmd:forDimension cmd:InternalSerialization ; cmd:implementation "canonical JSON" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:OcelSerialization a cmd:Option ; cmd:identity "serialization.ocel" ; cmd:forDimension cmd:InternalSerialization ; cmd:implementation "OCEL 2 evidence" ; cmd:resourceCost 2 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:providesCapability cmd:ReplayCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:SnapshotConsistency a cmd:Option ; cmd:identity "consistency.snapshot" ; cmd:forDimension cmd:InternalConsistency ; cmd:implementation "immutable snapshot" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:EventSourcedConsistency a cmd:Option ; cmd:identity "consistency.event-sourced" ; cmd:forDimension cmd:InternalConsistency ; cmd:implementation "append-only causal events" ; cmd:resourceCost 2 ; cmd:authorityRequirement "receipt chain" ; cmd:reversalClass cmd:COMPENSATABLE ; cmd:requiresOption cmd:OcelSerialization ; cmd:providesCapability cmd:ReceiptChainCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:SequentialScheduling a cmd:Option ; cmd:identity "scheduling.sequential" ; cmd:forDimension cmd:InternalScheduling ; cmd:implementation "deterministic sequential order" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:BoundedParallelScheduling a cmd:Option ; cmd:identity "scheduling.bounded-parallel" ; cmd:forDimension cmd:InternalScheduling ; cmd:implementation "dependency-closed bounded workers" ; cmd:resourceCost 3 ; cmd:authorityRequirement "work-order grant" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:TypedRefusalErrors a cmd:Option ; cmd:identity "error.typed-refusal" ; cmd:forDimension cmd:InternalErrorModel ; cmd:implementation "closed typed refusal codes" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py sabotage" .
cmd:ResultEnvelopeErrors a cmd:Option ; cmd:identity "error.result-envelope" ; cmd:forDimension cmd:InternalErrorModel ; cmd:implementation "stable result envelope" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py sabotage" .

cmd:FilesystemProjection a cmd:Option ; cmd:identity "projection.filesystem" ; cmd:forDimension cmd:InternalProjection ; cmd:implementation "transactional filesystem staging" ; cmd:resourceCost 3 ; cmd:authorityRequirement "local materialization grant" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:incompatibleWith cmd:WasmSandboxRuntime ; cmd:providesCapability cmd:LocalMaterializationCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-materializer" .
cmd:InertPlanProjection a cmd:Option ; cmd:identity "projection.inert-plan" ; cmd:forDimension cmd:InternalProjection ; cmd:implementation "pure plan JSON" ; cmd:resourceCost 1 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:providesCapability cmd:DeterministicPlanningCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-plan" .

cmd:SingleOutputGeneration a cmd:Option ; cmd:identity "generation.single" ; cmd:forDimension cmd:InternalGenerationCardinality ; cmd:implementation "one admitted output" ; cmd:resourceCost 1 ; cmd:authorityRequirement "output owner" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .
cmd:FanOutGeneration a cmd:Option ; cmd:identity "generation.fan-out" ; cmd:forDimension cmd:InternalGenerationCardinality ; cmd:implementation "bounded graph fan-out" ; cmd:resourceCost 3 ; cmd:authorityRequirement "one owner per output" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-candidates" .

cmd:ExclusiveOwnership a cmd:Option ; cmd:identity "ownership.exclusive" ; cmd:forDimension cmd:InternalOwnershipMode ; cmd:implementation "one semantic writer" ; cmd:resourceCost 1 ; cmd:authorityRequirement "exclusive owner" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-ownership" .
cmd:DeclaredMergeOwnership a cmd:Option ; cmd:identity "ownership.merge-law" ; cmd:forDimension cmd:InternalOwnershipMode ; cmd:implementation "declared deterministic merge law" ; cmd:resourceCost 2 ; cmd:authorityRequirement "named merge law" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-ownership" .

cmd:ReversibleRecovery a cmd:Option ; cmd:identity "recovery.reversible" ; cmd:forDimension cmd:InternalRecoveryMode ; cmd:implementation "inverse from admitted prior state" ; cmd:resourceCost 1 ; cmd:authorityRequirement "prior-state receipt" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-materializer" .
cmd:SnapshotRestoreRecovery a cmd:Option ; cmd:identity "recovery.snapshot-restore" ; cmd:forDimension cmd:InternalRecoveryMode ; cmd:implementation "restore immutable snapshot" ; cmd:resourceCost 2 ; cmd:authorityRequirement "snapshot receipt" ; cmd:reversalClass cmd:REVERSIBLE_WITH_SNAPSHOT ; cmd:verifierCommand "python3 scripts/cmd-refactor.py verify-materializer" .

cmd:UnitReplayVerification a cmd:Option ; cmd:identity "verification.unit-replay" ; cmd:forDimension cmd:InternalVerificationMode ; cmd:implementation "unit plus receipt replay" ; cmd:resourceCost 2 ; cmd:authorityRequirement "none" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:providesCapability cmd:ReplayCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py replay" .
cmd:CrownVerification a cmd:Option ; cmd:identity "verification.crown" ; cmd:forDimension cmd:InternalVerificationMode ; cmd:implementation "ordered crown verification ladder" ; cmd:resourceCost 4 ; cmd:authorityRequirement "independent verifier" ; cmd:reversalClass cmd:REVERSIBLE ; cmd:providesCapability cmd:ReplayCapability, cmd:ExternalVerifierCapability ; cmd:verifierCommand "python3 scripts/cmd-refactor.py crown" .
