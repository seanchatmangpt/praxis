/// The fixed 8-stage D1-D8 provenance chain, in chain order.
pub const PROVENANCE_CHAIN: &[ProvenanceStage] = &[
{% for s in stages %}    ProvenanceStage {
        name: "{{ s.label }}",
        chain_order: {{ s.order }},
        edge_to_next: "{{ s.edge }}",
        realized_by: "{{ s.realizedBy }}",
