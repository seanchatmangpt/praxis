         arz:onFailure ?a .
      ?a arz:name ?aname ;
         arz:actionType ?atype .
      OPTIONAL { ?a arz:targetStep ?ts }
      OPTIONAL { ?a arz:targetWorkflow ?tw }
      OPTIONAL { ?a arz:retryAfter ?ra }
      OPTIONAL { ?a arz:retryLimit ?rl }
