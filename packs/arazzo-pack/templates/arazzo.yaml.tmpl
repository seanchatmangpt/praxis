    } ORDER BY ?workflow_id ?step_id ?aname ?condition ?ctype
  k_step_outputs: |
    PREFIX arz: <https://truex.io/ontology/arazzo#>
    SELECT ?workflow_id ?step_id ?oname ?ovalue WHERE {
      ?w a arz:Workflow ;
         arz:workflowId ?workflow_id ;
         arz:hasStep ?s .
      ?s arz:stepId ?step_id ;
         arz:hasOutput ?o .
      ?o arz:name ?oname ;
         arz:value ?ovalue .
    } ORDER BY ?workflow_id ?step_id ?oname ?ovalue
  l_wf_outputs: |
