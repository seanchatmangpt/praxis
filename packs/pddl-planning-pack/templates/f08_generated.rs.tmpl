#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn seven_lawful_states_in_atlas_order() {
        assert_eq!(
            [
                PipelineState::ProblemProjected,
                PipelineState::DomainBound,
                PipelineState::ActionsBound,
                PipelineState::Planning,
                PipelineState::PlanFound,
                PipelineState::Validated,
                PipelineState::Receipted,
            ]
            .len(),
            7
        );
    }

    #[test]
    fn six_lawful_transitions_form_one_linear_chain() {
        assert_eq!(LAWFUL_TRANSITIONS.len(), 6);
        assert_eq!(LAWFUL_TRANSITIONS[0].0, PipelineState::ProblemProjected);
        assert_eq!(LAWFUL_TRANSITIONS[5].1, PipelineState::Receipted);
        for w in LAWFUL_TRANSITIONS.windows(2) {
            assert_eq!(
                w[0].1, w[1].0,
                "lawful transitions must chain end-to-start: {:?} -> {:?}",
                w[0], w[1]
            );
        }
    }

    #[test]
    fn refusal_sources_match_atlas_l5_diagram_exactly() {
        assert_eq!(
            REFUSAL_SOURCES,
            &[PipelineState::DomainBound, PipelineState::Planning]
        );
    }

    #[test]
    fn is_lawful_transition_accepts_chain_and_rejects_skip() {
        assert!(is_lawful_transition(
            PipelineState::ProblemProjected,
            PipelineState::DomainBound
        ));
        assert!(!is_lawful_transition(
            PipelineState::ProblemProjected,
            PipelineState::Receipted
        ));
    }

    #[test]
    fn seven_stages_in_atlas_l2_order_with_three_refusal_points() {
        assert_eq!(stage::STAGES.len(), 7);
        assert_eq!(stage::STAGES[0].label, "Problem Projector");
        assert_eq!(stage::STAGES[6].label, "Plan Receipt");
        assert_eq!(stage::refusal_stages().count(), 3);
    }

    #[test]
    fn six_l6_chain_edges_alternate_wasderivedfrom_and_generates() {
        assert_eq!(L6_CHAIN.len(), 6);
        for (i, (_, edge, _)) in L6_CHAIN.iter().enumerate() {
            let expected = if i % 2 == 0 {
                "prov:wasDerivedFrom"
            } else {
                "mfw:generates"
            };
            assert_eq!(*edge, expected, "L6_CHAIN[{i}]");
        }
    }

    #[test]
    fn entity_from_content_is_deterministic_and_content_addressed() {
        let a = entity::PDDLProblem::from_content(b"same content");
        let b = entity::PDDLProblem::from_content(b"same content");
        assert_eq!(a, b, "same content must mint the same IRI/digest");
        let c = entity::PDDLProblem::from_content(b"different content");
        assert_ne!(a.iri, c.iri);
    }

    #[test]
    fn three_l8_claim_gates_verbatim() {
        assert_eq!(
            L8_CLAIM_GATES,
            &[
                "PDDL_IRREDUCIBLE_TRANSITION_PLANNING_PROVEN",
                "ZERO_FICTIONAL_ACTIONS",
                "PLAN_VALIDATION_ALIVE",
            ]
        );
    }
}
