---
to: "docs/standing/GGEN_CODE_MODERNIZATION.md"
force: true
determinism: true
sparql:
  a_inventory: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?head ?count ?hash WHERE {
      ?inventory a gmod:Inventory ;
                 gmod:headSha ?head ;
                 gmod:surfaceCount ?count ;
                 gmod:contentHash ?hash .
    } ORDER BY ?head
  b_dispositions: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?disposition_name (COUNT(?surface) AS ?count) WHERE {
      ?surface a gmod:SourceSurface ;
               gmod:disposition ?disposition .
      BIND(REPLACE(STR(?disposition), "^.*#", "") AS ?disposition_name)
    }
    GROUP BY ?disposition_name
    ORDER BY DESC(?count) ?disposition_name
  c_candidates: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?path ?language ?owner ?score
           (GROUP_CONCAT(DISTINCT ?reason; separator=", ") AS ?reasons)
    WHERE {
      ?surface a gmod:CodeSurface ;
               gmod:path ?path ;
               gmod:language ?language ;
               gmod:owner ?owner ;
               gmod:candidateScore ?score ;
               gmod:candidateReason ?reason ;
               gmod:disposition ?disposition .
      VALUES ?disposition { gmod:HighCandidate gmod:MediumCandidate }
    }
    GROUP BY ?path ?language ?owner ?score
    ORDER BY DESC(?score) ?path
  d_generated_without_source: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?path WHERE {
      ?surface a gmod:GeneratedProjection ;
               gmod:path ?path .
      FILTER NOT EXISTS { ?surface gmod:projectionSource ?source }
    } ORDER BY ?path
  e_surfaces: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?path ?language ?owner ?kind ?disposition_name ?score WHERE {
      ?surface a gmod:SourceSurface ;
               gmod:path ?path ;
               gmod:language ?language ;
               gmod:owner ?owner ;
               gmod:kind ?kind ;
               gmod:disposition ?disposition ;
               gmod:candidateScore ?score .
      BIND(REPLACE(STR(?disposition), "^.*#", "") AS ?disposition_name)
    } ORDER BY ?path
---
