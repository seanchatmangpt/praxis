---
to: "crates/ggen/tests/ggen_code_inventory.rs"
force: true
determinism: true
sparql:
  a_surfaces: |
    PREFIX gmod: <https://praxis.chatman.io/ontology/ggen-modernization#>
    SELECT ?path ?language ?owner ?kind ?disposition_name ?source WHERE {
      ?surface a gmod:SourceSurface ;
               gmod:path ?path ;
               gmod:language ?language ;
               gmod:owner ?owner ;
               gmod:kind ?kind ;
               gmod:disposition ?disposition .
      BIND(REPLACE(STR(?disposition), "^.*#", "") AS ?disposition_name)
      OPTIONAL { ?surface gmod:projectionSource ?source }
    } ORDER BY ?path
---
//! Generated by ggen from packs/code-modernization-pack/{ontology,instances}.ttl.
//! Do not edit. Change the admitted inventory builder or graph source instead.

use std::path::{Path, PathBuf};

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
struct Surface {
    path: &'static str,
    language: &'static str,
    owner: &'static str,
    kind: &'static str,
    disposition: &'static str,
    projection_source: &'static str,
}

const SURFACES: &[Surface] = &[
{% for row in a_surfaces -%}
    Surface {
        path: {{ row.path | json_encode }},
        language: {{ row.language | json_encode }},
        owner: {{ row.owner | json_encode }},
        kind: {{ row.kind | json_encode }},
        disposition: {{ row.disposition_name | json_encode }},
        projection_source: {{ row.source | default(value="") | json_encode }},
    },
{% endfor -%}
];

fn repository_root() -> PathBuf {
    let manifest_dir = Path::new(env!("CARGO_MANIFEST_DIR"));
    match manifest_dir.parent().and_then(Path::parent) {
        Some(root) => root.to_path_buf(),
        None => PathBuf::from("."),
    }
}

#[test]
fn inventory_is_nonempty_and_every_surface_exists() {
    assert!(!SURFACES.is_empty(), "ggen code inventory must not be empty");
    let root = repository_root();
    for surface in SURFACES {
        assert!(
            root.join(surface.path).exists(),
            "admitted source surface is missing: {surface:?}"
        );
    }
}

#[test]
fn inventory_paths_are_strictly_sorted_and_unique() {
    let mut previous: Option<&str> = None;
    for surface in SURFACES {
        if let Some(path) = previous {
            assert!(
                path < surface.path,
                "inventory path order/uniqueness violated: previous={path:?}, current={:?}",
                surface.path
            );
        }
        previous = Some(surface.path);
    }
}

#[test]
fn generated_projection_sources_are_bounded_when_present() {
    for surface in SURFACES {
        if surface.disposition == "Generated" && !surface.projection_source.is_empty() {
            let has_control = surface
                .projection_source
                .chars()
                .any(|ch| matches!(ch, '\n' | '\r'));
            assert!(
                surface.projection_source.len() <= 512 && !has_control,
                "generated projection source is not a bounded path-like value: {surface:?}"
            );
        }
    }
}

#[test]
fn every_surface_has_closed_inventory_fields() {
    for surface in SURFACES {
        assert!(!surface.language.trim().is_empty(), "missing language: {surface:?}");
        assert!(!surface.owner.trim().is_empty(), "missing owner: {surface:?}");
        assert!(!surface.kind.trim().is_empty(), "missing kind: {surface:?}");
        assert!(
            matches!(
                surface.disposition,
                "Generated"
                    | "HighCandidate"
                    | "MediumCandidate"
                    | "HandAuthoredRuntime"
                    | "TestSurface"
                    | "ControlSurface"
            ),
            "unknown disposition: {surface:?}"
        );
    }
}
