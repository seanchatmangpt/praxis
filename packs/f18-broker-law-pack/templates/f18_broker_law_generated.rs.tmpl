---
to: generated/f18_broker_law_generated.rs
sparql:
  stages: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwbrk: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/broker-law#> SELECT ?label ?order ?realizedBy WHERE { ?s a mfwbrk:ProvenanceStage ; rdfs:label ?label ; mfwbrk:chainOrder ?order ; mfwbrk:realizedBy ?realizedBy } ORDER BY ?order"
  refusals: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwbrk: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/broker-law#> SELECT ?label ?meaning ?invariant ?status WHERE { ?r a mfwbrk:RefusalKind ; rdfs:label ?label ; mfwbrk:meaning ?meaning ; mfwbrk:invariant ?invariant ; mfwbrk:status ?status } ORDER BY ?label"
skip_if: "ggen:local-override"
---
// F18 Broker and Zero Unreceipted Actuation (V12-018) -- GENERATED by
// `ggen sync` from `packs/f18-broker-law-pack/ontology.ttl`
// (`mfwbrk:ProvenanceStage` and `mfwbrk:RefusalKind` individuals). Do not
// edit by hand: this file is a pure data projection of the ontology. The
// real state machine, atomic idempotency ledger, forgery-resistant
// authority token, and BLAKE3 receipt/replay logic are hand-written in
// `f18_broker_law.rs`, which `include!`s this file -- a plain `//`
// comment, not a `//!` inner doc comment, because `include!` splices these
// tokens in after `f18_broker_law.rs`'s own `use` items, where an inner
// doc comment is not legal (E0753).
//
// Regenerate from a scratch ggen project referencing this pack (does not
// touch the shared root `ggen.toml`), e.g.:
// ```text
// mkdir -p /tmp/f18-ggen-scratch/templates
// cp /Users/sac/praxis/packs/f18-broker-law-pack/ontology.ttl /tmp/f18-ggen-scratch/ontology.ttl
// cat > /tmp/f18-ggen-scratch/ggen.toml <<'EOF'
// [project]
// name = "f18-ggen-scratch"
// [ontology]
// source = "ontology.ttl"
// [packs]
// f18-broker-law-pack = { path = "/Users/sac/praxis/packs/f18-broker-law-pack" }
// [templates]
// dir = "templates"
// EOF
// (cd /tmp/f18-ggen-scratch && ggen sync run)
// # `ontology.source` must be a path relative to the scratch project dir
// # (ggen 26.7.4 rejects an absolute path with FM-CONFIG-003) -- hence the
// # cp above instead of pointing straight at the pack's own ontology.ttl.
// cp /tmp/f18-ggen-scratch/generated/f18_broker_law_generated.rs \
//    /Users/sac/praxis/crates/multifractal-workflow/src/
// ```

/// One node of F18-L6's 8-node provenance chain (ActionArtifact ->
/// StandingReceipt -> AuthorityToken -> IdempotencyRecord ->
/// CorrelationBinding -> ActuationResult -> ConsequenceObservation ->
/// BrokerReceipt), a pure data projection of an `mfwbrk:ProvenanceStage`
/// individual. `realized_by` names the actual hand-written
/// `f18_broker_law.rs` type/method that stands in for this node -- data,
/// not enforcement.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ProvenanceStageInfo {
    pub label: &'static str,
    pub chain_order: u8,
    pub realized_by: &'static str,
}

/// The L6 provenance chain, in `mfwbrk:chainOrder` order (matches the
/// `ORDER BY ?order` of the generating SPARQL SELECT).
pub const PROVENANCE_CHAIN: &[ProvenanceStageInfo] = &[
{% for s in stages %}    ProvenanceStageInfo {
        label: "{{ s.label }}",
        chain_order: {{ s.order }},
        realized_by: "{{ s.realizedBy }}",
    },
{% endfor %}];

/// One `f18_broker_law::UnreceiptedActuationRefused` variant, a pure data
/// projection of an `mfwbrk:RefusalKind` individual. Cross-referenced (not
/// merely asserted) by `tests::refusal_catalog_matches_the_real_enum` in
/// `f18_broker_law.rs`, so this generated catalog cannot silently drift
/// from the real enum's variant set without a test failure.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RefusalCatalogEntry {
    pub label: &'static str,
    pub meaning: &'static str,
    pub invariant: &'static str,
    pub status: &'static str,
}

/// The typed-refusal catalog, in `?label` alphabetical order (matches the
/// `ORDER BY ?label` of the generating SPARQL SELECT).
pub const REFUSAL_CATALOG: &[RefusalCatalogEntry] = &[
{% for r in refusals %}    RefusalCatalogEntry {
        label: "{{ r.label }}",
        meaning: "{{ r.meaning }}",
        invariant: "{{ r.invariant }}",
        status: "{{ r.status }}",
    },
{% endfor %}];
