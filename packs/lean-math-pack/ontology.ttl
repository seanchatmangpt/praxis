# ═══ Decls: Petri.Net ══════════════════════════════════════════════════

procint:Decl_PetriNet a procint:Decl ;
  procint:inModule "Petri.Net" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.PetriNet" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- A place/transition Petri net (Murata 1989, section II): places P,
transitions T, with pre- and post-incidence given as finitely supported
multisets of places per transition (arc weights encoded in the
multiplicities). -/
structure PetriNet (P : Type) (T : Type) where
  pre  : T → (P →₀ ℕ)
  post : T → (P →₀ ℕ)""" .

procint:Decl_Marking a procint:Decl ;
  procint:inModule "Petri.Net" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.Marking" ;
  procint:declKind "abbrev" ;
  procint:status "definition" ;
  procint:leanCode """/-- A marking assigns finitely many tokens to each place (Murata 1989):
a finitely supported function P →₀ ℕ. -/
abbrev Marking (P : Type) := P →₀ ℕ""" .

# ═══ Decls: Petri.Firing ═══════════════════════════════════════════════

procint:Decl_Enabled a procint:Decl ;
  procint:inModule "Petri.Firing" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.PetriNet.Enabled" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Transition t is enabled at marking M when every input place carries at
least the required tokens (Murata 1989, firing rule, condition (1)). -/
def PetriNet.Enabled {P T : Type} (N : PetriNet P T) (M : Marking P) (t : T) : Prop :=
  N.pre t ≤ M""" .

procint:Decl_fire a procint:Decl ;
  procint:inModule "Petri.Firing" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.PetriNet.fire" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Fire transition t at marking M: consume the pre-multiset (truncated
subtraction) and produce the post-multiset (Murata 1989, firing rule,
condition (2)). Noncomputable because Finsupp addition is. -/
noncomputable def PetriNet.fire {P T : Type} (N : PetriNet P T) (M : Marking P) (t : T) : Marking P :=
  M - N.pre t + N.post t""" .

procint:Decl_Step a procint:Decl ;
  procint:inModule "Petri.Firing" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.PetriNet.Step" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- One firing step: t is enabled at M and M' is the result of firing it
(Murata 1989, the transition (firing) rule). -/
def PetriNet.Step {P T : Type} (N : PetriNet P T) (M : Marking P) (t : T) (M' : Marking P) : Prop :=
  N.Enabled M t ∧ M' = N.fire M t""" .

procint:Decl_step_deterministic a procint:Decl ;
  procint:inModule "Petri.Firing" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.PetriNet.step_deterministic" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.step_deterministic' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Firing is deterministic: one transition fired at one marking yields a
unique successor marking (immediate from the firing rule, Murata 1989). -/
theorem PetriNet.step_deterministic {P T : Type} (N : PetriNet P T)
    {M M₁ M₂ : Marking P} {t : T}
    (h₁ : N.Step M t M₁) (h₂ : N.Step M t M₂) : M₁ = M₂ := by
  rw [h₁.2, h₂.2]""" .

procint:Decl_fire_add_pre a procint:Decl ;
  procint:inModule "Petri.Firing" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.PetriNet.fire_add_pre" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.fire_add_pre' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Firing under enabledness satisfies the token-conservation identity
fire M t + pre t = M + post t — the Finsupp form of the state-equation
increment for a single firing (Murata 1989, section II.C). -/
theorem PetriNet.fire_add_pre {P T : Type} (N : PetriNet P T)
    {M : Marking P} {t : T} (h : N.Enabled M t) :
    N.fire M t + N.pre t = M + N.post t := by
  have h' : N.pre t ≤ M := h
  show M - N.pre t + N.post t + N.pre t = M + N.post t
  rw [add_right_comm, tsub_add_cancel_of_le h']""" .

# ═══ Decls: Petri.Reachability ═════════════════════════════════════════

procint:Decl_Reaches a procint:Decl ;
  procint:inModule "Petri.Reachability" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.PetriNet.Reaches" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Reachability: the reflexive-transitive closure of the one-step firing
relation (Murata 1989, section II.D, reachability set R(M0)). -/
def PetriNet.Reaches {P T : Type} (N : PetriNet P T) : Marking P → Marking P → Prop :=
  Relation.ReflTransGen (fun M M' => ∃ t, N.Step M t M')""" .

procint:Decl_FiringSeq a procint:Decl ;
  procint:inModule "Petri.Reachability" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.PetriNet.FiringSeq" ;
  procint:declKind "inductive" ;
  procint:status "definition" ;
  procint:leanCode """/-- A firing sequence σ from M to M'' — the list of transitions fired, in
order (Murata 1989, firing sequences). -/
inductive PetriNet.FiringSeq {P T : Type} (N : PetriNet P T) :
    Marking P → List T → Marking P → Prop
  | nil (M : Marking P) : PetriNet.FiringSeq N M [] M
  | cons {M M' M'' : Marking P} {t : T} {σ : List T} :
      N.Step M t M' → PetriNet.FiringSeq N M' σ M'' → PetriNet.FiringSeq N M (t :: σ) M''""" .

procint:Decl_FiringSeq_snoc a procint:Decl ;
  procint:inModule "Petri.Reachability" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.PetriNet.FiringSeq.snoc" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.FiringSeq.snoc' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Append a final step to a firing sequence (the snoc lemma, derived by
induction — dual of the cons constructor). -/
theorem PetriNet.FiringSeq.snoc {P T : Type} {N : PetriNet P T}
    {M M' M'' : Marking P} {σ : List T} {t : T}
    (hσ : N.FiringSeq M σ M') (h : N.Step M' t M'') : N.FiringSeq M (σ ++ [t]) M'' := by
  induction hσ with
  | nil _ => exact .cons h (.nil M'')
  | cons hstep _ ih => exact .cons hstep (ih h)""" .

procint:Decl_firingSeq_reaches a procint:Decl ;
  procint:inModule "Petri.Reachability" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.PetriNet.firingSeq_reaches" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.firingSeq_reaches' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Every firing sequence witnesses reachability (Murata 1989: soundness
direction of the firing-sequence characterization of R(M0)). -/
theorem PetriNet.firingSeq_reaches {P T : Type} {N : PetriNet P T}
    {M M' : Marking P} {σ : List T}
    (h : N.FiringSeq M σ M') : N.Reaches M M' := by
  induction h with
  | nil _ => exact Relation.ReflTransGen.refl
  | cons hstep _ ih => exact Relation.ReflTransGen.head ⟨_, hstep⟩ ih""" .

procint:Decl_reaches_firingSeq a procint:Decl ;
  procint:inModule "Petri.Reachability" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.PetriNet.reaches_firingSeq" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.reaches_firingSeq' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Every reachable marking is reached by some firing sequence (Murata 1989:
completeness direction of the firing-sequence characterization of R(M0)). -/
theorem PetriNet.reaches_firingSeq {P T : Type} {N : PetriNet P T}
    {M M' : Marking P}
    (h : N.Reaches M M') : ∃ σ, N.FiringSeq M σ M' := by
  induction h with
  | refl => exact ⟨[], .nil M⟩
  | tail _ hstep ih =>
      obtain ⟨σ, hσ⟩ := ih
      obtain ⟨t, ht⟩ := hstep
      exact ⟨σ ++ [t], hσ.snoc ht⟩""" .

# ═══ Decls: Petri.Boundedness ══════════════════════════════════════════

procint:Decl_Bounded a procint:Decl ;
  procint:inModule "Petri.Boundedness" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.PetriNet.Bounded" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A net is k-bounded from M₀ when every reachable marking carries at most
k tokens in every place (Murata 1989, section IV, boundedness; k = 1 is
safeness). -/
def PetriNet.Bounded {P T : Type} (N : PetriNet P T) (M₀ : Marking P) (k : ℕ) : Prop :=
  ∀ M, N.Reaches M₀ M → ∀ p, M p ≤ k""" .

procint:Decl_Live a procint:Decl ;
  procint:inModule "Petri.Boundedness" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.PetriNet.Live" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A net is live from M₀ when from every reachable marking, every transition
can eventually be enabled again (Murata 1989, section IV, L4-liveness — the
liveness clause of van der Aalst 1997 WF-net soundness). -/
def PetriNet.Live {P T : Type} (N : PetriNet P T) (M₀ : Marking P) : Prop :=
  ∀ M, N.Reaches M₀ M → ∀ t, ∃ M', N.Reaches M M' ∧ N.Enabled M' t""" .
@prefix procint: <https://mfact.dev/procint#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Correctness-ladder test modules (Levels 1-2 oracle fixtures) ─────────────
# Every leanCode literal kernel-verified via lake env lean (tests_scratch.lean,
# exit 0) before recording. Oracles cite their canonical family per the
# process-mining literature. Tests are catalog declarations like any other:
# ggen renders, Lean admits, the ledger records.

procint:Mod_Tests_Conformance a procint:Module ;
  procint:moduleId "Tests.Conformance" ;
  procint:modPath "Tests/Conformance" ;
  procint:order 95 ;
  procint:moduleDoc "Executable conformance oracles (Level 1): perfect-alignment cost 0, log-only deviation cost 1, projection behavior, and Rozinat-Aalst token-replay fitness values, all checked by #guard at elaboration time." ;
  procint:importsBlock """import Mathlib
import ProcInt.Conformance.Moves
import ProcInt.Conformance.Alignment
import ProcInt.Conformance.TokenReplay""" .

procint:Decl_test_perfect_alignment a procint:Decl ;
  procint:inModule "Tests.Conformance" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.test_perfect_alignment" ;
  procint:declKind "guard" ;
  procint:status "proven" ;
  procint:leanCode """-- Oracle: a perfect alignment (all synchronous moves) has cost 0
-- (Carmona et al. 2018, fitness of perfectly fitting traces).
#guard alignmentCost ([.sync "a" 1, .sync "b" 2] : List (Move String ℕ)) == 0
-- Oracle: one log-only deviation costs exactly 1 (standard cost function).
#guard alignmentCost ([.sync "a" 1, .logOnly "x", .silentModel 3] : List (Move String ℕ)) == 1
-- Log projection drops model-only and silent moves.
#guard logProjection ([.sync "a" 1, .modelOnly 2, .logOnly "b", .silentModel 3] : List (Move String ℕ)) == ["a", "b"]""" .

procint:Decl_test_fitness_oracles a procint:Decl ;
  procint:inModule "Tests.Conformance" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.test_fitness_oracles" ;
  procint:declKind "guard" ;
  procint:status "proven" ;
  procint:leanCode """-- Token-replay perfect-fitness oracle: (4,4,0,0) has fitness 1
-- (mirrors calculate_fitness(4,4,0,0) = 1.0, Rozinat-Aalst 2008).
#guard fitness ⟨4, 4, 0, 0, by decide, by decide⟩ == 1
-- Half-fitness oracle: (4,4,2,2) has fitness 1/2.
#guard fitness ⟨4, 4, 2, 2, by decide, by decide⟩ == (1 : ℚ) / 2""" .

procint:Mod_Tests_Logs a procint:Module ;
  procint:moduleId "Tests.Logs" ;
  procint:modPath "Tests/Logs" ;
  procint:order 94 ;
  procint:moduleDoc "Event-log oracles (Level 1): activity projection and timestamp monotonicity on concrete traces, decided by the kernel." ;
  procint:importsBlock """import Mathlib
import ProcInt.Logs.Event
import ProcInt.Logs.Trace""" .

procint:Decl_test_trace_oracles a procint:Decl ;
  procint:inModule "Tests.Logs" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.test_trace_oracles" ;
  procint:declKind "guard" ;
  procint:status "proven" ;
  procint:leanCode """-- Activities projection oracle.
#guard (Trace.activities ⟨"c", [Event.simple "a" 0, Event.simple "b" 5]⟩ : List String) == ["a", "b"]
-- Monotone oracle trace (equal timestamps allowed: non-strict order).
example : Trace.Monotone (⟨"c", [Event.simple "a" 0, Event.simple "b" 0, Event.simple "c" 7]⟩ : Trace String) := by
  unfold Trace.Monotone; decide""" .

procint:Mod_Tests_Models a procint:Module ;
  procint:moduleId "Tests.Models" ;
  procint:modPath "Tests/Models" ;
  procint:order 97 ;
  procint:moduleDoc "Model-family oracles (Level 1): directly-follows graphs of concrete traces, Declare template satisfaction, and process-tree interleaving semantics." ;
  procint:importsBlock """import Mathlib
import ProcInt.Models.Dfg
import ProcInt.Models.Declare
import ProcInt.Models.ProcessTree""" .

procint:Decl_test_model_oracles a procint:Decl ;
  procint:inModule "Tests.Models" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.test_model_oracles" ;
  procint:declKind "guard" ;
  procint:status "proven" ;
  procint:leanCode """-- DFG of a simple-sequence trace: adjacent pairs, each frequency 1.
#guard (dfgOfTrace ["a", "b", "c"]).edges == [("a", "b", 1), ("b", "c", 1)]
-- Declare response oracle: response(a,b) holds on [a,b,a,b].
example : Response "a" "b" ["a", "b", "a", "b"] := by decide
-- Declare precedence oracle.
example : Precedence "a" "b" ["a", "b"] := by decide
-- Parallel split/join semantics seed: interleavings of [a] and [b].
#guard interleavings ["a"] ["b"] == [["a", "b"], ["b", "a"]]""" .

procint:Mod_Tests_Ocel a procint:Module ;
  procint:moduleId "Tests.Ocel" ;
  procint:modPath "Tests/Ocel" ;
  procint:order 96 ;
  procint:moduleDoc "OCEL 2.0 oracles (Level 1-2): the order-to-items pattern (one event, two related objects), the dual event projection, and the absent-object case projecting to nothing." ;
  procint:importsBlock """import Mathlib
import ProcInt.Ocel.Core""" .

procint:Decl_test_ocel_oracle_log a procint:Decl ;
  procint:inModule "Tests.Ocel" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.ocelOracle" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Order-to-items oracle log (OCEL 2.0 canonical pattern): one place_order
event relating to two item objects, with a sibling O2O relation. -/
def ocelOracle : OCEL String String String String String String :=
  { evtype := fun _ => "place_order", time := fun _ => 0,
    objtype := fun _ => "item",
    e2o := [("e1", "creates", "o1"), ("e1", "creates", "o2")],
    o2o := [("o1", "sibling", "o2")],
    eaval := fun _ _ => none, oaval := fun _ _ _ => none }""" .

procint:Decl_test_ocel_projections a procint:Decl ;
  procint:inModule "Tests.Ocel" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.test_ocel_projections" ;
  procint:declKind "guard" ;
  procint:status "proven" ;
  procint:leanCode """-- E2O projection: the order event touches exactly its two items, in order.
#guard ocelOracle.objectsOf "e1" == ["o1", "o2"]
-- Dual projection: item o1 participates in exactly the order event.
#guard ocelOracle.eventsOf "o1" == ["e1"]
-- Absent-object case: an unknown event projects to nothing (no phantom relations).
#guard ocelOracle.objectsOf "e_missing" == ([] : List String)""" .

procint:Mod_Tests_Petri a procint:Module ;
  procint:moduleId "Tests.Petri" ;
  procint:modPath "Tests/Petri" ;
  procint:order 92 ;
  procint:moduleDoc "Petri-net oracles (Level 1, proof-style since markings are Finsupp and hence noncomputable): the one-place-one-transition sequence net — enabledness at the initial marking and the token-moving firing equation." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net
import ProcInt.Petri.Firing""" .

procint:Decl_test_seqNet a procint:Decl ;
  procint:inModule "Tests.Petri" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.seqNet" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Simple-sequence oracle net: one transition consuming from place 0 and
producing into place 1 (the smallest nontrivial Petri net, Murata 1989 Fig. 1
family). -/
noncomputable def seqNet : PetriNet (Fin 2) (Fin 1) :=
  { pre := fun _ => Finsupp.single 0 1, post := fun _ => Finsupp.single 1 1 }""" .

procint:Decl_test_seqNet_enabled a procint:Decl ;
  procint:inModule "Tests.Petri" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.test_seqNet_enabled" ;
  procint:declKind "example" ;
  procint:status "proven" ;
  procint:leanCode """-- The single transition is enabled at the initial marking [p0].
example : seqNet.Enabled (Finsupp.single 0 1) 0 := by
  unfold PetriNet.Enabled seqNet; exact le_refl _
-- Firing moves the token: fire [p0] t = [p1].
example : seqNet.fire (Finsupp.single 0 1) 0 = Finsupp.single 1 1 := by
  unfold PetriNet.fire seqNet
  simp""" .

