sparql:
  proven: |
    PREFIX procint: <https://mfact.dev/procint#>
    SELECT ?declName ?auditMsg
    WHERE {
      ?d a procint:Decl ;
         procint:declName ?declName ;
         procint:status "proven" ;
         procint:auditMsg ?auditMsg .
    }
    ORDER BY ?declName
force: true
skip_empty: true
---
