---
to: "generated/chapters_body.tex"
sparql:
  chapters: |
    PREFIX doc: <http://seanchatmangpt.github.io/packs/doc#>
    SELECT ?chapter ?order ?title ?label
    WHERE {
      ?chapter a doc:Chapter ; doc:order ?order ; doc:title ?title .
      OPTIONAL { ?chapter doc:label ?label }
    }
    ORDER BY ?order
  chapterParagraphs: |
    PREFIX doc: <http://seanchatmangpt.github.io/packs/doc#>
    SELECT ?chapter ?order ?body
    WHERE {
      ?p a doc:Paragraph ; doc:inChapter ?chapter ; doc:order ?order ; doc:body ?body .
    }
    ORDER BY ?chapter ?order
  sections: |
    PREFIX doc: <http://seanchatmangpt.github.io/packs/doc#>
    SELECT ?chapter ?section ?order ?title ?label
    WHERE {
      ?section a doc:Section ; doc:inChapter ?chapter ; doc:order ?order ; doc:title ?title .
      OPTIONAL { ?section doc:label ?label }
    }
    ORDER BY ?chapter ?order
  sectionParagraphs: |
    PREFIX doc: <http://seanchatmangpt.github.io/packs/doc#>
    SELECT ?section ?order ?body
    WHERE {
      ?p a doc:Paragraph ; doc:inSection ?section ; doc:order ?order ; doc:body ?body .
    }
    ORDER BY ?section ?order
skip_empty: true
---
% GENERATED by `ggen sync` from `doc-pack` ontology over
% `docs/thesis/math_manufacturing/rdf/thesis.ttl` — chapter/section/
% paragraph structure and prose live as RDF individuals, not hand-authored
% .tex. Do not edit by hand; edit the .ttl instance data and re-sync.
{% for ch in chapters %}\chapter{ {{- ch.title -}} }
{% if ch.label %}\label{ {{- ch.label -}} }
{% endif %}
{% for p in chapterParagraphs | filter(attribute="chapter", value=ch.chapter) %}
{{ p.body }}

{% endfor -%}
{% for s in sections | filter(attribute="chapter", value=ch.chapter) %}\section{ {{- s.title -}} }
{% if s.label %}\label{ {{- s.label -}} }
{% endif %}
{% for p in sectionParagraphs | filter(attribute="section", value=s.section) %}
{{ p.body }}

{% endfor -%}
{% endfor -%}
{% endfor %}
