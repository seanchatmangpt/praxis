---
to: generated/f22_compensation_generated.rs
sparql:
  entities: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwrec: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/recovery#> SELECT ?label ?order ?stage ?derivedFrom ?realizedBy WHERE { ?e a mfwrec:ProvChainEntity ; rdfs:label ?label ; mfwrec:chainOrder ?order ; mfwrec:pipelineStage ?stage ; mfwrec:derivedFromEntity ?derivedFrom ; mfwrec:realizedBy ?realizedBy } ORDER BY ?order"
  states: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwrec: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/recovery#> SELECT ?label ?order ?transitions WHERE { ?s a mfwrec:RecoveryStateEntity ; rdfs:label ?label ; mfwrec:stateOrder ?order ; mfwrec:legalTransitions ?transitions } ORDER BY ?order"
  refusals: "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX mfwrec: <http://seanchatmangpt.github.io/praxis/multifractal-workflow/recovery#> SELECT ?label ?meaning ?invariant ?status WHERE { ?r a mfwrec:RefusalKind ; rdfs:label ?label ; mfwrec:meaning ?meaning ; mfwrec:invariant ?invariant ; mfwrec:status ?status } ORDER BY ?label"
skip_if: "ggen:local-override"
---
// F22 Timeout Retry Escalation and Compensation (V12-022) -- GENERATED by
// `ggen sync` from `packs/f22-recovery-pack/ontology.ttl`
// (`mfwrec:ProvChainEntity` / `mfwrec:RecoveryStateEntity` /
// `mfwrec:RefusalKind` individuals). Do not edit by hand: this file is a
// pure data projection of the L6 PROV chain, L5 state catalog, and refusal
// catalog, `include!`d (not `mod` -- so `//!` inner-doc comments are not
// legal here) into `f22_compensation.rs`, which carries the module-level
// doc comment, the real compensation re-exports, and the honest
// not-yet-implemented stubs for the timeout/retry/escalation/broker-dispatch
// stages. Add `ggen:local-override` to the template frontmatter to freeze
// regeneration.
//
// Regenerate from a scratch ggen project referencing this pack (does not
// touch the shared root `ggen.toml`), e.g.:
// ```text
// mkdir -p /tmp/f22-ggen-scratch/templates
// cat > /tmp/f22-ggen-scratch/ggen.toml <<'EOF'
// [project]
// name = "f22-ggen-scratch"
// [ontology]
// source = "/Users/sac/praxis/packs/f22-recovery-pack/ontology.ttl"
// [packs]
// f22-recovery-pack = { path = "/Users/sac/praxis/packs/f22-recovery-pack" }
// [templates]
// dir = "templates"
// EOF
// (cd /tmp/f22-ggen-scratch && ggen sync run)
// cp /tmp/f22-ggen-scratch/generated/f22_compensation_generated.rs \
//    /Users/sac/praxis/crates/multifractal-workflow/src/
// ```

/// One entity in F22's L6 provenance chain -- a pure data projection of an
/// `mfwrec:ProvChainEntity` individual. Field values are informational
/// strings/integers carried straight from the ontology; nothing here is
/// enforcement (the real pipeline logic, where it exists, lives in
/// `f22_compensation.rs`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ProvChainEntity {
    pub name: &'static str,
    pub chain_order: u8,
    pub pipeline_stage: &'static str,
    pub derived_from: &'static str,
    pub realized_by: &'static str,
}

/// The generated L6 PROV chain: one [`ProvChainEntity`] per
/// `mfwrec:ProvChainEntity` individual in the pack ontology, in `?order`
/// order. `FailureObservation -> ... -> RecoveryReceipt`, a straight-line
/// chain (each entity's `derived_from` names exactly its predecessor; the
/// head carries `"none"`).
pub const PROV_CHAIN: &[ProvChainEntity] = &[
{% for e in entities %}    ProvChainEntity {
        name: "{{ e.label }}",
        chain_order: {{ e.order }},
        pipeline_stage: "{{ e.stage }}",
        derived_from: "{{ e.derivedFrom }}",
        realized_by: "{{ e.realizedBy }}",
    },
{% endfor %}];

/// One state in F22's L5 state-machine catalog -- a pure data projection of
/// an `mfwrec:RecoveryStateEntity` individual. `legal_transitions` is
/// informational only: no transition function in `f22_compensation.rs`
/// enforces these edges yet (HAND_WRITE_REQUIRED, not implemented).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RecoveryStateCatalogEntry {
    pub name: &'static str,
    pub state_order: u8,
    pub legal_transitions: &'static str,
}

/// The fixed 9-entry L5 lifecycle catalog (8 declared states plus REFUSED),
/// in `?order` order. Cross-checked by `f22_compensation.rs`'s own tests
/// against the hand-written `RecoveryState` enum so the two cannot silently
/// drift.
pub const RECOVERY_STATE_CATALOG: &[RecoveryStateCatalogEntry] = &[
{% for s in states %}    RecoveryStateCatalogEntry {
        name: "{{ s.label }}",
        state_order: {{ s.order }},
        legal_transitions: "{{ s.transitions }}",
    },
{% endfor %}];

/// One catalogued `F22Refusal` variant (`mfwrec:RefusalKind`).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct RefusalCatalogEntry {
    pub name: &'static str,
    pub meaning: &'static str,
    pub invariant: &'static str,
    pub status: &'static str,
}

/// The full `F22Refusal` catalog, alphabetical by variant name.
/// `f22_compensation.rs`'s own tests cross-check this catalog's names
/// against the hand-written `F22Refusal` enum so the two cannot silently
/// drift.
pub const REFUSAL_CATALOG: &[RefusalCatalogEntry] = &[
{% for r in refusals %}    RefusalCatalogEntry {
        name: "{{ r.label }}",
        meaning: "{{ r.meaning }}",
        invariant: "{{ r.invariant }}",
        status: "{{ r.status }}",
    },
{% endfor %}];
