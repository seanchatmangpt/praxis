# pddl-domain.ttl -- STRIPS8-safe Azure infrastructure PROVISIONING-SEQUENCE
# domain, grounded in the SAME real `pdl:` instance vocabulary and the SAME
# STRIPS8 constraints as /Users/sac/praxis/ontology/lawobject.ttl and
# crates/multifractal-workflow/fixtures/bribery-case/pddl-domain.ttl
# (positive conjunctive preconditions only; arity <= 8; precondition/effect
# conjuncts <= 8; action params <= 8 -- `wasm4pm_compat::pddl::PDDL8_MAX_*`,
# confirmed this session at /Users/sac/wasm4pm-compat/wasm4pm-core/src/
# pddl.rs:32-36).
#
# NOT hand-written PDDL text: this file is `pdl:` RDF instance data that
# `my_conforming_project::mfg::manufacture` (src/mfg.rs, already proven
# against ontology/lawobject.ttl by tests/mfg_golden.rs, and against
# pddl-domain.ttl above by tests/bribery_case_pddl.rs) turns into REAL
# PDDL8 domain text via SPARQL extraction + `enforce_pddl8` bound-checking,
# which is then round-tripped through the REAL `bcinr_pddl::domain_from_pddl`
# / `GroundProblem::build` / `GroundProblem::find_plan` grounder+solver.
# Proven live by crates/multifractal-workflow/tests/azure_terraform_pddl.rs
# (concatenates this file with pddl-problem-plannable.ttl or
# pddl-problem-blocked.ttl, mirroring bribery-case's 3-file domain/problem
# split -- see /Users/sac/praxis/tests/bribery_case_pddl.rs / that file's
# own DESIGN.md rationale for why the split is 3 files, not 1).
#
# WHAT THIS MODELS: the real dependency order a `terraform apply` of the
# ma-case-study Azure deployment (deploy/azure/ma-case-study/{main,
# variables,providers,outputs}.tf, generated by
# packs/azure-terraform-pack/templates/*.tmpl from
# packs/azure-terraform-pack/instances/ma-case-deployment.ttl) would need
# to respect -- a REAL planning model of infrastructure provisioning
# sequence, not free-text narration. Every action below cites the exact
# generated-file fact it represents:
#   - `init-provider`: providers.tf:20-33's `terraform { required_providers
#     { azurerm { ... } } }` + `provider "azurerm" { features {} }` block --
#     `terraform init` must install/configure the provider before any
#     resource can be planned.
#   - `bind-{location,environment,resource-group-name,container-image}
#     -variable`: variables.tf's 4 REQUIRED (`nullable = false`, no
#     `default`) input variables (`location` line 21, `environment` line
#     27, `resource_group_name` line 33, `container_image` line 48) --
#     Terraform refuses to plan/apply with any of these unset. Modeled as 4
#     DISTINCT action schemas (not one shared action parameterized by
#     role) so no aliasing loophole is even possible (see
#     `confirm-variables-ready`'s own comment for why this is safer than
#     bribery-case's original design).
#   - `confirm-variables-ready`: the STRIPS8 substitute for "all 4 declared
#     variables have values" (no forall in STRIPS8 -- same technique
#     bribery-case's `close-obligations` uses, generalized to 4 conjuncts
#     over 4 DISTINCT single-arity predicate names, each keyed only by
#     `?deployment`, so -- unlike bribery-case's original buggy
#     single-shared-predicate design -- there is no shared object for the
#     grounder to alias across conjuncts even in principle).
#   - `create-resource-group`: main.tf:39-42's `resource
#     "azurerm_resource_group" "this" { name = var.resource_group_name;
#     location = var.location }` -- requires the input variables bound.
#   - `define-container-spec`: main.tf:45-58's `container { name = ...; cpu
#     = 1; memory = 1; commands = [...] }` block, whose `commands` element
#     interpolates `var.container_image` (variables.tf:48) -- also requires
#     the input variables bound.
#   - `create-container-group`: main.tf:45-58's `resource
#     "azurerm_container_group" "this" { location =
#     azurerm_resource_group.this.location; resource_group_name =
#     azurerm_resource_group.this.name; container { ... } }` -- lines 47-48
#     are REAL Terraform attribute references into the resource group
#     resource, the exact mechanism that forces Terraform's own dependency
#     graph to create the resource group before the container group (this
#     is the domain's `create-resource-group` <
#     `create-container-group` analog of the task's own "create-
#     resource-group before create-storage-account before
#     create-container-group" example -- this deployment's real resource
#     set is exactly {resource_group, container_group}; no storage account
#     or Key Vault exists anywhere in this pack's generated Terraform, see
#     packs/azure-terraform-pack/ontology.ttl's own "SCOPE FENCE" section,
#     so this domain does not invent one).
#   - `bind-outputs`: outputs.tf:22-45's 5 outputs (`fqdn`/`ip_address`/
#     `name`/`resource_group_name`/`resource_id`), all of which read
#     `azurerm_container_group.this.*` or `azurerm_resource_group.this.*`
#     attributes -- outputs can only be computed once the container group
#     (and transitively the resource group) resource exists in the plan.
#   - `prepare-mock-provider` / `run-plan-test`: tests/
#     container_group.tftest.hcl:38-88's `mock_provider "azurerm" {}` +
#     `run "container_group_topology" { command = plan; assert { ... } }`
#     -- the test suite mocks the provider (needs the provider block to
#     exist) and asserts against the planned `azurerm_resource_group.this`/
#     `azurerm_container_group.this` attributes (needs the container group
#     -- and transitively outputs -- already planned).
#
# TYPED NON-CLOSURE PATH (mirrors bribery-case's `block-for-missing-
# evidence`): `block-for-missing-image(?deployment, ?provider, ?var)`
# transitions straight to `(deployment-blocked ?deployment)` whenever a
# positive `(image-unavailable ?var)` fact is present on the
# `container-image` variable -- a REAL, disclosed, currently-true gap, not
# invented: variables.tf:50's own description states "No default: the
# built image URI is a CI/CD-pipeline fact this repo's source tree does not
# itself contain (no Dockerfile exists yet to build this image from --  a
# disclosed gap ...)". See pddl-problem-blocked.ttl for the worked example
# (2-step plan: init-provider, then straight to block-for-missing-image).
#
# SCOPE: this domain models the PROVISIONING SEQUENCE ONLY -- the order a
# real `terraform apply` would need to respect. Solving this domain's
# problems does NOT invoke `terraform apply` (or `plan`/`init`/`test`) for
# real; `create-resource-group`/`create-container-group`/etc. are PDDL8
# action labels for planning purposes, the same abstraction level
# bribery-case's own `judge`/`admit`/`receipt` actions use for that
# domain's lifecycle transitions.

@prefix pdl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------

pdl:domain_azure_terraform_provisioning
    a pdl:Domain ;
    pdl:name "azure-terraform-provisioning-pddl8" .

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------

pdl:type_deployment  a pdl:Type ; pdl:name "deployment" .
pdl:type_provider    a pdl:Type ; pdl:name "provider" .
pdl:type_variable    a pdl:Type ; pdl:name "variable" .
pdl:type_resourcegroup  a pdl:Type ; pdl:name "resource-group" .
pdl:type_container      a pdl:Type ; pdl:name "container" .
pdl:type_containergroup a pdl:Type ; pdl:name "container-group" .
pdl:type_testsuite      a pdl:Type ; pdl:name "test-suite" .

# 4 role-specific `variable` subtypes -- one per REQUIRED (no-default)
# Terraform input variable this deployment declares (variables.tf lines
# 21/27/33/48). Declaring these as real `- variable` subtypes (not just
# 4 same-typed objects) means `bcinr_pddl::ground.rs`'s real
# `TypeIndex::satisfies` (walks the `(:types child - parent)` chain --
# confirmed this session by reading that function) restricts each
# `bind-*-variable` action's `?var` parameter to ONLY the matching-role
# object at grounding time, not merely by convention.
pdl:type_locationvariable
    a pdl:Type ; pdl:name "location-variable" ; pdl:subTypeOf pdl:type_variable .
pdl:type_environmentvariable
    a pdl:Type ; pdl:name "environment-variable" ; pdl:subTypeOf pdl:type_variable .
pdl:type_resourcegroupnamevariable
    a pdl:Type ; pdl:name "resource-group-name-variable" ; pdl:subTypeOf pdl:type_variable .
pdl:type_containerimagevariable
    a pdl:Type ; pdl:name "container-image-variable" ; pdl:subTypeOf pdl:type_variable .

# ---------------------------------------------------------------------------
# Predicates (all positive-checkable; STRIPS8-safe; arity <= 2)
# ---------------------------------------------------------------------------

pdl:pred_provider_required
    a pdl:Predicate ;
    pdl:name "provider-required" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] .

pdl:pred_provider_initialized
    a pdl:Predicate ;
    pdl:name "provider-initialized" ;
    pdl:param [ pdl:index 0 ; pdl:var "?provider" ; pdl:ofType "provider" ] .

pdl:pred_variable_declared
    a pdl:Predicate ;
    pdl:name "variable-declared" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?var" ; pdl:ofType "variable" ] .

pdl:pred_location_bound
    a pdl:Predicate ;
    pdl:name "location-bound" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_environment_bound
    a pdl:Predicate ;
    pdl:name "environment-bound" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_resource_group_name_bound
    a pdl:Predicate ;
    pdl:name "resource-group-name-bound" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_container_image_bound
    a pdl:Predicate ;
    pdl:name "container-image-bound" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_variables_ready
    a pdl:Predicate ;
    pdl:name "variables-ready" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_resource_group_planned
    a pdl:Predicate ;
    pdl:name "resource-group-planned" ;
    pdl:param [ pdl:index 0 ; pdl:var "?rg" ; pdl:ofType "resource-group" ] .

pdl:pred_container_spec_defined
    a pdl:Predicate ;
    pdl:name "container-spec-defined" ;
    pdl:param [ pdl:index 0 ; pdl:var "?container" ; pdl:ofType "container" ] .

pdl:pred_container_group_planned
    a pdl:Predicate ;
    pdl:name "container-group-planned" ;
    pdl:param [ pdl:index 0 ; pdl:var "?cg" ; pdl:ofType "container-group" ] .

pdl:pred_container_group_in_resource_group
    a pdl:Predicate ;
    pdl:name "container-group-in-resource-group" ;
    pdl:param [ pdl:index 0 ; pdl:var "?cg" ; pdl:ofType "container-group" ] ,
              [ pdl:index 1 ; pdl:var "?rg" ; pdl:ofType "resource-group" ] .

pdl:pred_outputs_bound
    a pdl:Predicate ;
    pdl:name "outputs-bound" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_mock_provider_ready
    a pdl:Predicate ;
    pdl:name "mock-provider-ready" ;
    pdl:param [ pdl:index 0 ; pdl:var "?test" ; pdl:ofType "test-suite" ] .

pdl:pred_plan_verified
    a pdl:Predicate ;
    pdl:name "plan-verified" ;
    pdl:param [ pdl:index 0 ; pdl:var "?test" ; pdl:ofType "test-suite" ] .

pdl:pred_image_unavailable
    a pdl:Predicate ;
    pdl:name "image-unavailable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?var" ; pdl:ofType "variable" ] .

pdl:pred_deployment_blocked
    a pdl:Predicate ;
    pdl:name "deployment-blocked" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] .

pdl:pred_blocked_on
    a pdl:Predicate ;
    pdl:name "blocked-on" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?var" ; pdl:ofType "variable" ] .

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

# 1. init-provider(?deployment, ?provider) -- providers.tf:20-33's
#    `required_providers { azurerm { ... } }` + `provider "azurerm" {
#    features {} }` block. `terraform init` must install/configure the
#    provider before any resource can be planned or applied.
pdl:action_init_provider
    a pdl:Action ;
    pdl:name "init-provider" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ;
    pdl:pre "(provider-required ?deployment ?provider)" ;
    pdl:add "(provider-initialized ?provider)" .

# 2a-2d. bind-{location,environment,resource-group-name,container-image}
#    -variable -- variables.tf's 4 REQUIRED (`nullable = false`, no
#    `default`) input variables. FOUR DISTINCT action schemas (not one
#    shared action with 4 role-parameters), matching bribery-case's own
#    disclosed fix for exactly this class of STRIPS8 aliasing risk:
#    bribery-case's original bug came from one action checking N conjuncts
#    of the SAME shared predicate over N SEPARATE parameters (letting the
#    grounder alias them to one object). Here, each `?var` role is baked
#    into the action's OWN typed parameter (subtype-restricted by
#    `TypeIndex::satisfies`, see the Types block's comment) and each
#    action asserts a DISTINCT, single-arity predicate keyed only on
#    `?deployment` -- there is no shared predicate/object across the 4
#    actions for the grounder to alias in the first place.
pdl:action_bind_location_variable
    a pdl:Action ;
    pdl:name "bind-location-variable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ,
              [ pdl:index 2 ; pdl:var "?var" ; pdl:ofType "location-variable" ] ;
    pdl:pre "(provider-initialized ?provider)" ,
            "(variable-declared ?deployment ?var)" ;
    pdl:add "(location-bound ?deployment)" .

pdl:action_bind_environment_variable
    a pdl:Action ;
    pdl:name "bind-environment-variable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ,
              [ pdl:index 2 ; pdl:var "?var" ; pdl:ofType "environment-variable" ] ;
    pdl:pre "(provider-initialized ?provider)" ,
            "(variable-declared ?deployment ?var)" ;
    pdl:add "(environment-bound ?deployment)" .

pdl:action_bind_resource_group_name_variable
    a pdl:Action ;
    pdl:name "bind-resource-group-name-variable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ,
              [ pdl:index 2 ; pdl:var "?var" ; pdl:ofType "resource-group-name-variable" ] ;
    pdl:pre "(provider-initialized ?provider)" ,
            "(variable-declared ?deployment ?var)" ;
    pdl:add "(resource-group-name-bound ?deployment)" .

pdl:action_bind_container_image_variable
    a pdl:Action ;
    pdl:name "bind-container-image-variable" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ,
              [ pdl:index 2 ; pdl:var "?var" ; pdl:ofType "container-image-variable" ] ;
    pdl:pre "(provider-initialized ?provider)" ,
            "(variable-declared ?deployment ?var)" ;
    pdl:add "(container-image-bound ?deployment)" .

# 3. confirm-variables-ready(?deployment) -- the STRIPS8 substitute for a
#    `forall variable. bound(variable)` ADL check: 4 positive conjuncts
#    over 4 DISTINCT predicate names (arity 1, well under
#    PDDL8_MAX_CONJUNCTS=8 / PDDL8_MAX_PARAMS=8).
pdl:action_confirm_variables_ready
    a pdl:Action ;
    pdl:name "confirm-variables-ready" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ;
    pdl:pre "(location-bound ?deployment)" ,
            "(environment-bound ?deployment)" ,
            "(resource-group-name-bound ?deployment)" ,
            "(container-image-bound ?deployment)" ;
    pdl:add "(variables-ready ?deployment)" .

# 4. create-resource-group(?deployment, ?rg) -- main.tf:39-42's
#    `resource "azurerm_resource_group" "this" { name =
#    var.resource_group_name; location = var.location }`.
pdl:action_create_resource_group
    a pdl:Action ;
    pdl:name "create-resource-group" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?rg" ; pdl:ofType "resource-group" ] ;
    pdl:pre "(variables-ready ?deployment)" ;
    pdl:add "(resource-group-planned ?rg)" .

# 5. define-container-spec(?deployment, ?container) -- main.tf:45-58's
#    `container { name = "ma-case-validator"; cpu = 1; memory = 1;
#    commands = ["/bin/sh", "-c", "... var.container_image's downstream
#    consumer ..."] }` block (aztf:containerName/aztf:cpuCores/
#    aztf:memoryGb/aztf:command facts).
pdl:action_define_container_spec
    a pdl:Action ;
    pdl:name "define-container-spec" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?container" ; pdl:ofType "container" ] ;
    pdl:pre "(variables-ready ?deployment)" ;
    pdl:add "(container-spec-defined ?container)" .

# 6. create-container-group(?deployment, ?rg, ?container, ?cg) --
#    main.tf:45-58's `resource "azurerm_container_group" "this" {
#    location = azurerm_resource_group.this.location; resource_group_name
#    = azurerm_resource_group.this.name; container { ... } }`. Lines 47-48
#    are REAL Terraform attribute references into the resource-group
#    resource -- the actual mechanism forcing resource-group before
#    container-group in Terraform's own dependency graph, captured here as
#    a genuine STRIPS8 precondition rather than narrated.
pdl:action_create_container_group
    a pdl:Action ;
    pdl:name "create-container-group" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?rg" ; pdl:ofType "resource-group" ] ,
              [ pdl:index 2 ; pdl:var "?container" ; pdl:ofType "container" ] ,
              [ pdl:index 3 ; pdl:var "?cg" ; pdl:ofType "container-group" ] ;
    pdl:pre "(resource-group-planned ?rg)" ,
            "(container-spec-defined ?container)" ;
    pdl:add "(container-group-planned ?cg)" ,
            "(container-group-in-resource-group ?cg ?rg)" .

# 7. bind-outputs(?deployment, ?cg) -- outputs.tf:22-45's 5 outputs, every
#    one of which reads `azurerm_container_group.this.*` or
#    `azurerm_resource_group.this.*` -- outputs can only be computed once
#    the container group (and transitively the resource group) exists in
#    the plan.
pdl:action_bind_outputs
    a pdl:Action ;
    pdl:name "bind-outputs" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?cg" ; pdl:ofType "container-group" ] ;
    pdl:pre "(container-group-planned ?cg)" ;
    pdl:add "(outputs-bound ?deployment)" .

# 8. prepare-mock-provider(?test, ?provider) --
#    tests/container_group.tftest.hcl:38's `mock_provider "azurerm" {}` --
#    mocks the (already-initialized) provider for a `command = plan`
#    test run.
pdl:action_prepare_mock_provider
    a pdl:Action ;
    pdl:name "prepare-mock-provider" ;
    pdl:param [ pdl:index 0 ; pdl:var "?test" ; pdl:ofType "test-suite" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ;
    pdl:pre "(provider-initialized ?provider)" ;
    pdl:add "(mock-provider-ready ?test)" .

# 9. run-plan-test(?deployment, ?test, ?cg) --
#    tests/container_group.tftest.hcl:46-88's `run
#    "container_group_topology" { command = plan; assert { ... } }`,
#    asserting against the planned `azurerm_resource_group.this`/
#    `azurerm_container_group.this` attributes -- needs the mocked
#    provider, the planned container group, AND its outputs available.
pdl:action_run_plan_test
    a pdl:Action ;
    pdl:name "run-plan-test" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?test" ; pdl:ofType "test-suite" ] ,
              [ pdl:index 2 ; pdl:var "?cg" ; pdl:ofType "container-group" ] ;
    pdl:pre "(mock-provider-ready ?test)" ,
            "(container-group-planned ?cg)" ,
            "(outputs-bound ?deployment)" ;
    pdl:add "(plan-verified ?test)" .

# 10. block-for-missing-image(?deployment, ?provider, ?var): Raw ->
#     Blocked -- the typed non-closure terminal path (see this file's
#     header). NOT reachable through create-resource-group/
#     create-container-group/run-plan-test; a sibling transition taken
#     whenever a positive `(image-unavailable ?var)` fact is present on
#     the container-image variable (variables.tf:50's own disclosed "no
#     Dockerfile exists yet to build this image from" gap).
pdl:action_block_for_missing_image
    a pdl:Action ;
    pdl:name "block-for-missing-image" ;
    pdl:param [ pdl:index 0 ; pdl:var "?deployment" ; pdl:ofType "deployment" ] ,
              [ pdl:index 1 ; pdl:var "?provider" ; pdl:ofType "provider" ] ,
              [ pdl:index 2 ; pdl:var "?var" ; pdl:ofType "container-image-variable" ] ;
    pdl:pre "(provider-initialized ?provider)" ,
            "(variable-declared ?deployment ?var)" ,
            "(image-unavailable ?var)" ;
    pdl:add "(deployment-blocked ?deployment)" ,
            "(blocked-on ?deployment ?var)" .
