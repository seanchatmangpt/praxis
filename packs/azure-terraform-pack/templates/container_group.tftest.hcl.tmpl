---
to: "deploy/azure/{{ row.slug }}/tests/container_group.tftest.hcl"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX aztf: <https://ggen.io/ontology/azure-terraform#>
    SELECT ?g ?slug ?osType ?restartPolicy ?ipAddressType WHERE {
      ?g a aztf:ContainerGroup ;
         aztf:deploymentSlug ?slug ;
         aztf:osType ?osType ;
         aztf:restartPolicy ?restartPolicy ;
         aztf:ipAddressType ?ipAddressType .
    } ORDER BY ?slug ?osType ?restartPolicy ?ipAddressType
  b_containers: |
    PREFIX aztf: <https://ggen.io/ontology/azure-terraform#>
    SELECT ?g ?order ?name ?cpu ?memory ?command WHERE {
      ?g a aztf:ContainerGroup ;
         aztf:hasContainer ?c .
      ?c aztf:containerOrder ?order ;
         aztf:containerName  ?name ;
         aztf:cpuCores       ?cpu ;
         aztf:memoryGb       ?memory ;
         aztf:command        ?command .
    } ORDER BY ?g ?order ?name ?cpu ?memory ?command
---
# GENERATED by `ggen sync` from packs/azure-terraform-pack/ontology.ttl --
# do not edit by hand. `mock_provider "azurerm" {}` + `command = plan`
# harness SHAPE adapted directly from
# Azure/terraform-azurerm-avm-res-keyvault-vault's
# tests/unit/unit.tftest.hcl and tests/unit/access_policies.tftest.hcl
# (MIT License; verified this session via
# https://raw.githubusercontent.com/Azure/terraform-azurerm-avm-res-keyvault-vault/main/tests/unit/access_policies.tftest.hcl,
# whose `assert { condition = ...; error_message = ... }` block this file's
# assertions below are patterned on). Chosen over
# Azure/terraform-azurerm-avm-res-containerinstance-containergroup's own
# test suite because that module ships zero .tftest.hcl files (its tests/
# directory is a placeholder README, verified via GitHub tree API this
# session) -- see packs/azure-terraform-pack/SOURCE_ATTRIBUTION.md for the
# full research trail.
#
# Runs `terraform test` against a PLAN only (mocked provider, no real Azure
# credentials/subscription needed -- see this repo's own
# packs/azure-terraform-pack/SOURCE_ATTRIBUTION.md for why `command = plan`
# is the right choice over `command = apply` here). Assertion VALUES below
# are bound from the same ontology graph templates/main.tf.tmpl renders
# from, so this test and the generated main.tf can never silently drift
# apart -- both are projections of the same graph. Renders once per
# aztf:ContainerGroup individual (filtered to this row's own containers via
# the `filter(attribute="g", value=group.g)` Tera filter below, so
# `loop.index0` numbers this row's containers from 0 regardless of where
# they sort in the graph-wide b_containers array -- looping over the
# unfiltered array and guarding the body with a conditional instead would
# leak the OTHER deployment's sort position into loop.index0, asserting
# against the wrong container index whenever two ContainerGroup individuals
# coexist in one graph), so multiple deployments' test files never
# cross-assert on each other's container list.
#
# `commands[0]` below asserts against `"/bin/sh"`, not the raw
# `aztf:command` string: main.tf.tmpl renders `commands = ["/bin/sh", "-c",
# "<command>"]` (see that template's own comment for why), so `commands[2]`
# -- not `commands[0]` -- is the element carrying the actual command line.

mock_provider "azurerm" {}

variables {
  location             = "eastus"
  environment           = "test"
  resource_group_name  = "test-rg"
  container_image      = "example.azurecr.io/{{ row.slug }}:test"
}

{%- set group = row %}
run "container_group_topology" {
  command = plan

  assert {
    condition     = azurerm_resource_group.this.name == var.resource_group_name
    error_message = "resource group name must equal var.resource_group_name."
  }

  assert {
    condition     = azurerm_container_group.this.os_type == "{{ group.osType }}"
    error_message = "os_type must be \"{{ group.osType }}\" (packs/azure-terraform-pack ontology graph aztf:osType)."
  }

  assert {
    condition     = azurerm_container_group.this.restart_policy == "{{ group.restartPolicy }}"
    error_message = "restart_policy must be \"{{ group.restartPolicy }}\" (packs/azure-terraform-pack ontology graph aztf:restartPolicy)."
  }

  assert {
    condition     = azurerm_container_group.this.ip_address_type == "{{ group.ipAddressType }}"
    error_message = "ip_address_type must be \"{{ group.ipAddressType }}\" (packs/azure-terraform-pack ontology graph aztf:ipAddressType)."
  }
{%- for c in b_containers | filter(attribute="g", value=group.g) %}

  assert {
    condition     = azurerm_container_group.this.container[{{ loop.index0 }}].name == "{{ c.name }}"
    error_message = "container[{{ loop.index0 }}].name must be \"{{ c.name }}\" (packs/azure-terraform-pack ontology graph aztf:containerName)."
  }

  assert {
    condition     = azurerm_container_group.this.container[{{ loop.index0 }}].cpu == {{ c.cpu }}
    error_message = "container[{{ loop.index0 }}].cpu must be {{ c.cpu }} (packs/azure-terraform-pack ontology graph aztf:cpuCores)."
  }

  assert {
    condition     = azurerm_container_group.this.container[{{ loop.index0 }}].memory == {{ c.memory }}
    error_message = "container[{{ loop.index0 }}].memory must be {{ c.memory }} (packs/azure-terraform-pack ontology graph aztf:memoryGb)."
  }

  assert {
    condition     = azurerm_container_group.this.container[{{ loop.index0 }}].commands[2] == "{{ c.command }}"
    error_message = "container[{{ loop.index0 }}].commands[2] must be \"{{ c.command }}\" (packs/azure-terraform-pack ontology graph aztf:command, rendered inside [\"/bin/sh\", \"-c\", ...])."
  }
{%- endfor %}
}
