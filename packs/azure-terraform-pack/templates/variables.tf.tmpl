---
to: "deploy/azure/{{ row.slug }}/variables.tf"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX aztf: <https://ggen.io/ontology/azure-terraform#>
    SELECT ?g ?slug ?label WHERE {
      ?g a aztf:ContainerGroup ;
         aztf:deploymentSlug ?slug ;
         aztf:workloadLabel ?label .
    } ORDER BY ?slug
---
# GENERATED by `ggen sync` from packs/azure-terraform-pack/templates/variables.tf.tmpl
# -- do not edit by hand. Renders once per aztf:ContainerGroup individual
# (see templates/main.tf.tmpl's frontmatter comment for why).
#
# `location`/`name`/`resource_group_name`/`tags` variable SHAPES (type +
# description style) are adapted from
# Azure/terraform-azurerm-avm-res-containerinstance-containergroup's own
# variables.tf (MIT License; verified this session via
# https://raw.githubusercontent.com/Azure/terraform-azurerm-avm-res-containerinstance-containergroup/main/variables.tf).
# `environment` and `container_image` are CUSTOM (root-config concerns that
# reusable child module does not own -- it never creates its own resource
# group or hardcodes an environment tag). See
# packs/azure-terraform-pack/SOURCE_ATTRIBUTION.md for the full ledger.
#
# Deliberately NOT ported from the AVM source: `enable_telemetry` (an
# Azure-Verified-Modules registry-publishing concern that applies only when
# consuming the module via the public registry, which this configuration
# does not do -- see SOURCE_ATTRIBUTION.md), `os_type`/`restart_policy`/
# `subnet_ids`/`zones`/`priority`/`dns_name_label` (these are ontology-
# derived FACTS about the workload, not deployment-day choices -- see
# packs/azure-terraform-pack/ontology.ttl and templates/main.tf.tmpl, where
# they are bound from SPARQL instead).

{%- set group = row %}
variable "location" {
  type        = string
  description = "Azure region where the {{ group.label }} container group is deployed."
  nullable    = false
}

variable "environment" {
  type        = string
  description = "Deployment environment tag (e.g. \"dev\", \"staging\", \"prod\"). Applied as a resource tag only -- this configuration's resource SHAPE (os_type/restart_policy/ip_address_type/container topology) is fixed by packs/azure-terraform-pack/ontology.ttl regardless of environment, since it reflects source-code facts, not environment-specific infrastructure choices."
  nullable    = false
}

variable "resource_group_name" {
  type        = string
  description = "Name of the resource group this configuration creates for the {{ group.label }} container group."
  nullable    = false
}

variable "name" {
  type        = string
  default     = "{{ group.slug }}-runtime"
  description = "Name of the azurerm_container_group resource itself (distinct from the container block's own name, which is bound from the ontology graph, not a variable)."
  nullable    = false
}

variable "container_image" {
  type        = string
  description = "Full container image reference (e.g. \"myregistry.azurecr.io/{{ group.slug }}:latest\") for the image whose entrypoint runs the command bound from the ontology graph's aztf:command (see main.tf's container block). No default: the built image URI is a CI/CD-pipeline fact this repo's source tree does not itself contain (no Dockerfile exists yet to build this image from -- a disclosed gap, see SOURCE_ATTRIBUTION.md and this deployment's own aztf:hasContainer individual, not silently assumed away)."
  nullable    = false
}

variable "tags" {
  type        = map(string)
  default     = {}
  description = "(Optional) Additional tags to merge onto every resource this configuration creates."
  nullable    = false
}

locals {
  # workload/managed-by are fixed identifiers for this configuration, not
  # deployment inputs; environment is threaded through from var.environment
  # so callers only ever set it once.
  tags = merge(
    {
      workload   = "{{ group.slug }}"
      managed-by = "terraform"
    },
    { environment = var.environment },
    var.tags,
  )
}
