/// One node of the F01 L6 provenance chain (`mfwprov:ProvenanceEntity`):
/// `Observation -> AdmissionDecision -> ManufactureRun -> Artifact ->
/// StandingAssertion -> Receipt -> ReplayRun`. Pure data projection --
/// `derived_from`/`generates_next` are `""` at the chain's boundaries,
/// never a magic sentinel that could collide with a real entity name.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ProvenanceEntityCatalogEntry {
    pub name: &'static str,
    pub comment: &'static str,
    pub chain_order: u8,
    /// The `f01_standing_algebra::LifecycleState` variant name this entity
    /// corresponds to producing (cross-checked against the real enum by
    /// `provenance_catalog_lifecycle_states_match_enum` in
    /// `f01_standing_algebra.rs`).
    pub lifecycle_state: &'static str,
    pub derived_from: &'static str,
    pub generates_next: &'static str,
}

/// The fixed 7-entity provenance chain, in chain order.
pub const PROVENANCE_CHAIN: &[ProvenanceEntityCatalogEntry] = &[
{% for e in entities %}    ProvenanceEntityCatalogEntry {
        name: "{{ e.label }}",
        comment: "{{ e.comment }}",
        chain_order: {{ e.order }},
        lifecycle_state: "{{ e.lifecycleState }}",
        derived_from: "{{ e.derivedFromLabel }}",
        generates_next: "{{ e.generatesNextLabel }}",
    },
{% endfor %}];
