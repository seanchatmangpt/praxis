# f09-mfw-growth-pack ontology -- V12-009 (F09 "MFW Growth Operator")
# individuals for the multifractal-workflow crate's L6 data-lens provenance
# chain and refusal catalog.
#
# Per the F09 family survey (MIXED verdict): this ontology is the
# GGEN_GENERATABLE slice only -- mechanical catalog data, not algorithmic
# logic. `mfwg:realizedBy` on each `ProvenanceStage` and `mfwg:status` on
# each `RefusalKind` are honest self-reports matching f09_mfw_growth.rs's
# own module documentation at the time this ontology was written: REAL
# stages actually call the cited praxis code (closure.rs / pddl-index /
# powl2-decompose's budget concept); NOT_YET_IMPLEMENTED stages return
# `MFWGrowthRefused::NotYetImplemented` rather than fake success. If
# f09_mfw_growth.rs's real/stub boundary moves, this ontology must be
# re-edited to match -- it is not auto-derived from the Rust source.

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mfwg:  <http://seanchatmangpt.github.io/praxis/multifractal-workflow/mfw-growth#> .

#################################################################
# Vocabulary
#################################################################

mfwg: a owl:Ontology ;
  rdfs:label "multifractal-workflow F09 MFW Growth Operator vocabulary" ;
  rdfs:comment "L6 provenance chain and refusal catalog for the autonomic growth pipeline (V12-009): ParentWorkflow -> Socket -> ContinuationGoal -> ResidueState -> Plan -> ChildWorkflow -> DescentReceipt -> ParentClosureDecision." .

mfwg:ProvenanceStage a rdfs:Class ;
  rdfs:label "Provenance chain stage" ;
  rdfs:comment "One node of the L6 provenance chain a manufactured child workflow must carry receipts for." .

mfwg:chainOrder a rdf:Property ; rdfs:domain mfwg:ProvenanceStage ; rdfs:range xsd:integer ;
  rdfs:label "chain order" ; rdfs:comment "Position in the fixed provenance chain, 0-indexed." .
mfwg:realizedBy a rdf:Property ; rdfs:domain mfwg:ProvenanceStage ;
  rdfs:label "realized by" ; rdfs:comment "Honest self-report of what f09_mfw_growth.rs code (if any) realizes this stage, and whether it is real or not-yet-implemented." .

mfwg:RefusalKind a rdfs:Class ;
  rdfs:label "Refusal kind" ;
  rdfs:comment "One variant of MFWGrowthRefused." .

mfwg:meaning a rdf:Property ; rdfs:domain mfwg:RefusalKind ;
  rdfs:label "meaning" ; rdfs:comment "What condition triggers this refusal." .
mfwg:invariant a rdf:Property ; rdfs:domain mfwg:RefusalKind ;
  rdfs:label "invariant" ; rdfs:comment "Which F09 family invariant (from the atlas survey) this refusal enforces." .
mfwg:status a rdf:Property ; rdfs:domain mfwg:RefusalKind ; rdfs:range xsd:string ;
  rdfs:label "status" ; rdfs:comment "REAL (this session verified the gate actually runs) or NOT_YET_IMPLEMENTED (typed refusal stub, honestly labeled)." .

#################################################################
# L6 provenance chain (8 stages, fixed order)
#################################################################

mfwg:parentWorkflow a mfwg:ProvenanceStage ; rdfs:label "ParentWorkflow" ; mfwg:chainOrder 0 ;
  mfwg:realizedBy "Addressed via powl2_decompose::WorkflowSocketId / ParentChildClosure (REUSE_ADAPT, real; praxis-graphlaw dependency)." .
mfwg:socket a mfwg:ProvenanceStage ; rdfs:label "Socket" ; mfwg:chainOrder 1 ;
  mfwg:realizedBy "RecursiveSocketClosure::socket() (REUSE_ADAPT, real; praxis_graphlaw::chatman::closure)." .
mfwg:continuationGoal a mfwg:ProvenanceStage ; rdfs:label "ContinuationGoal" ; mfwg:chainOrder 2 ;
  mfwg:realizedBy "ContinuationGoal { domain: Pddl8Domain, problem: Pddl8Problem } data carrier is real; the Resolver that produces one from a ResidueState is NOT_YET_IMPLEMENTED (resolve_continuation_goal stub)." .
mfwg:residueState a mfwg:ProvenanceStage ; rdfs:label "ResidueState" ; mfwg:chainOrder 3 ;
  mfwg:realizedBy "ResidueState { socket, description } data carrier only; nothing yet derives one from live engine state (NOT_YET_IMPLEMENTED)." .
mfwg:plan a mfwg:ProvenanceStage ; rdfs:label "Plan" ; mfwg:chainOrder 4 ;
  mfwg:realizedBy "pddl_index::solve_indexed via reachability_gate() (REUSE_ADAPT, real; differentially verified against bcinr_pddl elsewhere in the workspace)." .
mfwg:childWorkflow a mfwg:ProvenanceStage ; rdfs:label "ChildWorkflow" ; mfwg:chainOrder 5 ;
  mfwg:realizedBy "manufacture_and_bind_child() -- NOT_YET_IMPLEMENTED; no code anywhere in the repo constructs a powl2_decompose::Powl child from a Pddl8Tape (confirmed by repo-wide grep at survey time)." .
mfwg:descentReceipt a mfwg:ProvenanceStage ; rdfs:label "DescentReceipt" ; mfwg:chainOrder 6 ;
  mfwg:realizedBy "DescentMeter::descend() + DescentReceipt::seal() (REUSE_ADAPT, real; BLAKE3-sealed via wasm4pm_compat::hash::blake3_combined, budget-check shape adapted from powl2_decompose::decompose's RefusalReason::BudgetExhausted)." .
mfwg:parentClosureDecision a mfwg:ProvenanceStage ; rdfs:label "ParentClosureDecision" ; mfwg:chainOrder 7 ;
  mfwg:realizedBy "Parent Re-evaluator -- NOT_YET_IMPLEMENTED; semantic_closure_check() re-runs RecursiveSocketClosure::is_closed() before growth (real) but nothing re-evaluates the parent after a child attaches, since attachment itself is not built." .

#################################################################
# MFWGrowthRefused catalog
#################################################################

mfwg:socketNotBlocked a mfwg:RefusalKind ; rdfs:label "SocketNotBlocked" ;
  mfwg:meaning "Growth was attempted at a socket that is not reported blocked." ;
  mfwg:invariant "Growth is autonomic (triggered only by a blocked socket + reachable goal), not pre-authored by process designers." ;
  mfwg:status "REAL" .
mfwg:closureAlreadySatisfied a mfwg:RefusalKind ; rdfs:label "ClosureAlreadySatisfied" ;
  mfwg:meaning "The socket's declared closure law already evaluates Close(W) = true; truth is already closed." ;
  mfwg:invariant "No child workflow is manufactured for already-closed truth, inadmissible state, or unbounded descent." ;
  mfwg:status "REAL" .
mfwg:closureCheckFailed a mfwg:RefusalKind ; rdfs:label "ClosureCheckFailed" ;
  mfwg:meaning "praxis_graphlaw::chatman::closure could not evaluate the closure law at all (e.g. unknown child); distinct from a definite closed/open verdict." ;
  mfwg:invariant "No child workflow is manufactured for ... inadmissible state." ;
  mfwg:status "REAL" .
mfwg:goalUnreachable a mfwg:RefusalKind ; rdfs:label "GoalUnreachable" ;
  mfwg:meaning "pddl_index::solve_indexed found no plan for the continuation goal." ;
  mfwg:invariant "No child workflow is manufactured for ... [a state where] the goal remains reachable [does not hold]." ;
  mfwg:status "REAL" .
mfwg:descentBudgetExhausted a mfwg:RefusalKind ; rdfs:label "DescentBudgetExhausted" ;
  mfwg:meaning "The DescentMeter has no budget remaining; one more descent step would be unbounded." ;
  mfwg:invariant "No child workflow is manufactured for ... unbounded descent (BOUNDED_DESCENT_PROVEN)." ;
  mfwg:status "REAL" .
mfwg:notYetImplemented a mfwg:RefusalKind ; rdfs:label "NotYetImplemented" ;
  mfwg:meaning "A pipeline stage that is genuinely HAND_WRITE_REQUIRED and not yet built (continuation-goal resolution, POWL manufacture, socket binding, parent re-evaluation) was reached; fails loud instead of faking success." ;
  mfwg:invariant "Every manufactured child has an exact parent socket, PDDL ancestry, descent budget, and closure path -- cannot be honored until these stages exist." ;
  mfwg:status "NOT_YET_IMPLEMENTED (by design; this is the honest refusal, not a bug)" .
