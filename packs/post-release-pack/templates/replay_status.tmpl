---
to: "paper/replay_status.tex"
sparql:
  a_m: |
    PREFIX post: <https://mfact.dev/postrelease#>
    SELECT ?replayStatusTex ?coreTag
    WHERE { ?m a post:MetaNode ; post:replayStatusTex ?replayStatusTex ;
      post:coreTag ?coreTag . }
  steps: |
    PREFIX post: <https://mfact.dev/postrelease#>
    SELECT ?stepCmdTex ?stepOrder
    WHERE { ?s a post:ReplayStep ; post:stepCmdTex ?stepCmdTex ;
      post:stepOrder ?stepOrder . }
    ORDER BY ?stepOrder
force: true
skip_empty: true
---
