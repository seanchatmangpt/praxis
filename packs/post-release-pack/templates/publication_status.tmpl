---
to: "paper/publication_status.tex"
sparql:
  a_m: |
    PREFIX post: <https://mfact.dev/postrelease#>
    SELECT ?releaseId ?arxivStatus ?arxivDetail ?arxivFileCount ?publicationTex
    WHERE { ?m a post:MetaNode ; post:releaseId ?releaseId ;
      post:arxivStatus ?arxivStatus ;
      post:arxivDetail ?arxivDetail ; post:arxivFileCount ?arxivFileCount ;
      post:publicationTex ?publicationTex . }
  packets: |
    PREFIX post: <https://mfact.dev/postrelease#>
    SELECT ?packetIdTex ?packetStatus
    WHERE { ?p a post:Packet ; post:packetIdTex ?packetIdTex ;
      post:packetStatus ?packetStatus . }
    ORDER BY ?packetIdTex
force: true
skip_empty: true
---
