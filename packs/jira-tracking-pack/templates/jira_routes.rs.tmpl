---
to: crates/cng/src/jira_routes.rs
sparql:
  commands: "PREFIX cnv: <http://seanchatmangpt.github.io/packs/clap-noun-verb#> SELECT ?verb ?handler ?doc WHERE { ?c a cnv:Command ; cnv:noun \"jira\" ; cnv:verb ?verb ; cnv:handler ?handler ; cnv:doc ?doc } ORDER BY ?verb"
  nouns: "PREFIX cnv: <http://seanchatmangpt.github.io/packs/clap-noun-verb#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?noun ?about WHERE { ?n a cnv:Noun ; rdfs:label ?noun ; rdfs:comment ?about . FILTER(?noun = \"jira\") } ORDER BY ?noun"
determinism: true
force: true
skip_if: "ggen:local-override"
---
//! `jira` noun-verb routes — GENERATED by `ggen sync` from the
//! `jira-tracking-pack` ontology (`cnv:Command` individuals scoped to
//! `cnv:noun "jira"`, per PROJ-tracking's own `schema.ttl`). Do not edit by
//! hand: routes are a pure projection of the ontology; logic lives in
//! `cng::jira::handlers`. (Freezing regeneration is configured in the
//! template frontmatter's `skip_if` key itself, not spelled out verbatim
//! here, so this generated body never accidentally self-matches its own
//! freeze marker on the next `ggen sync run` — see this file's `.tmpl`
//! source for the actual mechanism.)
//!
//! Adapted from `clap-noun-verb-pack`'s `clap_noun_verb_routes.rs.tmpl`
//! mechanism (SPARQL SELECT over `cnv:Command` individuals -> Tera loop ->
//! `#[verb]`-attributed fn) but NOT copied verbatim: that pack's own
//! generated output has zero real callers anywhere in this repo (its
//! `#[clap_noun_verb_macros::verb("verb")]` single-argument form and
//! `crate::verbs::handlers::` module path have never been compiled against
//! this workspace's actual `clap-noun-verb 26.7.4`). This template instead
//! matches `crates/cng/src/main.rs`'s own real, compiling convention:
//! `#[verb("verb", "noun")]` (two positional args, unqualified `verb`
//! import) and a call into the library crate's `cng::jira::handlers`
//! module (this file lives in the `cng` BINARY crate, declared via `mod
//! jira_routes;` in `main.rs`, so `crate::jira` would resolve in the
//! binary's own module tree, not the library's — hence the fully
//! qualified `cng::jira::handlers::` path).
//!
//! Per-verb parameter shape (id: required String for show/status/deps;
//! optional status/section filters for list; term: required String for
//! search; none for report) is branched on `cmd.verb` below rather than
//! derived generically from the ontology — a deliberate, disclosed scope
//! limit for this fixed 6-verb command set, not a claim that ggen infers
//! arbitrary CLI arities from RDF alone.

use clap_noun_verb::Result;
use clap_noun_verb_macros::verb;

{% for cmd in commands %}/// {{ cmd.doc }}
{% if cmd.verb == "list" %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}(status: Option<String>, section: Option<String>) -> Result<cng::jira::TicketListReport> {
    cng::jira::handlers::{{ cmd.handler }}(status, section)
}
{% elif cmd.verb == "show" %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}(id: String) -> Result<cng::jira::TicketDetail> {
    cng::jira::handlers::{{ cmd.handler }}(id)
}
{% elif cmd.verb == "status" %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}(id: String) -> Result<cng::jira::TicketStatus> {
    cng::jira::handlers::{{ cmd.handler }}(id)
}
{% elif cmd.verb == "deps" %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}(id: String) -> Result<cng::jira::TicketDeps> {
    cng::jira::handlers::{{ cmd.handler }}(id)
}
{% elif cmd.verb == "search" %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}(term: String) -> Result<cng::jira::TicketListReport> {
    cng::jira::handlers::{{ cmd.handler }}(term)
}
{% else %}#[verb("{{ cmd.verb }}", "jira")]
fn jira_{{ cmd.verb }}() -> Result<cng::jira::TicketReport> {
    cng::jira::handlers::{{ cmd.handler }}()
}
{% endif %}
{% endfor %}
// ---------------------------------------------------------------------
// Noun `--help` description, generated from the `cnv:Noun` individual's
// `rdfs:comment` — same first-writer-wins registration rationale as
// clap-noun-verb-pack's own template (see that file's matching comment
// block for the full explanation of why this beats the macro's runtime
// `file!()`-based scrape for a distributed/installed binary).
// ---------------------------------------------------------------------

{% for row in nouns %}
#[linkme::distributed_slice(::clap_noun_verb::cli::registry::__NOUN_REGISTRY)]
static REGISTER_{{ row.noun | upper }}_NOUN: fn() = register_{{ row.noun }}_noun;
fn register_{{ row.noun }}_noun() {
    ::clap_noun_verb::cli::registry::CommandRegistry::register_noun(
        "{{ row.noun }}",
        "{{ row.about }}",
    );
}
{% endfor %}
