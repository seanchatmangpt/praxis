---
to: "mega_paper.tex"
sparql:
  papers: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?fromPaper ?title
    WHERE {
      VALUES (?fromPaper ?title) {
        ("00_foundations" "Foundations")
        ("01_admission_algebra" "Admission Algebra")
        ("02_receipt_cryptography" "Receipt Cryptography")
        ("03_planning_geometry" "Planning Geometry")
        ("04_projection_and_scale" "Projection and Scale")
        ("projection_thesis" "Projection Thesis")
        ("synthesis_thesis" "Synthesis Thesis")
      }
    }
    ORDER BY ?fromPaper
  statements: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?kind ?label ?statement ?fromPaper
    WHERE {
      ?s a math:Statement ;
         math:kind ?kind ;
         math:label ?label ;
         math:statement ?statement ;
         math:fromPaper ?fromPaper .
    }
    ORDER BY ?fromPaper ?label
  proofs: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?label ?fromPaper (GROUP_CONCAT(?stepField; separator="") AS ?steps)
    WHERE {
      {
        SELECT ?proof ?label ?fromPaper ?stepField
        WHERE {
          ?proof a math:Proof ;
                 math:proves ?stmt ;
                 math:step ?step .
          ?stmt math:label ?label ;
                math:fromPaper ?fromPaper .
          ?step math:order ?order ;
                math:claim ?claim ;
                math:justification ?justification .
          OPTIONAL { ?justification math:label ?justLabel }
          BIND(CONCAT(STR(?order), "", ?claim, "", COALESCE(?justLabel, STRAFTER(STR(?justification), "#"))) AS ?stepField)
        }
        ORDER BY ?order
      }
    }
    GROUP BY ?proof ?label ?fromPaper
    ORDER BY ?fromPaper ?label
  symbols: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?latex (GROUP_CONCAT(DISTINCT ?fromPaper; separator=", ") AS ?papers)
    WHERE {
      ?sym a math:Symbol ;
           math:latex ?latex ;
           math:fromPaper ?fromPaper .
    }
    GROUP BY ?latex
    ORDER BY ?latex
skip_empty: true
---
