---
to: "generated/proofs.tex"
sparql:
  proofs: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?label (GROUP_CONCAT(?stepField; separator="") AS ?steps)
    WHERE {
      {
        SELECT ?proof ?label ?stepField
        WHERE {
          ?proof a math:Proof ;
                 math:proves ?stmt ;
                 math:step ?step .
          ?stmt math:label ?label .
          ?step math:order ?order ;
                math:claim ?claim ;
                math:justification ?justification .
          OPTIONAL { ?justification math:label ?justLabel }
          BIND(CONCAT(STR(?order), "", ?claim, "", COALESCE(?justLabel, STRAFTER(STR(?justification), "#"))) AS ?stepField)
        }
        ORDER BY ?order
      }
    }
    GROUP BY ?proof ?label
    ORDER BY ?label
skip_empty: true
---
% GENERATED by `ggen sync` from `tex-math-pack` ontology (`math:Proof`
% individuals). Do not edit by hand: one proof environment per math:Proof,
% referencing the \label{} of the math:Statement it proves, with one line
% per ordered math:ProofStep (claim, then its licensing justification).

{% for row in proofs %}\begin{proof}[Proof of \ref{ {{- row.label -}} }]
{% set steps = row.steps | split(pat="") -%}
{% for s in steps %}{% set parts = s | split(pat="") %}{{ parts.1 }} \hfill \textit{(by {{ parts.2 | replace(from="_", to="\_") }})}\\
{% endfor %}\end{proof}

{% endfor %}
