---
to: "generated/theorems.tex"
sparql:
  statements: |
    PREFIX math: <http://seanchatmangpt.github.io/packs/tex-math#>
    SELECT ?kind ?label ?statement
    WHERE {
      ?s a math:Statement ;
         math:kind ?kind ;
         math:label ?label ;
         math:statement ?statement .
    }
    ORDER BY ?label
skip_empty: true
---
% GENERATED by `ggen sync` from `tex-math-pack` ontology (`math:Statement`
% individuals). Do not edit by hand: one amsthm environment per statement,
% in math:kind order matching \newtheorem declarations for theorem, lemma,
% proposition, corollary, definition.

{% for row in statements %}\begin{ {{- row.kind -}} }[{{ row.label | replace(from="_", to="\_") }}]
\label{ {{- row.label -}} }
{{ row.statement }}
\end{ {{- row.kind -}} }

{% endfor %}
