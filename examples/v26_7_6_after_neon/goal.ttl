# after-neon factory floor — planner-loop demo goal (v26.7.6).
#
# A PDDL8-safe (STRIPS8) `pddl:` ontology for the post-cyberpunk civic
# factory: a blueprint must gain standing, be grounded into a plan, have its
# artifact manufactured under gauge, and be folded into the receipt chain.
#
# Expected plan (pinned by tests/plan_run_e2e.rs):
#   grant-standing -> ground-blueprint -> manufacture-artifact -> fold-receipt
#
# Same schema as ontology/lawobject.ttl (the mfg lane's golden fixture);
# consumed by `praxis plan run --goal examples/v26_7_6_after_neon/goal.ttl`.

@prefix pddl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ── Domain ────────────────────────────────────────────────────────────────

pddl:domain_after_neon
    a pddl:Domain ;
    pddl:name "after-neon-factory-pddl8" .

# ── Types ─────────────────────────────────────────────────────────────────

pddl:type_blueprint a pddl:Type ; pddl:name "blueprint" .
pddl:type_registrar a pddl:Type ; pddl:name "registrar" .
pddl:type_cell      a pddl:Type ; pddl:name "factory-cell" .
pddl:type_gauge     a pddl:Type ; pddl:name "gauge" .
pddl:type_token     a pddl:Type ; pddl:name "chain-token" .

# ── Predicates ────────────────────────────────────────────────────────────

pddl:pred_has_standing
    a pddl:Predicate ;
    pddl:name "has-standing" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] .

pddl:pred_registrar_open
    a pddl:Predicate ;
    pddl:name "registrar-open" ;
    pddl:param [ pddl:index 0 ; pddl:var "?reg" ; pddl:ofType "registrar" ] .

pddl:pred_grounded
    a pddl:Predicate ;
    pddl:name "grounded" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] .

pddl:pred_cell_idle
    a pddl:Predicate ;
    pddl:name "cell-idle" ;
    pddl:param [ pddl:index 0 ; pddl:var "?cell" ; pddl:ofType "factory-cell" ] .

pddl:pred_gauge_calibrated
    a pddl:Predicate ;
    pddl:name "gauge-calibrated" ;
    pddl:param [ pddl:index 0 ; pddl:var "?g" ; pddl:ofType "gauge" ] .

pddl:pred_artifact_made
    a pddl:Predicate ;
    pddl:name "artifact-made" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] .

pddl:pred_chain_open
    a pddl:Predicate ;
    pddl:name "chain-open" ;
    pddl:param [ pddl:index 0 ; pddl:var "?tok" ; pddl:ofType "chain-token" ] .

pddl:pred_receipted
    a pddl:Predicate ;
    pddl:name "receipted" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] .

# ── Actions ───────────────────────────────────────────────────────────────

# 1. grant-standing(?bp, ?reg): admission — the registrar grants standing.
pddl:action_grant_standing
    a pddl:Action ;
    pddl:name "grant-standing" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] ,
              [ pddl:index 1 ; pddl:var "?reg" ; pddl:ofType "registrar" ] ;
    pddl:pre "(registrar-open ?reg)" ;
    pddl:add "(has-standing ?bp)" .

# 2. ground-blueprint(?bp): law-state — bind the blueprint to ground facts.
pddl:action_ground_blueprint
    a pddl:Action ;
    pddl:name "ground-blueprint" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] ;
    pddl:pre "(has-standing ?bp)" ;
    pddl:add "(grounded ?bp)" .

# 3. manufacture-artifact(?bp, ?cell, ?g): factory — make under a calibrated gauge.
pddl:action_manufacture_artifact
    a pddl:Action ;
    pddl:name "manufacture-artifact" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] ,
              [ pddl:index 1 ; pddl:var "?cell" ; pddl:ofType "factory-cell" ] ,
              [ pddl:index 2 ; pddl:var "?g" ; pddl:ofType "gauge" ] ;
    pddl:pre "(grounded ?bp)" ,
            "(cell-idle ?cell)" ,
            "(gauge-calibrated ?g)" ;
    pddl:add "(artifact-made ?bp)" ;
    pddl:del "(cell-idle ?cell)" .

# 4. fold-receipt(?bp, ?tok): receipt — fold the run into the open chain.
pddl:action_fold_receipt
    a pddl:Action ;
    pddl:name "fold-receipt" ;
    pddl:param [ pddl:index 0 ; pddl:var "?bp" ; pddl:ofType "blueprint" ] ,
              [ pddl:index 1 ; pddl:var "?tok" ; pddl:ofType "chain-token" ] ;
    pddl:pre "(artifact-made ?bp)" ,
            "(chain-open ?tok)" ;
    pddl:add "(receipted ?bp)" .

# ── Problem: after-neon-case-001 ──────────────────────────────────────────

pddl:problem_after_neon_case_001
    a pddl:Problem ;
    pddl:name "after-neon-case-001" ;
    pddl:domain "after-neon-factory-pddl8" ;
    pddl:object [ pddl:name "bp-001" ; pddl:ofType "blueprint" ] ,
               [ pddl:name "reg-001" ; pddl:ofType "registrar" ] ,
               [ pddl:name "cell-07" ; pddl:ofType "factory-cell" ] ,
               [ pddl:name "gauge-03" ; pddl:ofType "gauge" ] ,
               [ pddl:name "tok-genesis" ; pddl:ofType "chain-token" ] ;
    pddl:init "(registrar-open reg-001)" ,
             "(cell-idle cell-07)" ,
             "(gauge-calibrated gauge-03)" ,
             "(chain-open tok-genesis)" ;
    pddl:goal "(receipted bp-001)" .
