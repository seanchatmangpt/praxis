# after-neon factory floor — planner-loop demo goal (v26.7.6).
#
# A PDDL8-safe (STRIPS8) `pdl:` ontology for the post-cyberpunk civic
# factory: a blueprint must gain standing, be grounded into a plan, have its
# artifact manufactured under gauge, and be folded into the receipt chain.
#
# Expected plan (pinned by tests/plan_run_e2e.rs):
#   grant-standing -> ground-blueprint -> manufacture-artifact -> fold-receipt
#
# Same schema as ontology/lawobject.ttl (the mfg lane's golden fixture);
# consumed by `praxis plan run --goal examples/v26_7_6_after_neon/goal.ttl`.

@prefix pdl: <http://seanchatmangpt.github.io/praxis/pddl#> .

# ── Domain ────────────────────────────────────────────────────────────────

pdl:domain_after_neon
    a pdl:Domain ;
    pdl:name "after-neon-factory-pddl8" .

# ── Types ─────────────────────────────────────────────────────────────────

pdl:type_blueprint a pdl:Type ; pdl:name "blueprint" .
pdl:type_registrar a pdl:Type ; pdl:name "registrar" .
pdl:type_cell      a pdl:Type ; pdl:name "factory-cell" .
pdl:type_gauge     a pdl:Type ; pdl:name "gauge" .
pdl:type_token     a pdl:Type ; pdl:name "chain-token" .

# ── Predicates ────────────────────────────────────────────────────────────

pdl:pred_has_standing
    a pdl:Predicate ;
    pdl:name "has-standing" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] .

pdl:pred_registrar_open
    a pdl:Predicate ;
    pdl:name "registrar-open" ;
    pdl:param [ pdl:index 0 ; pdl:var "?reg" ; pdl:ofType "registrar" ] .

pdl:pred_grounded
    a pdl:Predicate ;
    pdl:name "grounded" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] .

pdl:pred_cell_idle
    a pdl:Predicate ;
    pdl:name "cell-idle" ;
    pdl:param [ pdl:index 0 ; pdl:var "?cell" ; pdl:ofType "factory-cell" ] .

pdl:pred_gauge_calibrated
    a pdl:Predicate ;
    pdl:name "gauge-calibrated" ;
    pdl:param [ pdl:index 0 ; pdl:var "?g" ; pdl:ofType "gauge" ] .

pdl:pred_artifact_made
    a pdl:Predicate ;
    pdl:name "artifact-made" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] .

pdl:pred_chain_open
    a pdl:Predicate ;
    pdl:name "chain-open" ;
    pdl:param [ pdl:index 0 ; pdl:var "?tok" ; pdl:ofType "chain-token" ] .

pdl:pred_receipted
    a pdl:Predicate ;
    pdl:name "receipted" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] .

# ── Actions ───────────────────────────────────────────────────────────────

# 1. grant-standing(?bp, ?reg): admission — the registrar grants standing.
pdl:action_grant_standing
    a pdl:Action ;
    pdl:name "grant-standing" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] ,
              [ pdl:index 1 ; pdl:var "?reg" ; pdl:ofType "registrar" ] ;
    pdl:pre "(registrar-open ?reg)" ;
    pdl:add "(has-standing ?bp)" .

# 2. ground-blueprint(?bp): law-state — bind the blueprint to ground facts.
pdl:action_ground_blueprint
    a pdl:Action ;
    pdl:name "ground-blueprint" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] ;
    pdl:pre "(has-standing ?bp)" ;
    pdl:add "(grounded ?bp)" .

# 3. manufacture-artifact(?bp, ?cell, ?g): factory — make under a calibrated gauge.
pdl:action_manufacture_artifact
    a pdl:Action ;
    pdl:name "manufacture-artifact" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] ,
              [ pdl:index 1 ; pdl:var "?cell" ; pdl:ofType "factory-cell" ] ,
              [ pdl:index 2 ; pdl:var "?g" ; pdl:ofType "gauge" ] ;
    pdl:pre "(grounded ?bp)" ,
            "(cell-idle ?cell)" ,
            "(gauge-calibrated ?g)" ;
    pdl:add "(artifact-made ?bp)" ;
    pdl:del "(cell-idle ?cell)" .

# 4. fold-receipt(?bp, ?tok): receipt — fold the run into the open chain.
pdl:action_fold_receipt
    a pdl:Action ;
    pdl:name "fold-receipt" ;
    pdl:param [ pdl:index 0 ; pdl:var "?bp" ; pdl:ofType "blueprint" ] ,
              [ pdl:index 1 ; pdl:var "?tok" ; pdl:ofType "chain-token" ] ;
    pdl:pre "(artifact-made ?bp)" ,
            "(chain-open ?tok)" ;
    pdl:add "(receipted ?bp)" .

# ── Problem: after-neon-case-001 ──────────────────────────────────────────

pdl:problem_after_neon_case_001
    a pdl:Problem ;
    pdl:name "after-neon-case-001" ;
    pdl:domain "after-neon-factory-pddl8" ;
    pdl:object [ pdl:name "bp-001" ; pdl:ofType "blueprint" ] ,
               [ pdl:name "reg-001" ; pdl:ofType "registrar" ] ,
               [ pdl:name "cell-07" ; pdl:ofType "factory-cell" ] ,
               [ pdl:name "gauge-03" ; pdl:ofType "gauge" ] ,
               [ pdl:name "tok-genesis" ; pdl:ofType "chain-token" ] ;
    pdl:init "(registrar-open reg-001)" ,
             "(cell-idle cell-07)" ,
             "(gauge-calibrated gauge-03)" ,
             "(chain-open tok-genesis)" ;
    pdl:goal "(receipted bp-001)" .
