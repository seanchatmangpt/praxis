%% Umbrella project root for the Erlang/OTP applications under apps/
%% (air_core, arazzo_runner, arazzo_atomvm, ...).
%%
%% PROJ-756: before this file, no rebar.config existed anywhere in this
%% tree (verified: `find . -iname 'rebar.config*' -not -path '*/_build/*'`
%% returned nothing). `rebar3 compile` run from the repo root still
%% "worked" in the sense that it happened to sweep up whichever apps/*
%% directories had a valid src/*.app.src -- that is rebar3's implicit
%% zero-config umbrella default (auto-discovering apps/* and lib/*), not
%% anything this repo declared. The practical failure mode: air_core had
%% no .app.src before PROJ-755, so it was silently absent from that
%% implicit discovery with no config anywhere to point at as the cause.
%% This file makes the umbrella project root, and its apps' compile
%% options, explicit and versioned instead of relying on rebar3 defaults.
%%
%% Still no `just` recipe for this Erlang umbrella (see apps/air_core's
%% ticket notes) -- run `rebar3 compile` / `rebar3 eunit` directly from
%% the repo root, or from an individual app directory under apps/.
{erl_opts, [debug_info]}.
{deps, []}.
